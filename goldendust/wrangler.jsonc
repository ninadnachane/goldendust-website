{
  // Golden Dust Safaris website: static Astro site (dist) + Worker for the itinerary planner.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldendust-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin.*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goldendust-planner",
      // Created 18 Oct 2026 (Western Europe).
      "database_id": "8da49ac9-b5ad-4e97-ac04-0234274f1c1f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Only these emails can use /admin (checked by the Worker on top of Cloudflare Access).
    "ADMIN_EMAILS": "hello@goldendustsafaris.com"
    // ACCESS_TEAM_DOMAIN and ACCESS_AUD are added once Cloudflare Access is set up.
    // Until then the admin stays locked.
  },
  "observability": { "enabled": true }
}
