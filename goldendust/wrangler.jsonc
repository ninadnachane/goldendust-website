{
  // Golden Dust Safaris website: static Astro site (dist) + Worker for the itinerary planner.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldendust-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin.*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goldendust-planner",
      // Created 18 Oct 2026 (Western Europe).
      "database_id": "8da49ac9-b5ad-4e97-ac04-0234274f1c1f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Only these emails can sign in to /admin. Secrets ADMIN_PASSWORD and RESEND_API_KEY
    // are set in the Cloudflare dashboard; until both exist the admin stays locked.
    "ADMIN_EMAILS": "hello@goldendustsafaris.com",
    "MAIL_FROM": "Golden Dust admin <onboarding@resend.dev>"
  },
  "observability": { "enabled": true }
}
