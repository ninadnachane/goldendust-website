{
  "version": "0.2",
  "language": "en-GB,en",
  "import": [
    "@cspell/dict-en-gb/cspell-ext.json",
    "@cspell/dict-nl-nl/cspell-ext.json",
    "@cspell/dict-de-de/cspell-ext.json",
    "@cspell/dict-fr-fr/cspell-ext.json"
  ],
  "ignoreRegExpList": [
    "/GD-\\d+/g",
    "/\\b[A-Z0-9]{2,}\\b/g",
    "/[^\\x00-\\u024f\\s]+/gu"
  ],
  "overrides": [
    {
      "filename": [
        "**/.spellcheck/nl/**",
        "**/.spellcheck/nl.txt"
      ],
      "language": "nl,en-GB,en",
      "allowCompoundWords": true
    },
    {
      "filename": [
        "**/.spellcheck/de/**",
        "**/.spellcheck/de.txt"
      ],
      "language": "de,en-GB,en",
      "allowCompoundWords": true
    },
    {
      "filename": [
        "**/.spellcheck/fr/**",
        "**/.spellcheck/fr.txt"
      ],
      "language": "fr,en-GB,en"
    }
  ],
