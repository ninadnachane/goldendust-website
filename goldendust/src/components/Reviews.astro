---
import { site } from "../lib/site";
const { tripadvisorUrl, googleReviewsUrl, reviewsWidgetScript, tripadvisorLocationId, tripadvisorRating, tripadvisorMinRating } = site;
// Tripadvisor's official reviews widget, shown only while the rating meets the minimum.
const showTa = Boolean(tripadvisorLocationId) && tripadvisorRating >= tripadvisorMinRating;
const taId = "gd1";
const taSrc = `https://www.jscache.com/wejs?wtype=selfserveprop&uniq=${taId}&locationId=${tripadvisorLocationId}&lang=en_US&rating=true&nreviews=5&writereviewlink=true&popIdx=true&iswide=true&border=false&display_version=2`;
const hasAny = tripadvisorUrl || googleReviewsUrl || reviewsWidgetScript || showTa;
---
{hasAny && (
  <section class="section section--white" aria-labelledby="rv-h">
    <div class="wrap">
      <h2 id="rv-h">What our guests say</h2>
      <p class="muted measure">Read honest reviews from travelers who've been on safari with our guides, and leave your own after your trip.</p>
      {showTa && (
        <div class="rv__ta">
          <div id={`TA_selfserveprop${taId}`} class="TA_selfserveprop">
            <ul id="TA_links" class="TA_links">
              <li><a target="_blank" rel="noopener" href={tripadvisorUrl}>Golden Dust Safaris on Tripadvisor</a></li>
            </ul>
          </div>
          <script async src={taSrc} is:inline></script>
        </div>
      )}
      {reviewsWidgetScript && (
        <div class="rv__widget">
          <script src={reviewsWidgetScript} defer is:inline></script>
        </div>
      )}
      <div class="rv__cards">
        {tripadvisorUrl && (
          <a class="rv__card" href={tripadvisorUrl} target="_blank" rel="noopener">
            <span class="rv__name">Tripadvisor</span>
            <span class="rv__text">Golden Dust Safaris reviews on Tripadvisor</span>
            <span class="rv__go">Read our reviews</span>
          </a>
        )}
        {googleReviewsUrl && (
          <a class="rv__card" href={googleReviewsUrl} target="_blank" rel="noopener">
            <span class="rv__name">Google</span>
            <span class="rv__text">Golden Dust Safaris reviews on Google</span>
            <span class="rv__go">Read our reviews</span>
          </a>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .rv__widget { margin: 1.5rem 0; }
  .rv__ta { margin-top: 1.8rem; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 1.2rem; overflow: hidden; }
  .rv__ta :global(.TA_links) { list-style: none; margin: 0; padding: 0; }
  .rv__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 22rem)); gap: 1rem; margin-top: 1.8rem; }
  .rv__card {
    display: grid; gap: 0.35rem; padding: 1.4rem 1.5rem; border-radius: 16px; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); color: var(--ink);
  }
  .rv__card:hover { border-color: var(--gold); box-shadow: 0 12px 28px -18px rgba(46, 36, 27, 0.5); color: var(--ink); }
  .rv__name { font-weight: 600; font-size: 1.25rem; }
  .rv__text { color: var(--ink-2); font-size: 0.95rem; }
  .rv__go { margin-top: 0.6rem; justify-self: start; font-weight: 600; font-size: 0.92rem; padding: 0.5rem 1rem; border-radius: 99px; background: var(--btn); color: var(--btn-text); }
</style>
