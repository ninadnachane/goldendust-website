---
import { site } from "../lib/site";
const { tripadvisorUrl, googleReviewsUrl, reviewsWidgetScript } = site;
const hasAny = tripadvisorUrl || googleReviewsUrl || reviewsWidgetScript;
---
{hasAny && (
  <section class="section section--white" aria-labelledby="rv-h">
    <div class="wrap">
      <h2 id="rv-h">What our guests say</h2>
      {reviewsWidgetScript && (
        <div class="rv__widget">
          <script src={reviewsWidgetScript} defer is:inline></script>
        </div>
      )}
      <div class="rv__links">
        {tripadvisorUrl && <a class="btn btn--ghost" href={tripadvisorUrl} target="_blank" rel="noopener">Read our reviews on Tripadvisor</a>}
        {googleReviewsUrl && <a class="btn btn--ghost" href={googleReviewsUrl} target="_blank" rel="noopener">Read our Google reviews</a>}
      </div>
    </div>
  </section>
)}

<style>
  .rv__widget { margin: 1.5rem 0; }
  .rv__links { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
</style>
