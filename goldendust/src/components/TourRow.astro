---
import Route from "./Route.astro";
import { type Tour, fromPrice, usd, tourUrl } from "../data/tours";
interface Props { tour: Tour }
const { tour: t } = Astro.props;
---
<article class="tr">
  <div class="tr__head">
    <p class="tr__tier" data-tier={t.tier}>{t.tier}</p>
    <h3><a href={tourUrl(t)}>{t.nights + 1} days: {t.shortName}</a></h3>
    <p class="muted">{t.summary}</p>
  </div>
  <Route stops={t.route} />
  <div class="tr__foot">
    <p><strong>From {usd(fromPrice(t))}</strong> per person <span class="muted">· {t.stay}</span></p>
    <a href={tourUrl(t)} class="tr__link">See the day-by-day plan</a>
  </div>
</article>

<style>
  .tr { background: var(--surface); border-radius: 10px; padding: 1.6rem 1.6rem 1.4rem; display: grid; gap: 1.3rem; border: 1px solid var(--line); }
  h3 { font-size: var(--step-1); margin: 0.2rem 0 0.4rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--green); text-decoration: underline; }
  .tr__head p.muted { margin: 0; font-size: 0.98rem; }
  .tr__tier { margin: 0; font-family: var(--display); font-weight: 600; font-size: 0.85rem; color: var(--olive); }
  .tr__tier[data-tier="Mid Range"] { color: var(--rust); }
  .tr__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; align-items: baseline; border-top: 1px solid var(--line); padding-top: 1rem; }
  .tr__foot p { margin: 0; }
  .tr__link { font-family: var(--display); font-weight: 600; font-size: 0.95rem; }
</style>
