---
import { type Tour, tourUrl, mapUrlFor, tierClass } from "../data/tours";
import { langOf, lp, usdFor } from "../i18n";
import { tierName, place } from "../i18n/common";
interface Props { tour: Tour }
const { tour: t } = Astro.props;
const lang = langOf(Astro.url);
const days = t.nights + 1;
const T = {
  en: { aria: `${days}-day ${t.shortName}: route map and day-by-day plan`, map: "Route map", head: `${days} days: ${t.shortName}`, from: "From", pp: "per person", see: "See the day-by-day plan", to: " to " },
  nl: { aria: `${days}-daagse ${t.shortName}: routekaart en dagprogramma`, map: "Routekaart", head: `${days} dagen: ${t.shortName}`, from: "Vanaf", pp: "per persoon", see: "Bekijk het dagprogramma", to: " naar " },
  de: { aria: `${days} Tage ${t.shortName}: Routenkarte und Tagesablauf`, map: "Routenkarte", head: `${days} Tage: ${t.shortName}`, from: "Ab", pp: "pro Person", see: "Zum Reiseverlauf", to: " nach " },
  fr: { aria: `${days} jours, ${t.shortName} : carte et programme jour par jour`, map: "Carte de l'itinéraire", head: `${days} jours : ${t.shortName}`, from: "À partir de", pp: "par personne", see: "Voir le programme jour par jour", to: " à " },
}[lang];
---
<article class="tr">
  <a href={lp(lang, tourUrl(t))} class="tr__map" aria-label={T.aria}>
    <img src={mapUrlFor(lang, t)} alt={`${T.map}: ${t.route.map((r) => place(lang, r)).join(T.to)}`} loading="lazy" width="800" height="690" />
    <span class={`tag tag--${tierClass(t)}`}>{tierName(lang, t.tier)}</span>
  </a>
  <div class="tr__body">
    <h3><a href={lp(lang, tourUrl(t))}>{T.head}</a></h3>
    <p class="muted">{t.summary}</p>
    <div class="tr__foot">
      <p><strong>{T.from} {usdFor(lang, Math.min(t.prices.high.pp, t.prices.green.pp))}</strong> {T.pp}</p>
      <a href={lp(lang, tourUrl(t))} class="tr__link">{T.see}</a>
    </div>
  </div>
</article>

<style>
  .tr { background: var(--surface); border-radius: 12px; border: 1px solid var(--line); overflow: hidden; display: flex; flex-direction: column; }
  .tr__map { position: relative; display: block; background: #faf7f0; border-bottom: 1px solid var(--line); }
  .tr__map img { display: block; width: 100%; height: auto; aspect-ratio: 800 / 690; object-fit: cover; }
  .tag { position: absolute; top: 0.8rem; right: 0.8rem; padding: 0.2rem 0.65rem; border-radius: 999px; font-family: var(--display); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; }
  .tag--budget { background: #6f7d3c; }
  .tag--comfort { background: #9a6a2f; }
  .tag--premium { background: #c89a4b; }
  .tag--luxury { background: #2e241b; }
  .tr__body { padding: 1.2rem 1.4rem 1.2rem; display: grid; gap: 0.6rem; flex: 1; align-content: start; }
  h3 { font-size: var(--step-1); margin: 0; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--green); text-decoration: underline; }
  .tr__body p.muted { margin: 0; font-size: 0.96rem; }
  .tr__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; align-items: baseline; border-top: 1px solid var(--line); padding-top: 0.9rem; margin-top: auto; }
  .tr__foot p { margin: 0; }
  .tr__link { font-family: var(--display); font-weight: 600; font-size: 0.95rem; }
</style>
