---
import { site, waLink } from "../lib/site";
import { tours, tourUrl } from "../data/tours";
import { parks, parkUrl } from "../data/parks";
import { themes, themeUrl } from "../data/themes";
const year = new Date().getFullYear();
// hideTours: the fixed sample itineraries stay on their own pages (and in the sitemap) for SEO,
// but aren't promoted where we want guests to build their own trip.
const { hideTours = false } = Astro.props as { hideTours?: boolean };
---
<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <p class="ftr__name">{site.name}</p>
      <p>A TALA-registered safari operator based in Arusha, Tanzania.</p>
      <p><a href={waLink()} target="_blank" rel="noopener">WhatsApp {site.phoneDisplay}</a><br />
      <a href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a></p>
    </div>
    {!hideTours && <div>
      <p class="ftr__h">Sample safaris</p>
      <ul><li><a href="/tanzania-safari-packages">All sample safaris</a></li>{tours.map((t) => <li><a href={tourUrl(t)}>{t.nights + 1}-day {t.shortName} ({t.tier})</a></li>)}</ul>
    </div>}
    <div>
      <p class="ftr__h">Explore Tanzania</p>
      <ul>
        {parks.map((p) => <li><a href={parkUrl(p)}>{p.name}</a></li>)}
        <li><a href="/great-migration-serengeti">Great Migration by month</a></li>
        <li><a href="/lodges">Lodges and camps</a></li>
        {themes.map((t) => <li><a href={themeUrl(t)}>{t.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="ftr__h">Plan your trip</p>
      <ul>
        <li><a href="/post/how-much-does-a-tanzania-safari-cost-complete-budget-breakdown">Tanzania safari cost</a></li>
        <li><a href="/post/best-time-to-visit-tanzania-for-a-safari-month-by-month-guide">Best time to visit</a></li>
        <li><a href="/post/serengeti-vs-ngorongoro-which-safari-experience-is-right-for-you">Serengeti vs Ngorongoro</a></li>
        <li><a href="/post/tanzania-visa-guide-for-safari-travellers">Tanzania visa</a></li>
        <li><a href="/post/yellow-fever-vaccination-tanzania-safari">Yellow fever and vaccinations</a></li>
        <li><a href="/post/tanzania-safari-packing-list">Safari packing list</a></li>
        <li><a href="/post/tipping-on-safari-in-tanzania">Tipping on safari</a></li>
        <li><a href="/post/tanzania-weather-by-month">Weather by month</a></li>
        <li><a href="/how-it-works">How it works</a></li>
        <li><a href="/planner">Planner</a></li>
        <li><a href="/blog">Blogs</a></li>
        <li><a href="/about">About us</a></li>
        {hideTours && <li><a href="/tanzania-safari-packages" class="ftr__quiet">Sample itineraries</a></li>}
      </ul>
    </div>
  </div>
  <div class="wrap ftr__base">© {year} {site.name}, Arusha, Tanzania · <a href="#" data-ck-open>Cookie settings</a></div>
</footer>

<style>
  .ftr { background: var(--dark); color: #d8cdbd; padding: 3.5rem 0 1.5rem; font-size: 0.95rem; }
  .ftr a { color: var(--ivory); }
  .ftr a:hover { color: var(--gold); }
  .ftr__grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr; gap: 2.5rem; }
  .ftr__name { font-family: var(--serif); font-weight: 600; font-size: 1.45rem; color: var(--gold); }
  .ftr__quiet { opacity: 0.6; font-size: 0.88rem; }
  .ftr__h { font-family: var(--display); font-weight: 600; color: var(--gold); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: 0.45rem; }
  .ftr__base { border-top: 1px solid #4a3c2e; margin-top: 2.5rem; padding-top: 1.2rem; font-size: 0.85rem; color: #a8997f; }
  @media (max-width: 1000px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .ftr__grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
