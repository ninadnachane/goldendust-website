---
import { site, waLink } from "../lib/site";
import WaIcon from "./WaIcon.astro";
import MapIcon from "./MapIcon.astro";
import { langOf, basePath, lp, LANGS, LANG_NAMES } from "../i18n";
import { w } from "../i18n/common";
const lang = langOf(Astro.url);
const path = basePath(Astro.url);
const links = [
  { href: "/", label: w(lang, "home") },
  { href: "/about", label: w(lang, "about") },
  { href: "/how-it-works", label: w(lang, "how") },
  { href: "/blog", label: w(lang, "blogs"), match: ["/blog", "/post"] },
];
const isActive = (l: { href: string; match?: string[] }) =>
  l.href === "/" ? path === "/" : (l.match ?? [l.href]).some((m) => path.startsWith(m));
const planActive = path.startsWith("/planner");
// language links: the same page in the other language (the 404 page has no copies, so go to that language's home page)
const other = path === "/404" ? "/" : path;
const menu = { en: ["Open menu", "Close menu"], nl: ["Menu openen", "Menu sluiten"], de: ["Menü öffnen", "Menü schließen"], fr: ["Ouvrir le menu", "Fermer le menu"] }[lang];
const langLabel = { en: "Language", nl: "Taal", de: "Sprache", fr: "Langue" }[lang];
---
<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <a href={lp(lang, "/")} class="hdr__logo" aria-label={site.name}>
      <img src="/images/logo-header.webp" alt={site.name} width="520" height="254" />
    </a>
    <nav class="hdr__nav" id="main-menu" aria-label="Menu">
      <ul>
        {links.map((l) => (
          <li><a href={lp(lang, l.href)} aria-current={isActive(l) ? "page" : undefined}>{l.label}</a></li>
        ))}
        <li class="hdr__menu-plan"><a class="hdr__plan" href={lp(lang, "/planner")} aria-current={planActive ? "page" : undefined}><MapIcon /><span>{w(lang, "planner")}</span></a></li>
        <li class="hdr__menu-lang">{LANGS.map((l) => <a href={lp(l, other)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>{LANG_NAMES[l]}</a>)}</li>
      </ul>
    </nav>
    <div class="hdr__btns">
      <details class="hdr__lang" data-lang-menu>
        <summary aria-label={langLabel}>{lang.toUpperCase()}</summary>
        <ul>{LANGS.map((l) => <li><a href={lp(l, other)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>{LANG_NAMES[l]}</a></li>)}</ul>
      </details>
      <a class="hdr__plan hdr__plan--bar" href={lp(lang, "/planner")} aria-current={planActive ? "page" : undefined}><MapIcon /><span>{w(lang, "planner")}</span></a>
      <a class="hdr__wa" href={waLink()} target="_blank" rel="noopener"><WaIcon /><span>WhatsApp</span></a>
      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="main-menu" aria-label={menu[0]} data-menu-toggle data-open={menu[0]} data-close={menu[1]}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>("[data-hdr]");
  const btn = hdr?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  if (hdr && btn) {
    const set = (open: boolean) => {
      hdr.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", (open ? btn.dataset.close : btn.dataset.open) ?? "");
    };
    btn.addEventListener("click", () => set(!hdr.classList.contains("is-open")));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") set(false); });
    document.addEventListener("click", (e) => { if (!hdr.contains(e.target as Node)) set(false); });
  }
  const lm = document.querySelector<HTMLDetailsElement>("[data-lang-menu]");
  if (lm) {
    document.addEventListener("click", (e) => { if (!lm.contains(e.target as Node)) lm.open = false; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") lm.open = false; });
  }
</script>

<style>
  .hdr { background: var(--bg); box-shadow: 0 1px 12px rgba(46, 36, 27, 0.04); position: relative; z-index: 20; }
  .hdr__in { display: flex; align-items: center; gap: 1.5rem; height: 7.25rem; }
  .hdr__logo { display: block; }
  /* logo sits a little high so 'safaris' has breathing room above the photos (bar height unchanged) */
  .hdr__logo { align-self: flex-start; padding-top: 0.35rem; }
  .hdr__logo img { height: 94px; width: auto; background: transparent; }
  .hdr__nav { margin-left: auto; }
  ul { list-style: none; display: flex; align-items: center; gap: 1.6rem; margin: 0; padding: 0; }
  .hdr__nav a:not(.hdr__plan) { font-family: var(--display); font-weight: 600; font-size: 0.95rem; color: var(--ink); text-decoration: none; padding: 0.3rem 0; border-bottom: 2px solid transparent; }
  .hdr__nav a:not(.hdr__plan):hover { color: var(--gold); }
  .hdr__nav a:not(.hdr__plan)[aria-current] { color: var(--ink); border-bottom-color: var(--gold); }
  .hdr__menu-plan { display: none; }
  .hdr__wa {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.05rem; border-radius: 999px;
    background: var(--btn); color: var(--btn-text); font-family: var(--display); font-weight: 600; font-size: 0.92rem; text-decoration: none;
  }
  .hdr__wa:hover { background: var(--btn-hover); color: var(--btn-text); }
  .hdr__wa :global(svg), .hdr__plan :global(svg) { width: 1.15rem; height: 1.15rem; }
  .hdr__btns { display: flex; gap: 0.6rem; align-items: center; }
  .hdr__plan {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border-radius: 999px;
    border: 2px solid var(--gold); color: var(--ink); font-family: var(--display); font-weight: 600; font-size: 0.92rem; text-decoration: none;
  }
  .hdr__plan:hover, .hdr__plan[aria-current] { background: var(--gold); color: var(--dark); }
  .hdr__toggle { display: none; }
  .hdr__lang { position: relative; }
  .hdr__lang summary {
    list-style: none; cursor: pointer; font-family: var(--display); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.04em;
    padding: 0.55rem 0.75rem; border-radius: 999px; border: 2px solid var(--line); color: var(--ink);
  }
  .hdr__lang summary::-webkit-details-marker { display: none; }
  .hdr__lang summary::after { content: ""; display: inline-block; margin-left: 0.35rem; border: 4px solid transparent; border-top-color: currentColor; transform: translateY(2px); }
  .hdr__lang[open] summary, .hdr__lang summary:hover { border-color: var(--gold); }
  .hdr__lang ul {
    position: absolute; right: 0; top: calc(100% + 0.4rem); z-index: 30; display: grid; gap: 0; min-width: 10rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 0.4rem; box-shadow: 0 18px 30px -18px rgba(46, 36, 27, 0.4);
  }
  .hdr__lang a { display: block; padding: 0.5rem 0.8rem; border-radius: 8px; color: var(--ink); text-decoration: none; font-family: var(--display); font-weight: 600; font-size: 0.92rem; }
  .hdr__lang a:hover { background: var(--tint); }
  .hdr__lang a[aria-current] { color: var(--rust); }
  .hdr__menu-lang { display: none; }

  /* Phones and small tablets: logo, WhatsApp and a three-line menu button */
  @media (max-width: 860px) {
    .hdr__in { height: 5.5rem; gap: 0.75rem; }
    .hdr__logo { align-self: center; padding-top: 0; }
    .hdr__logo img { height: 68px; }
    .hdr__btns { margin-left: auto; }
    .hdr__plan--bar, .hdr__lang { display: none; }
    .hdr__menu-lang { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
    .hdr__nav .hdr__menu-lang a { padding: 0.45rem 0.9rem; border: 1px solid var(--line); border-radius: 999px; font-family: var(--display); font-weight: 600; font-size: 0.9rem; color: var(--ink); text-decoration: none; }
    .hdr__menu-lang a[aria-current] { border-color: var(--gold); background: var(--tint); }
    .hdr__toggle {
      display: grid; place-content: center; gap: 5px; width: 2.75rem; height: 2.75rem; border-radius: 50%;
      border: 2px solid var(--gold); background: transparent; cursor: pointer; padding: 0;
    }
    .hdr__toggle span { display: block; width: 18px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform 0.2s, opacity 0.2s; }
    .hdr.is-open .hdr__toggle { background: var(--gold); }
    .hdr.is-open .hdr__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hdr.is-open .hdr__toggle span:nth-child(2) { opacity: 0; }
    .hdr.is-open .hdr__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .hdr__nav {
      display: none; position: absolute; left: 0; right: 0; top: 100%; margin: 0;
      background: var(--bg); box-shadow: 0 18px 30px -18px rgba(46, 36, 27, 0.35); border-top: 1px solid var(--line);
      padding: 0.5rem var(--gutter) 1.25rem;
    }
    .hdr.is-open .hdr__nav { display: block; }
    ul { flex-direction: column; align-items: stretch; gap: 0; }
    .hdr__nav li:not(.hdr__menu-plan):not(.hdr__menu-lang) a { display: block; padding: 0.9rem 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
    .hdr__nav a:not(.hdr__plan)[aria-current] { border-bottom-color: var(--line); color: var(--rust); }
    .hdr__menu-plan { display: block; margin-top: 1rem; }
    .hdr__menu-plan .hdr__plan { width: 100%; justify-content: center; padding: 0.8rem 1rem; font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hdr__toggle span { transition: none; } }
</style>
