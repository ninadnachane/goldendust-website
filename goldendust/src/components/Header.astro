---
import { site, waLink } from "../lib/site";
import WaIcon from "./WaIcon.astro";
const path = Astro.url.pathname.replace(/\.html$/, "");
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About us" },
  { href: "/how-it-works", label: "How it works" },
  { href: "/planner", label: "Planner" },
  { href: "/blog", label: "Blogs", match: ["/blog", "/post"] },
];
const isActive = (l: { href: string; match?: string[] }) =>
  l.href === "/" ? path === "/" || path === "/index" : (l.match ?? [l.href]).some((m) => path.startsWith(m));
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${site.name} home`}>
      <img src="/images/logo-header.webp" alt={site.name} width="440" height="223" />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l) ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="hdr__wa" href={waLink()} target="_blank" rel="noopener"><WaIcon /><span>WhatsApp</span></a>
  </div>
</header>

<style>
  .hdr { background: var(--surface); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; gap: 1.5rem; min-height: 6.875rem; padding-top: 0.2rem; padding-bottom: 0.2rem; }
  .hdr__logo { display: block; }
  .hdr__logo img { height: 104px; width: auto; background: transparent; }
  nav { margin-left: auto; }
  ul { list-style: none; display: flex; gap: 1.6rem; margin: 0; padding: 0; }
  nav a { font-family: var(--display); font-weight: 600; font-size: 0.95rem; color: var(--ink); text-decoration: none; padding: 0.3rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--gold); }
  nav a[aria-current] { color: var(--ink); border-bottom-color: var(--gold); }
  .hdr__wa {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.6rem 1.05rem; border-radius: 999px;
    background: var(--btn); color: var(--btn-text); font-family: var(--display); font-weight: 600; font-size: 0.92rem; text-decoration: none;
  }
  .hdr__wa:hover { background: var(--btn-hover); color: var(--btn-text); }
  .hdr__wa :global(svg) { width: 1.15rem; height: 1.15rem; }
  @media (max-width: 860px) {
    .hdr__in { flex-wrap: wrap; gap: 0.4rem 1rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .hdr__logo img { height: 72px; }
    .hdr__wa { margin-left: auto; }
    nav { order: 3; width: 100%; margin: 0; overflow-x: auto; }
    ul { gap: 1rem; padding-bottom: 0.2rem; justify-content: space-between; }
    nav a { font-size: 0.84rem; white-space: nowrap; }
  }
</style>
