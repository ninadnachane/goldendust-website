---
// "From our Instagram": our own swipeable row built from Behold's JSON feed
// (one post per screen on phones, three on desktop). If the JSON feed can't be
// loaded, it falls back to Behold's standard widget.
import { site } from "../lib/site";
import BrandLink from "./BrandLink.astro";
import { langOf } from "../i18n";
const T = {
  en: { h: "From our Instagram", follow: `Follow ${site.instagramHandle} on Instagram`, p: "Real trips, real guides and real vehicles, straight from the bush.", latest: "Latest Instagram posts", empty: "See our latest safari photos and reels on Instagram", prev: "Previous posts", next: "Next posts" },
  nl: { h: "Van onze Instagram", follow: `Volg ${site.instagramHandle} op Instagram`, p: "Echte reizen, echte gidsen en echte voertuigen, rechtstreeks uit de bush.", latest: "Nieuwste Instagram-berichten", empty: "Bekijk onze nieuwste safarifoto's en reels op Instagram", prev: "Vorige berichten", next: "Volgende berichten" },
  de: { h: "Von unserem Instagram", follow: `${site.instagramHandle} auf Instagram folgen`, p: "Echte Reisen, echte Guides und echte Fahrzeuge, direkt aus dem Busch.", latest: "Neueste Instagram-Beiträge", empty: "Unsere neuesten Safarifotos und Reels auf Instagram", prev: "Vorherige Beiträge", next: "Nächste Beiträge" },
  fr: { h: "Sur notre Instagram", follow: `Suivre ${site.instagramHandle} sur Instagram`, p: "De vrais voyages, de vrais guides et de vrais véhicules, tout droit de la brousse.", latest: "Dernières publications Instagram", empty: "Nos dernières photos et vidéos de safari sur Instagram", prev: "Publications précédentes", next: "Publications suivantes" },
}[langOf(Astro.url)];
const widgetId = site.instagramFeedId;
const jsonId = site.instagramJsonFeedId || site.instagramFeedId;
---
<section class="section" aria-labelledby="ig-h">
  <div class="wrap">
    <div class="ig__head">
      <h2 id="ig-h">{T.h}</h2>
      <BrandLink brand="instagram" href={site.instagram} label={T.follow} size="lg" />
    </div>
    <p class="muted measure">{T.p}</p>
    {widgetId ? (
      <div class="ig" data-ig data-json={`https://feeds.behold.so/${jsonId}`} data-widget={widgetId}>
        <div class="ig__track" data-ig-track tabindex="0" aria-label={T.latest}></div>
        <div class="ig__nav" data-ig-nav hidden>
          <div class="ig__dots" data-ig-dots aria-hidden="true"></div>
          <div class="ig__btns">
            <button type="button" data-ig-dir="-1" aria-label={T.prev}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
            <button type="button" data-ig-dir="1" aria-label={T.next}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
          </div>
        </div>
        <div class="ig__fallback" data-ig-fallback></div>
      </div>
    ) : (
      <a class="ig__empty" href={site.instagram} target="_blank" rel="noopener">
        {T.empty}
      </a>
    )}
  </div>
</section>

<script>
  type Size = { mediaUrl: string };
  type Post = {
    permalink: string; mediaType: string; prunedCaption?: string;
    sizes?: { small?: Size; medium?: Size; large?: Size };
    thumbnailUrl?: string; mediaUrl?: string;
  };

  function loadWidget(root: HTMLElement) {
    const box = root.querySelector<HTMLElement>("[data-ig-fallback]")!;
    const w = document.createElement("behold-widget");
    w.setAttribute("feed-id", root.dataset.widget || "");
    box.append(w);
    if (!(window as any).__bhldScript) {
      (window as any).__bhldScript = true;
      const s = document.createElement("script");
      s.type = "module";
      s.src = "https://w.behold.so/widget.js";
      document.head.append(s);
    }
  }

  function render(root: HTMLElement, posts: Post[]) {
    const track = root.querySelector<HTMLElement>("[data-ig-track]")!;
    posts.forEach((p) => {
      const src = p.sizes?.medium?.mediaUrl || p.sizes?.large?.mediaUrl || p.thumbnailUrl || p.mediaUrl;
      if (!src) return;
      const a = document.createElement("a");
      a.className = "ig__post";
      a.href = p.permalink;
      a.target = "_blank";
      a.rel = "noopener";
      const img = document.createElement("img");
      img.src = src;
      img.loading = "lazy";
      img.alt = (p.prunedCaption || "Golden Dust Safaris on Instagram").slice(0, 120);
      a.append(img);
      if (p.mediaType === "VIDEO") {
        const tag = document.createElement("span");
        tag.className = "ig__tag";
        tag.textContent = "Reel";
        a.append(tag);
      }
      track.append(a);
    });
    if (!track.children.length) throw new Error("no posts");

    const nav = root.querySelector<HTMLElement>("[data-ig-nav]")!;
    const dotsBox = root.querySelector<HTMLElement>("[data-ig-dots]")!;
    const pages = () => Math.max(1, Math.round(track.scrollWidth / track.clientWidth));
    const idx = () => Math.round(track.scrollLeft / track.clientWidth);
    const drawDots = () => {
      dotsBox.replaceChildren(...Array.from({ length: pages() }, (_, i) => {
        const d = document.createElement("span");
        d.className = "ig__dot" + (i === idx() ? " is-on" : "");
        return d;
      }));
    };
    const go = (i: number) => {
      const n = pages();
      track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: "smooth" });
    };
    root.querySelectorAll<HTMLButtonElement>("[data-ig-dir]").forEach((b) =>
      b.addEventListener("click", () => go(idx() + Number(b.dataset.igDir)))
    );
    track.addEventListener("scroll", () => {
      dotsBox.querySelectorAll(".ig__dot").forEach((d, j) => d.classList.toggle("is-on", j === idx()));
    }, { passive: true });
    window.addEventListener("resize", drawDots);
    nav.hidden = false;
    drawDots();
  }

  document.querySelectorAll<HTMLElement>("[data-ig]").forEach((root) => {
    fetch(root.dataset.json!)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data) => render(root, (data && data.posts) || []))
      .catch(() => loadWidget(root));
  });
</script>

<style>
  .ig__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .ig__head h2 { margin: 0; }
  .ig { margin-top: 1.5rem; }
  .ig__track { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .ig__track::-webkit-scrollbar { display: none; }
  .ig__track:empty { display: none; }
  .ig__track :global(.ig__post) {
    position: relative; flex: 0 0 calc((100% - 2rem) / 3); scroll-snap-align: start;
    border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--line); display: block;
  }
  .ig__track :global(.ig__post img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .ig__track :global(.ig__post:hover img) { transform: scale(1.03); }
  .ig__track :global(.ig__tag) {
    position: absolute; top: 0.7rem; right: 0.7rem; font-size: 0.75rem; font-weight: 600;
    padding: 0.2rem 0.6rem; border-radius: 99px; background: rgba(46, 36, 27, 0.7); color: var(--ivory);
  }
  .ig__nav { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; }
  .ig__nav[hidden] { display: none; }
  .ig__dots { display: flex; gap: 6px; }
  .ig__dots :global(.ig__dot) { width: 7px; height: 7px; border-radius: 99px; background: var(--line); transition: width 0.25s, background 0.25s; }
  .ig__dots :global(.ig__dot.is-on) { width: 22px; background: var(--gold); }
  .ig__btns { display: flex; gap: 0.5rem; }
  .ig__btns button { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); cursor: pointer; display: grid; place-items: center; color: var(--ink); }
  .ig__btns button:hover { background: var(--gold); border-color: var(--gold); }
  .ig__btns svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .ig__empty {
    display: block; margin-top: 1.5rem; padding: 2.5rem 1.5rem; text-align: center; border: 2px dashed var(--gold);
    border-radius: 10px; font-weight: 600; color: var(--rust); text-decoration: none; background: var(--surface);
  }
  .ig__empty:hover { background: var(--ivory); }
  @media (max-width: 760px) {
    /* phones: one post per screen, with the next one peeking in */
    .ig__track { gap: 0.75rem; scroll-padding-left: 0; }
    .ig__track :global(.ig__post) { flex-basis: 86%; }
  }
  @media (prefers-reduced-motion: reduce) { .ig__track :global(.ig__post img) { transition: none; } }
</style>
