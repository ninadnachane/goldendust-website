---
import { gallery } from "../data/gallery";
import { img } from "../lib/site";
const src = (s: string) => (s.startsWith("/") ? s : img(s, 1600));
---
<section class="gal" aria-roledescription="carousel" aria-label="Safari photos">
  <div class="gal__track" tabindex="0" data-track>
    {gallery.map((p, i) => (
      <figure class="gal__slide" aria-label={`Photo ${i + 1} of ${gallery.length}`}>
        <img src={src(p.src)} alt={p.alt} width="1600" height="900" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} />
      </figure>
    ))}
  </div>
  {gallery.length > 1 && (
    <div class="gal__ctrl">
      <button type="button" data-dir="-1" aria-label="Previous photo">‹</button>
      <button type="button" data-dir="1" aria-label="Next photo">›</button>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>(".gal").forEach((gal) => {
    const track = gal.querySelector<HTMLElement>("[data-track]")!;
    gal.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) =>
      b.addEventListener("click", () => {
        const dir = Number(b.dataset.dir);
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        const atStart = track.scrollLeft <= 4;
        if (dir > 0 && atEnd) track.scrollTo({ left: 0, behavior: "smooth" });
        else if (dir < 0 && atStart) track.scrollTo({ left: track.scrollWidth, behavior: "smooth" });
        else track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: "smooth" });
      })
    );
  });
</script>

<style>
  .gal { position: relative; background: var(--dark); }
  .gal__track {
    display: flex; gap: 6px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    height: clamp(260px, 52vh, 560px);
  }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__slide { margin: 0; flex: 0 0 auto; height: 100%; scroll-snap-align: start; }
  .gal__slide img { height: 100%; width: auto; max-width: none; object-fit: cover; background: #3a2f25; }
  .gal__ctrl { position: absolute; right: var(--gutter); bottom: 1rem; display: flex; gap: 0.5rem; }
  .gal__ctrl button {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(46, 36, 27, 0.72); color: var(--ivory); font-size: 1.6rem; line-height: 1;
  }
  .gal__ctrl button:hover { background: var(--rust); }
  @media (max-width: 640px) {
    .gal__track { height: 300px; }
    .gal__slide { width: 88vw; }
    .gal__slide img { width: 100%; }
  }
</style>
