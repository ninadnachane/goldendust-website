---
import Base from "../layouts/Base.astro";
import LodgeCard from "../components/LodgeCard.astro";
import GuideAside from "../components/GuideAside.astro";
import { lodgesWithPages, lodgeUrl, AREAS, TIER_TEXT } from "../data/lodges";
import { parksFor, parkUrl } from "../data/parks";
import { breadcrumbs } from "../lib/schema";
import { waLink } from "../lib/site";
import { langOf, lp } from "../i18n";
import { w, tierName, place } from "../i18n/common";

const { slug } = Astro.props as { slug: string };
const lang = langOf(Astro.url);
const L = (x: string) => lp(lang, x);
const l = lodgesWithPages.find((x) => x.slug === slug)!;
const area = AREAS[l.area];
const areaName = place(lang, area.name);
const park = parksFor(lang).find((p) => p.slug === area.park)!;
const nearby = lodgesWithPages.filter((x) => x.area === l.area && x.slug !== l.slug).slice(0, 6);
const tier = tierName(lang, l.tier);
const T = {
  en: { where: l.area === "ndutu" ? "Ndutu, on the edge of the southern Serengeti" : l.area === "north-serengeti" ? "Kogatende, in the northern Serengeti near the Mara River" : areaName, area: "Area", style: "Style", guide: "Park guide", photo: "photo", intro: (wh: string) => `${l.name} is one of the camps and lodges we work with in ${wh}. In our safari styles it counts as`, planner: ["It's in our ", "itinerary planner", ", so you can add it to your route and see the price for your dates straight away, with park fees, your vehicle and guide included."], ask: ["Want to stay here? ", "Message us on WhatsApp", " and we'll price it for your dates."], about: `About ${areaName}`, read: ["Read our ", `${park.name} guide`, " for the best time to go and how long to stay."], others: `Other lodges in ${areaName}`, desc: (wh: string) => `${l.name} in ${wh}: photos, style (${tier}) and how to include it in a private Tanzania safari with Golden Dust Safaris.`, title: `${l.name}, ${areaName} | Safari Lodge Photos` },
  nl: { where: l.area === "ndutu" ? "Ndutu, aan de rand van de zuidelijke Serengeti" : l.area === "north-serengeti" ? "Kogatende, in de noordelijke Serengeti bij de Mara-rivier" : areaName, area: "Gebied", style: "Stijl", guide: "Parkgids", photo: "foto", intro: (wh: string) => `${l.name} is een van de kampen en lodges waarmee we werken in ${wh}. In onze safaristijlen valt het onder`, planner: ["Het staat in onze ", "reisplanner", ", dus je kunt het aan je route toevoegen en meteen de prijs voor jouw data zien, inclusief parkkosten, voertuig en gids."], ask: ["Wil je hier overnachten? ", "Stuur ons een WhatsApp", " en we berekenen de prijs voor jouw data."], about: `Over ${areaName}`, read: ["Lees onze ", `gids over ${park.name}`, " voor de beste reistijd en hoelang je kunt blijven."], others: `Andere lodges in ${areaName}`, desc: (wh: string) => `${l.name} in ${wh}: foto's, stijl (${tier}) en hoe je het opneemt in een privésafari in Tanzania met Golden Dust Safaris.`, title: `${l.name}, ${areaName} | Foto's van de safarilodge` },
  de: { where: l.area === "ndutu" ? "Ndutu, am Rand der südlichen Serengeti" : l.area === "north-serengeti" ? "Kogatende, in der nördlichen Serengeti am Mara-Fluss" : areaName, area: "Gebiet", style: "Stil", guide: "Park-Ratgeber", photo: "Foto", intro: (wh: string) => `${l.name} gehört zu den Camps und Lodges, mit denen wir arbeiten (${wh}). In unseren Safari-Stilen zählt es als`, planner: ["Es ist in unserem ", "Reiseplaner", ", Sie können es also Ihrer Route hinzufügen und sofort den Preis für Ihre Reisedaten sehen, mit Parkgebühren, Fahrzeug und Guide."], ask: ["Möchten Sie hier übernachten? ", "Schreiben Sie uns per WhatsApp", ", und wir berechnen den Preis für Ihre Reisedaten."], about: `Über ${areaName}`, read: ["Lesen Sie unseren ", `Ratgeber: ${park.name}`, " für die beste Reisezeit und die ideale Aufenthaltsdauer."], others: `Weitere Lodges: ${areaName}`, desc: (wh: string) => `${l.name} in ${wh}: Fotos, Stil (${tier}) und wie Sie es in eine Privatsafari in Tansania mit Golden Dust Safaris einbauen.`, title: `${l.name}, ${areaName} | Fotos der Safari-Lodge` },
  fr: { where: l.area === "ndutu" ? "Ndutu, en bordure du sud du Serengeti" : l.area === "north-serengeti" ? "Kogatende, dans le nord du Serengeti, près de la rivière Mara" : areaName, area: "Zone", style: "Style", guide: "Guide du parc", photo: "photo", intro: (wh: string) => `${l.name} fait partie des camps et lodges avec lesquels nous travaillons (${wh}). Dans nos styles de safari, il est classé`, planner: ["Il figure dans notre ", "planificateur", " : vous pouvez l'ajouter à votre itinéraire et voir tout de suite le prix pour vos dates, droits d'entrée, véhicule et guide compris."], ask: ["Envie de séjourner ici ? ", "Écrivez-nous sur WhatsApp", " et nous calculerons le prix pour vos dates."], about: `À propos : ${areaName}`, read: ["Lisez notre ", `guide : ${park.name}`, " pour la meilleure période et la durée idéale du séjour."], others: `Autres lodges : ${areaName}`, desc: (wh: string) => `${l.name}, ${wh} : photos, style (${tier}) et comment l'intégrer à un safari privé en Tanzanie avec Golden Dust Safaris.`, title: `${l.name}, ${areaName} | Photos du lodge` },
}[lang];
const facts: [string, string][] = [[T.area, areaName], [T.style, tier], [T.guide, park.name]];
---
<Base title={`${T.title} | Golden Dust Safaris`} description={T.desc(T.where)}
  schema={[breadcrumbs([[w(lang, "home"), L("/")], [w(lang, "lodges"), L("/lodges")], [l.name, L(lodgeUrl(l))]])]}>
  <article class="section">
    <div class="wrap">
      <nav class="gp__crumbs" aria-label="Breadcrumb"><a href={L("/")}>{w(lang, "home")}</a> / <a href={L("/lodges")}>{w(lang, "lodges")}</a> / <a href={L(parkUrl(park))}>{areaName}</a></nav>
      <h1>{l.name}</h1>
      <p><span class={`tierpill tierpill--${l.tier.toLowerCase()}`}>{tier}</span> · {T.where}</p>
      <div class="ph">
        {l.photos.slice(0, 5).map((src, i) => <img src={src} alt={`${l.name}, ${T.photo} ${i + 1}`} loading={i ? "lazy" : "eager"} width="900" height="600" class={i === 0 ? "ph__main" : ""} />)}
      </div>
      <div class="gp__body">
        <div class="prose">
          <p>{T.intro(T.where)} <strong>{tier}</strong>: {TIER_TEXT[l.tier][lang]}.</p>
          {l.inPlanner
            ? <p>{T.planner[0]}<a href={L("/planner")}>{T.planner[1]}</a>{T.planner[2]}</p>
            : <p>{T.ask[0]}<a href={waLink(`Hi Golden Dust Safaris, I'd like a price for a safari staying at ${l.name}.`)} target="_blank" rel="noopener">{T.ask[1]}</a>{T.ask[2]}</p>}
          <h2>{T.about}</h2>
          <p>{park.lede} {T.read[0]}<a href={L(parkUrl(park))}>{T.read[1]}</a>{T.read[2]}</p>
        </div>
        <GuideAside facts={facts} />
      </div>
    </div>
  </article>
  {nearby.length > 0 && (
    <section class="section section--white">
      <div class="wrap">
        <h2>{T.others}</h2>
        <div class="gp__grid">{nearby.map((x) => <LodgeCard lodge={x} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .ph { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin: 1.5rem 0 2rem; }
  .ph img { width: 100%; height: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 8px; background: var(--line); }
  .ph .ph__main { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 700px) { .ph { grid-template-columns: repeat(2, 1fr); } }
</style>
