---
import Base from "../layouts/Base.astro";
import LodgeCard from "../components/LodgeCard.astro";
import { lodgesWithPages, AREAS, AREA_ORDER } from "../data/lodges";
import { parkUrl } from "../data/parks";
import { breadcrumbs } from "../lib/schema";
import { langOf, lp } from "../i18n";
import { w, place } from "../i18n/common";
const lang = langOf(Astro.url);
const L = (x: string) => lp(lang, x);
const groups = AREA_ORDER.map((a) => ({ id: a, ...AREAS[a], list: lodgesWithPages.filter((l) => l.area === a) })).filter((g) => g.list.length);
const T = {
  en: { title: "Safari Lodges & Camps in Tanzania: Serengeti, Ngorongoro, Tarangire", desc: "Photos of the safari lodges and tented camps we work with in the Serengeti, Ngorongoro, Karatu, Tarangire and Lake Manyara, from Comfort to Luxury.", h1: "Safari lodges and camps we work with", lede: ["Real photos of the places our guests stay, grouped by area. Each one is tagged Comfort, Premium or Luxury, the same styles you choose in our ", "planner", "."] },
  nl: { title: "Safarilodges en kampen in Tanzania: Serengeti, Ngorongoro, Tarangire", desc: "Foto's van de safarilodges en tentenkampen waarmee we werken in de Serengeti, Ngorongoro, Karatu, Tarangire en Lake Manyara, van Comfort tot Luxe.", h1: "Safarilodges en kampen waarmee we werken", lede: ["Echte foto's van de plekken waar onze gasten overnachten, per gebied. Elke lodge heeft het label Comfort, Premium of Luxe, dezelfde stijlen die je kiest in onze ", "reisplanner", "."] },
  de: { title: "Safari-Lodges und Camps in Tansania: Serengeti, Ngorongoro, Tarangire", desc: "Fotos der Safari-Lodges und Zeltcamps, mit denen wir in der Serengeti, in Ngorongoro, Karatu, im Tarangire und am Lake Manyara arbeiten, von Komfort bis Luxus.", h1: "Safari-Lodges und Camps, mit denen wir arbeiten", lede: ["Echte Fotos der Unterkünfte unserer Gäste, nach Gebieten sortiert. Jede ist als Komfort, Premium oder Luxus markiert, dieselben Stile, die Sie in unserem ", "Reiseplaner", " wählen."] },
  fr: { title: "Lodges et camps de safari en Tanzanie : Serengeti, Ngorongoro, Tarangire", desc: "Photos des lodges et camps de tentes avec lesquels nous travaillons au Serengeti, au Ngorongoro, à Karatu, à Tarangire et au lac Manyara, du Confort au Luxe.", h1: "Les lodges et camps avec lesquels nous travaillons", lede: ["De vraies photos des lieux où séjournent nos voyageurs, classés par zone. Chacun porte l'étiquette Confort, Premium ou Luxe, les mêmes styles que dans notre ", "planificateur", "."] },
}[lang];
---
<Base title={`${T.title} | Golden Dust Safaris`} description={T.desc} schema={[breadcrumbs([[w(lang, "home"), L("/")], [w(lang, "lodges"), L("/lodges")]])]}>
  <section class="section">
    <div class="wrap">
      <h1>{T.h1}</h1>
      <p class="lede measure">{T.lede[0]}<a href={L("/planner")}>{T.lede[1]}</a>{T.lede[2]}</p>
      {groups.map((g) => (
        <section class="grp">
          <h2><a href={L(parkUrl(g.park))}>{place(lang, g.name)}</a></h2>
          <div class="gp__grid">{g.list.map((l) => <LodgeCard lodge={l} />)}</div>
        </section>
      ))}
    </div>
  </section>
</Base>
<style>
  .grp { margin-top: 2.5rem; }
  .grp h2 a { color: var(--ink); }
</style>
