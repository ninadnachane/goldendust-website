---
import Base from "../layouts/Base.astro";
import WaButton from "../components/WaButton.astro";
import { site, waLink } from "../lib/site";
import { langOf, LOCALE } from "../i18n";
import { PLANNER_TEXT, AREA_TEXT, CATEGORY_TEXT, ADDON_TEXT } from "../i18n/planner";
const lang = langOf(Astro.url);
const P = PLANNER_TEXT[lang] as Record<string, any>;
// everything the script needs, read from data-i18n
const i18n = JSON.stringify({ lang, locale: LOCALE[lang], t: P, areas: AREA_TEXT, cats: CATEGORY_TEXT, addons: ADDON_TEXT });
---
<Base
  title={`${P.title} | Golden Dust Safaris`}
  description={P.desc}
  noindex
>
  <section class="section pl" data-planner data-wa={site.whatsapp} data-i18n={i18n}>
    <div class="wrap">
      <header class="pl__head">
        <h1>{P.h1}</h1>
        <p class="lede">{P.lede[0]}<a href={waLink()} target="_blank" rel="noopener">{P.lede[1]}</a>{P.lede[2]}</p>
      </header>

      <div class="pl__grid">
        <div class="pl__steps">
          <section class="step" data-step="1">
            <button type="button" class="step__head" data-open="1"><span class="step__n">1</span><span class="step__t">{P.s1}</span><span class="step__sum" data-sum="1"></span><span class="step__edit">{P.change}</span></button>
            <div class="step__body">
              <div class="row">
                <div class="count">
                  <span class="count__l">{P.adultsL}</span>
                  <div class="count__c"><button type="button" data-dec="adults" aria-label={P.fewerAdults}>−</button><output data-out="adults">2</output><button type="button" data-inc="adults" aria-label={P.moreAdults}>+</button></div>
                </div>
                <div class="count">
                  <span class="count__l">{P.childrenL} <small data-child-note></small></span>
                  <div class="count__c"><button type="button" data-dec="children" aria-label={P.fewerChildren}>−</button><output data-out="children">0</output><button type="button" data-inc="children" aria-label={P.moreChildren}>+</button></div>
                </div>
              </div>
              <div class="ages" data-ages></div>
              <button type="button" class="btn step__next" data-next="2">{P.next}</button>
            </div>
          </section>

          <section class="step" data-step="2">
            <button type="button" class="step__head" data-open="2"><span class="step__n">2</span><span class="step__t">{P.s2}</span><span class="step__sum" data-sum="2"></span><span class="step__edit">{P.change}</span></button>
            <div class="step__body">
              <div class="row">
                <div class="fld fld--date"><span id="arr-l">{P.arrivalL}</span>
                  <button type="button" class="datebtn" data-date-btn aria-labelledby="arr-l" aria-haspopup="dialog" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg><span data-date-text>{P.chooseDateBtn}</span></button>
                  <div class="cal" data-cal hidden role="dialog" aria-label={P.calAria}></div>
                </div>
                <label class="fld">{P.nightsL}<select data-nights></select></label>
              </div>
              <p class="note" data-date-note></p>
              <button type="button" class="btn step__next" data-next="3" disabled>{P.next}</button>
            </div>
          </section>

          <section class="step" data-step="3" data-where>
            <button type="button" class="step__head" data-open="3"><span class="step__n">3</span><span class="step__t">{P.s3}</span><span class="step__sum" data-sum="3"></span><span class="step__edit">{P.change}</span></button>
            <div class="step__body">
              <p class="onus"><span class="onus__star" aria-hidden="true">★</span><span>{P.onus[0]}<strong data-arrival-name>Arusha</strong>{P.onus[1]}</span></p>
              <p class="note">{P.areasNote[0]}<strong data-safari-nights></strong>{P.areasNote[1]}<span class="tagkey">{["budget", "comfort", "premium", "luxury"].map((c) => CATEGORY_TEXT[c].name[lang]).join(" · ")}</span>{P.areasNote[2]}</p>
              <div class="chips" data-areas></div>
              <div class="stops" data-stops></div>
              <div class="addons" data-addons hidden><p class="addons__h">{P.addonsH} <small>{P.optional}</small></p><div class="addons__list" data-addon-list></div></div>
            </div>
          </section>
        </div>

        <aside class="pl__sum" aria-live="polite">
          <div class="sum" data-sum-box>
            <button type="button" class="sum__mini" data-sum-toggle aria-expanded="false">
              <span data-mini>{P.yourSafari}</span><span class="sum__chev" aria-hidden="true"></span>
            </button>
            <div class="sum__full">
              <p class="sum__h">{P.yourSafari}</p>
              <ol class="sum__trip" data-trip></ol>
              <div data-price></div>
            </div>
            <button type="button" class="btn sum__wa" data-send aria-disabled="true">{P.sendWa}</button>
            <button type="button" class="sum__pdf" data-pdf aria-disabled="true">{P.pdf}</button>
            <p class="sum__fine">{P.fine}</p>
          </div>
        </aside>
      </div>

      <dialog class="ct" data-contact aria-labelledby="ct-h">
        <form class="ct__in" data-contact-form novalidate>
          <div class="ct__head"><h2 id="ct-h">{P.sendH}</h2><button type="button" class="ct__x" data-ct-close aria-label={P.close}>✕</button></div>
          <p class="ct__lede" data-ct-lede>{P.ctLede}</p>
          <label>{P.ctName}<input name="name" autocomplete="name" required maxlength="100" /></label>
          <label>{P.ctPhone}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+31 6 1234 5678" required /></label>
          <label><span>{P.ctEmail} <small>{P.optional}</small></span><input name="email" type="email" autocomplete="email" /></label>
          <label class="ct__hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <p class="ct__err" role="alert" data-ct-err></p>
          <button type="submit" class="btn ct__go">{P.contWa}</button>
          <p class="ct__fine">{P.ctFine}</p>
        </form>
      </dialog>

      <noscript><p>{P.noscript[0]}<a href={`https://wa.me/${site.whatsapp}`}>{P.noscript[1]}</a>{P.noscript[2]}</p></noscript>
      <div class="pl__fallback" data-fallback hidden>
        <p>{P.fallback}</p>
        <WaButton label={P.fallbackBtn} />
      </div>
    </div>
  </section>
</Base>

<script>
  import { tripCategories, stopNights, lodgeProblem, imageUrl, craterIncluded, type Category } from "../planner/engine";
  type Opt = {
    settings: { leadDays: number; childMinAge: number; childMaxAge: number; minTotalNights: number; maxTotalNights: number; maxGuests: number };
    categories: { id: string; name: string; blurb: string }[];
    arrivalName: string;
    arrivalPriced?: boolean;
    areas: { id: string; name: string; minNights: number }[];
    lodges: { id: string; name: string; areaId: string; category: string; description: string; images: string[]; minChildAge?: number; open?: { from: string; to: string }[] }[];
    addons?: { id: string; name: string; blurb: string; per: string; rate: number; rateChild: number }[];
  };
  const root = document.querySelector<HTMLElement>("[data-planner]")!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  // text in the page's language (see src/i18n/planner.ts); WhatsApp messages stay in English for our team
  const I = JSON.parse(root.dataset.i18n || "{}");
  const LANG: string = I.lang || "en", LOC: string = I.locale || "en-GB";
  const PR = new Intl.PluralRules(LOC);
  const fill = (s: string, v: Record<string, unknown> = {}) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));
  const t = (k: string, v: Record<string, unknown> = {}) => { const x = I.t?.[k]; const s = Array.isArray(x) && x.length === 2 ? x[PR.select(Number(v.n ?? 0)) === "one" ? 0 : 1] : x; return fill(String(s ?? k), v); };
  // admin text by id, translated only while the English in admin still matches
  const tx = (m: any, id: string, kind: "name" | "blurb", en: string) => { const e = m?.[id]?.[kind]; return e && e.en === en ? (e[LANG] ?? en) : en; };
  const esc = (s: unknown) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const usd = (n: number) => "$" + Math.round(n).toLocaleString(LANG === "en" ? "en-US" : LOC);
  const usdEn = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
  const addDays = (iso: string, d: number) => { const x = new Date(iso + "T00:00:00Z"); x.setUTCDate(x.getUTCDate() + d); return x.toISOString().slice(0, 10); };
  const nice = (iso: string) => new Date(iso + "T00:00:00Z").toLocaleDateString(LOC, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
  const niceEn = (iso: string) => new Date(iso + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

  let O: Opt;
  const st = { adults: 2, ages: [] as number[], date: "", nights: 6, category: "", stops: [] as { areaId: string; nights: number; lodgeId: string }[], addons: [] as string[], open: 1, reached: 1 };
  const addonName = (id: string) => O.addons?.find((a) => a.id === id)?.name ?? id; // English (WhatsApp)
  const addonShow = (id: string) => { const a = O.addons?.find((x) => x.id === id); return a ? tx(I.addons, a.id, "name", a.name) : id; };
  const aName = (a: { id: string; name: string }) => tx(I.areas, a.id, "name", a.name);
  const areaShow = (id: string) => { const a = O.areas.find((x) => x.id === id); return a ? aName(a) : id; };
  const rank = (c: string) => O.categories.findIndex((x) => x.id === c);
  const catEn = (c: string) => O.categories.find((x) => x.id === c)?.name ?? c;
  const catName = (c: string) => tx(I.cats, c, "name", catEn(c));
  const styleNames = () => tripCategories(O.lodges as { id: string; category: Category }[], st.stops).map(catEn).join(" + ");
  const mobile = () => window.matchMedia("(max-width: 900px)").matches;

  function openStep(n: number, scroll = false) {
    st.open = n; st.reached = Math.max(st.reached, n);
    renderSteps();
    if (scroll) {
      const el = root.querySelector<HTMLElement>(`[data-step="${n}"]`)!;
      requestAnimationFrame(() => {
        const y = el.getBoundingClientRect().top + window.scrollY - (mobile() ? 12 : 24);
        if (el.getBoundingClientRect().top < 0 || el.getBoundingClientRect().top > window.innerHeight * 0.5) window.scrollTo({ top: y, behavior: "smooth" });
      });
    }
  }

  function renderSteps() {
    const kids = st.ages.length ? ` · ${t("children", { n: st.ages.length })} (${st.ages.join(", ")})` : "";
    const sums: Record<number, string> = {
      1: `${t("adults", { n: st.adults })}${kids}`,
      2: st.date ? `${nice(st.date)} · ${t("nights", { n: st.nights })}` : "",
      3: st.stops.length ? O.areas.filter((a) => st.stops.some((s) => s.areaId === a.id)).map(aName).join(", ") + (st.addons.length ? ` + ${t("addonsN", { n: st.addons.length })}` : "") : "",
    };
    root.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
      const n = Number(el.dataset.step);
      const open = st.open === n;
      const locked = n > st.reached;
      el.classList.toggle("is-open", open);
      el.classList.toggle("is-locked", locked);
      const head = el.querySelector<HTMLButtonElement>(".step__head")!;
      head.setAttribute("aria-expanded", String(open));
      head.disabled = locked;
      el.querySelector("[data-sum]")!.textContent = open ? "" : sums[n];
    });
    root.querySelector<HTMLButtonElement>('[data-next="3"]')!.disabled = !st.date;
  }

  const safariNights = () => st.nights - 1;
  const used = () => st.stops.reduce((a, s) => a + s.nights, 0);
  const areaOrder = (id: string) => O.areas.findIndex((a) => a.id === id);

  function renderPeople() {
    $("[data-out=adults]").textContent = String(st.adults);
    $("[data-out=children]").textContent = String(st.ages.length);
    $("[data-child-note]").textContent = `(0–${O.settings.childMaxAge})`;
    $("[data-ages]").innerHTML = st.ages.map((a, i) => `<label class="age">${esc(t("childAge", { i: i + 1 }))}<select data-age="${i}">${
      Array.from({ length: O.settings.childMaxAge + 1 }, (_, n) => `<option value="${n}" ${n === a ? "selected" : ""}>${n < 1 ? esc(t("under1")) : n}</option>`).join("")}</select></label>`).join("");
    root.querySelectorAll<HTMLSelectElement>("[data-age]").forEach((el) => el.addEventListener("change", () => { st.ages[Number(el.dataset.age)] = Number(el.value); update(); }));
  }

  // Lodges we can offer for each stop: a rate for every night (year ignored) and no child under the lodge's minimum age.
  const offer = () => {
    const nights = st.date ? stopNights(st.date, st.stops) : st.stops.map(() => []);
    return st.stops.map((s, i) => O.lodges.filter((l) => l.areaId === s.areaId && !lodgeProblem(l, nights[i], st.ages)));
  };
  const kidsOk = (areaId: string) => O.lodges.some((l) => l.areaId === areaId && !lodgeProblem(l, [], st.ages));
  let offerSig = "";
  const sigOf = (o: ReturnType<typeof offer>) => JSON.stringify(o.map((ls) => ls.map((l) => l.id)));

  function renderWhere() {
    $("[data-safari-nights]").textContent = t("safariNights", { n: safariNights() });
    const left = safariNights() - used();
    $("[data-areas]").innerHTML = O.areas.map((a) => {
      const on = st.stops.some((s) => s.areaId === a.id);
      const hasLodge = kidsOk(a.id);
      const blocked = !on && (!hasLodge || a.minNights > left);
      const why = !hasLodge ? t("noLodges") : a.minNights > left ? t("needsNights", { n: a.minNights }) : "";
      return `<button type="button" class="chip" data-area="${a.id}" aria-pressed="${on}" ${blocked ? 'aria-disabled="true"' : ""} title="${esc(why)}">${esc(aName(a))}${a.minNights > 1 ? ` <small>${esc(t("min", { n: a.minNights }))}</small>` : ""}</button>`;
    }).join("");
    root.querySelectorAll<HTMLButtonElement>("[data-area]").forEach((b) => b.addEventListener("click", () => {
      const id = b.dataset.area!;
      const i = st.stops.findIndex((s) => s.areaId === id);
      if (i >= 0) st.stops.splice(i, 1);
      else {
        if (b.getAttribute("aria-disabled") === "true") { flash(b.title); return; }
        const a = O.areas.find((x) => x.id === id)!;
        st.stops.push({ areaId: id, nights: Math.max(a.minNights, Math.min(safariNights() - used(), a.minNights)), lodgeId: "" });
        st.stops.sort((x, y) => areaOrder(x.areaId) - areaOrder(y.areaId));
      }
      renderWhere(); update();
    }));

    const avail = offer();
    offerSig = sigOf(avail);
    $("[data-stops]").innerHTML = st.stops.map((s, i) => {
      const a = O.areas.find((x) => x.id === s.areaId)!;
      const lodges = avail[i].sort((x, y) => rank(x.category) - rank(y.category));
      if (!lodges.some((l) => l.id === s.lodgeId)) s.lodgeId = (["comfort", "premium", "luxury", "budget"].map((c) => lodges.find((l) => l.category === c)).find(Boolean) ?? lodges[0])?.id || "";
      if (!lodges.length) return `<div class="stop">
        <div class="stop__top"><strong>${esc(aName(a))}</strong>
          <div class="count__c sm"><button type="button" data-sdec="${i}" aria-label="${esc(t("lessNight", { a: aName(a) }))}">−</button><output>${esc(t("nights", { n: s.nights }))}</output><button type="button" data-sinc="${i}" aria-label="${esc(t("moreNight", { a: aName(a) }))}">+</button></div></div>
        <p class="stop__none">${esc(t("noRates"))}</p></div>`;
      return `<div class="stop">
        <div class="stop__top"><strong>${esc(aName(a))}</strong>
          <div class="count__c sm"><button type="button" data-sdec="${i}" aria-label="${esc(t("lessNight", { a: aName(a) }))}">−</button><output>${esc(t("nights", { n: s.nights }))}</output><button type="button" data-sinc="${i}" aria-label="${esc(t("moreNight", { a: aName(a) }))}">+</button></div></div>
        <div class="lodges-wrap"><button type="button" class="lodges__arrow lodges__arrow--l" data-lscroll="-1" aria-label="${esc(t("scrollL"))}" hidden>‹</button><div class="lodges" data-lrow>${lodges.map((l) => `<label class="lodge">
          <input type="radio" name="lodge-${i}" value="${esc(l.id)}" ${l.id === s.lodgeId ? "checked" : ""} data-lodge="${i}">
          <span class="lodge__img"><button type="button" class="lodge__view" data-gal="${esc(l.id)}" data-gal-stop="${i}" aria-label="${esc(t("seePhotos", { l: l.name }))}">${l.images.length
            ? `<img src="${esc(imageUrl(l.images[0]))}" alt="" loading="lazy">`
            : `<span class="lodge__none">${esc(t("photosSoon"))}</span>`}<span class="lodge__more"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>${esc(l.images.length > 1 ? t("photosN", { n: l.images.length }) : t("details"))}</span></button></span>
          <span class="lodge__txt"><span class="tag tag--${esc(l.category)}">${esc(catName(l.category))}</span><strong>${esc(l.name)}</strong>${l.description ? `<span>${esc(l.description)}</span>` : ""}</span>
          <span class="lodge__tick" aria-hidden="true"></span>
        </label>`).join("")}</div><button type="button" class="lodges__arrow lodges__arrow--r" data-lscroll="1" aria-label="${esc(t("scrollR"))}" hidden>›</button></div>
      </div>`;
    }).join("");
    root.querySelectorAll<HTMLButtonElement>("[data-sinc]").forEach((b) => b.addEventListener("click", () => {
      const s = st.stops[Number(b.dataset.sinc)];
      if (used() >= safariNights()) return flash(t("allUsed"));
      s.nights++; renderWhere(); update();
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-sdec]").forEach((b) => b.addEventListener("click", () => {
      const s = st.stops[Number(b.dataset.sdec)];
      const a = O.areas.find((x) => x.id === s.areaId)!;
      if (s.nights <= a.minNights) return flash(t("needsAtLeast", { a: aName(a), n: a.minNights }));
      s.nights--; renderWhere(); update();
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-gal]").forEach((b) => b.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); openGallery(b.dataset.gal!, Number(b.dataset.galStop)); }));
    root.querySelectorAll<HTMLInputElement>("[data-lodge]").forEach((el) => el.addEventListener("change", () => { st.stops[Number(el.dataset.lodge)].lodgeId = el.value; update(); }));
    // horizontal lodge rows: arrows on desktop, keep the chosen lodge in view
    root.querySelectorAll<HTMLElement>(".lodges-wrap").forEach((w) => {
      const row = w.querySelector<HTMLElement>("[data-lrow]")!;
      const [l, r] = [w.querySelector<HTMLButtonElement>("[data-lscroll='-1']")!, w.querySelector<HTMLButtonElement>("[data-lscroll='1']")!];
      const sync = () => { const can = row.scrollWidth > row.clientWidth + 4; l.hidden = !can || row.scrollLeft < 4; r.hidden = !can || row.scrollLeft + row.clientWidth > row.scrollWidth - 4; };
      row.addEventListener("scroll", sync, { passive: true });
      [l, r].forEach((b) => b.addEventListener("click", () => row.scrollBy({ left: Number(b.dataset.lscroll) * row.clientWidth * 0.8, behavior: "smooth" })));
      const sel = row.querySelector<HTMLElement>(".lodge:has(input:checked)");
      if (sel && sel.offsetLeft + sel.offsetWidth > row.clientWidth) row.scrollLeft = sel.offsetLeft - 8;
      requestAnimationFrame(sync);
    });
  }

  // photo viewer: enlarged, swipe or scroll through all photos, choose the lodge from here
  function openGallery(id: string, stopIndex: number) {
    const l = O.lodges.find((x) => x.id === id);
    if (!l) return;
    const n = Math.max(1, l.images.length);
    const d = document.createElement("dialog");
    d.className = "gv";
    d.setAttribute("aria-label", t("gvAria", { l: l.name }));
    d.innerHTML = `<div class="gv__in">
        <div class="gv__top"><div><span class="gv__tag">${esc(catName(l.category))}</span><strong>${esc(l.name)}</strong>${l.description ? `<p>${esc(l.description)}</p>` : ""}</div>
          <button type="button" class="gv__x" data-gv-close aria-label="${esc(t("close"))}">✕</button></div>
        <div class="gv__stage">
          <div class="gv__track" tabindex="0">${l.images.length ? l.images.map((im, k) => `<figure><img src="${esc(imageUrl(im))}" alt="${esc(t("photoOf", { l: l.name, k: k + 1, n }))}" ${k > 1 ? 'loading="lazy"' : ""}></figure>`).join("") : `<figure class="gv__empty"><span>${esc(t(l.category === "budget" ? "soonCamp" : "soonLodge"))}</span></figure>`}</div>
          ${n > 1 ? `<button type="button" class="gv__nav gv__prev" data-gv="-1" aria-label="${esc(t("prevPhoto"))}">‹</button><button type="button" class="gv__nav gv__next" data-gv="1" aria-label="${esc(t("nextPhoto"))}">›</button>` : ""}
        </div>
        <div class="gv__bottom">${n > 1 ? `<span class="gv__dots">${l.images.map((_, k) => `<i class="${k === 0 ? "on" : ""}"></i>`).join("")}</span><span class="gv__count" data-gv-count>1 / ${n}</span>` : "<span></span>"}
          <button type="button" class="btn gv__pick" data-gv-pick>${esc(st.stops[stopIndex]?.lodgeId === l.id ? t("selected") : t("choose"))}</button></div>
      </div>`;
    const track = d.querySelector<HTMLElement>(".gv__track")!;
    const idx = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (k: number) => track.scrollTo({ left: ((k + n) % n) * track.clientWidth, behavior: "smooth" });
    track.addEventListener("scroll", () => {
      const k = idx();
      const c = d.querySelector("[data-gv-count]"); if (c) c.textContent = `${k + 1} / ${n}`;
      d.querySelectorAll(".gv__dots i").forEach((dot, j) => dot.classList.toggle("on", j === k));
    }, { passive: true });
    d.querySelectorAll<HTMLButtonElement>("[data-gv]").forEach((b) => b.addEventListener("click", () => go(idx() + Number(b.dataset.gv))));
    d.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") { e.preventDefault(); go(idx() + 1); } if (e.key === "ArrowLeft") { e.preventDefault(); go(idx() - 1); } });
    d.querySelector("[data-gv-close]")!.addEventListener("click", () => d.close());
    d.querySelector("[data-gv-pick]")!.addEventListener("click", () => {
      if (st.stops[stopIndex]) { st.stops[stopIndex].lodgeId = l.id; renderWhere(); update(); }
      d.close();
    });
    d.addEventListener("click", (e) => { if (e.target === d) d.close(); });
    d.addEventListener("close", () => { d.remove(); document.documentElement.style.overflow = ""; });
    root.append(d);
    document.documentElement.style.overflow = "hidden";
    d.showModal();
    track.focus({ preventScroll: true });
  }

  let toast: number | undefined;
  function flash(msg: string) {
    if (!msg) return;
    let t = root.querySelector<HTMLElement>(".toast");
    if (!t) { t = document.createElement("div"); t.className = "toast"; t.setAttribute("role", "status"); root.append(t); }
    t.textContent = msg; t.classList.add("is-on");
    clearTimeout(toast); toast = window.setTimeout(() => t!.classList.remove("is-on"), 3200);
  }

  function renderTrip() {
    const items: string[] = [];
    if (st.date || st.stops.length) items.push(`<li>${esc(t("arrive", { a: O.arrivalName }))}<span class="onus-tag">${esc(t("onUs"))}</span></li>`);
    for (const s of st.stops) {
      const a = O.areas.find((x) => x.id === s.areaId)!;
      const l = O.lodges.find((x) => x.id === s.lodgeId);
      items.push(`<li><b>${esc(t("nights", { n: s.nights }))} ${esc(aName(a))}</b>${l ? `<span>${esc(l.name)}</span>` : ""}</li>`);
    }
    for (const id of st.addons) items.push(`<li>${esc(addonShow(id))}</li>`);
    if (st.stops.length) items.push(`<li>${esc(t("back"))}</li>`);
    $("[data-trip]").innerHTML = items.join("") || `<li class="sum__empty">${esc(t("empty"))}</li>`;
  }

  function waText(total?: number, name?: string, ref?: string) {
    const lines = [
      `Hi Golden Dust Safaris${name ? `, this is ${name}` : ""}. I built this itinerary on your planner${ref ? ` (ref ${ref})` : ""}:`,
      `• ${st.adults} adult${st.adults > 1 ? "s" : ""}${st.ages.length ? `, children aged ${st.ages.join(", ")}` : ""}`,
      `• Arriving ${st.date ? niceEn(st.date) : "(date tbc)"}, ${st.nights} nights`,
      `• Style: ${styleNames() || "tbc"}`,
      `• Night 1: ${O.arrivalName}`,
      ...st.stops.map((s) => `• ${s.nights} night${s.nights > 1 ? "s" : ""} ${O.areas.find((a) => a.id === s.areaId)?.name}: ${O.lodges.find((l) => l.id === s.lodgeId)?.name ?? ""}`),
      ...st.addons.map((id) => `• Add-on: ${addonName(id)}`),
    ];
    if (total) lines.push(`• Planner price: ${usdEn(total)}`);
    if (LANG !== "en") lines.push(`• Website language: ${LANG.toUpperCase()}`);
    lines.push("Could you check availability?");
    return lines.join("\n");
  }

  let timer: number | undefined, seq = 0, lastTotal = 0;

  // ---- send on WhatsApp: collect name + number, save the lead, then open WhatsApp
  const store = { get: (k: string) => { try { return localStorage.getItem(k) || ""; } catch { return ""; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} } };
  // One lead per trip: if the guest already left their details for this exact trip, reuse it.
  let lastLead: { key: string; ref: string; token: string } | null = null;
  let mode: "whatsapp" | "pdf" = "whatsapp";
  const tripNow = () => ({ startDate: st.date, adults: st.adults, childAges: st.ages, totalNights: st.nights, stops: st.stops, addons: st.addons });
  const pdfUrl = (ref: string, token: string) => `${LANG === "en" ? "" : "/" + LANG}/itinerary#ref=${encodeURIComponent(ref)}&k=${encodeURIComponent(token)}`;
  function openContact(m: "whatsapp" | "pdf") {
    const send = $("[data-send]");
    if (send.getAttribute("aria-disabled") === "true") { flash(t("finishFirst")); return; }
    mode = m;
    (window as any).gdTrack?.(m === "pdf" ? "planner_pdf_click" : "planner_whatsapp_click", { value: lastTotal || undefined, currency: "USD" });
    const key = JSON.stringify(tripNow());
    if (m === "pdf" && lastLead && lastLead.key === key) { window.open(pdfUrl(lastLead.ref, lastLead.token), "_blank"); return; }
    const d = $<HTMLDialogElement>("[data-contact]");
    const f = $<HTMLFormElement>("[data-contact-form]");
    (f.elements.namedItem("name") as HTMLInputElement).value ||= store.get("gd_name");
    (f.elements.namedItem("phone") as HTMLInputElement).value ||= store.get("gd_phone");
    (f.elements.namedItem("email") as HTMLInputElement).value ||= store.get("gd_email");
    $("[data-ct-err]").textContent = "";
    $("#ct-h").textContent = m === "pdf" ? t("pdfH") : t("sendH");
    $("[data-ct-lede]").textContent = m === "pdf" ? t("pdfLede") : t("ctLede");
    f.querySelector<HTMLButtonElement>(".ct__go")!.textContent = m === "pdf" ? t("openPdf") : t("contWa");
    d.showModal();
  }
  async function submitContact(e: Event) {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value.trim();
    const err = $("[data-ct-err]");
    const phone = v("phone").replace(/[^\d+]/g, "").replace(/^00/, "+");
    if (v("name").length < 2) { err.textContent = t("errName"); return; }
    if (!/^\+\d{8,15}$/.test(phone)) { err.textContent = t("errPhone"); return; }
    if (v("email") && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v("email"))) { err.textContent = t("errEmail"); return; }
    const btn = f.querySelector<HTMLButtonElement>(".ct__go")!;
    const label = btn.textContent;
    btn.disabled = true; btn.textContent = t("saving");
    // open the new tab now (inside the click) so pop-up blockers allow it
    const win = mode === "pdf" || window.matchMedia("(pointer: fine)").matches ? window.open("", "_blank") : null;
    const trip = tripNow();
    const r = await fetch("/api/planner/lead", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name: v("name"), phone, email: v("email"), website: v("website"), trip, source: mode }) })
      .then(async (x) => ({ ok: x.ok, d: await x.json().catch(() => ({})) })).catch(() => ({ ok: false, d: { network: true } as any }));
    btn.disabled = false; btn.textContent = label;
    if (!r.ok && (mode === "pdf" || !r.d.network)) { win?.close(); err.textContent = (LANG === "en" && r.d.error) || t("errSave"); return; }
    store.set("gd_name", v("name")); store.set("gd_phone", phone); store.set("gd_email", v("email"));
    if (r.d.ref && r.d.token) lastLead = { key: JSON.stringify(trip), ref: r.d.ref, token: r.d.token };
    const url = mode === "pdf"
      ? pdfUrl(r.d.ref, r.d.token)
      : `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(waText(lastTotal || undefined, v("name"), r.d.ref))}`;
    $<HTMLDialogElement>("[data-contact]").close();
    (window as any).gdTrack?.("generate_lead", { method: mode === "pdf" ? "pdf_download" : "whatsapp", value: lastTotal || undefined, currency: "USD" });
    if (win) win.location.href = url; else window.location.href = url;
  }
  const mini = (html: string) => { $("[data-mini]").innerHTML = html; };
  // a night at Ngorongoro always includes the crater game drive: tick it and lock it
  let craterForced = false;
  function syncCrater() {
    const el = root.querySelector<HTMLInputElement>('[data-addon][value="crater"]');
    if (!el) return;
    const must = craterIncluded(st.stops);
    if (must && !el.disabled) { el.checked = true; el.disabled = true; craterForced = true; }
    else if (!must && el.disabled) { el.disabled = false; if (craterForced) el.checked = false; craterForced = false; }
    el.closest(".addon")?.classList.toggle("is-included", must);
    st.addons = [...root.querySelectorAll<HTMLInputElement>("[data-addon]:checked")].map((x) => x.value);
  }
  function update() {
    if (O && st.stops.length && sigOf(offer()) !== offerSig) renderWhere();
    syncCrater();
    renderPeople(); renderTrip(); renderSteps();
    const send = $<HTMLButtonElement>("[data-send]");
    const price = $("[data-price]");
    const ready = st.date && st.stops.length;
    lastTotal = 0;
    $("[data-pdf]").setAttribute("aria-disabled", "true");
    if (!ready) {
      const w = !st.date ? t("chooseDate") : t("chooseWhere");
      price.innerHTML = `<p class="sum__wait">${esc(t("toSee", { w }))}</p>`;
      mini(`<span class="sum__mt">${esc(w)}</span>`);
      send.setAttribute("aria-disabled", "true");
      return;
    }
    const left = safariNights() - used();
    if (left !== 0) {
      mini(`<span class="sum__mt">${esc(left > 0 ? t("stillMini", { n: left }) : t("tooManyMini", { n: -left }))}</span>`);
      price.innerHTML = `<p class="sum__wait">${esc(left > 0 ? t("stillLong", { n: left }) : t("tooManyLong", { n: -left }))}</p>`;
      send.setAttribute("aria-disabled", "true");
      return;
    }
    clearTimeout(timer);
    price.classList.add("is-loading");
    timer = window.setTimeout(async () => {
      const my = ++seq;
      const body = tripNow();
      const r = await fetch("/api/planner/quote", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) }).then((x) => x.json()).catch(() => null);
      if (my !== seq) return;
      price.classList.remove("is-loading");
      if (!r) { price.innerHTML = `<p class="sum__wait">${esc(t("noPrice"))}</p>`; send.removeAttribute("aria-disabled"); return; }
      if (!r.ok) { mini(`<span class="sum__mt">${esc(t("check"))}</span>`); price.innerHTML = `${LANG !== "en" ? `<p class="sum__wait">${esc(t("errIntro"))}</p>` : ""}<ul class="sum__err">${r.errors.map((e: string) => `<li>${esc(e)}</li>`).join("")}</ul>`; send.setAttribute("aria-disabled", "true"); return; }
      const p = r.priced;
      mini(`<strong>${usd(r.perPerson)}</strong><span class="sum__ml">${esc(t("pp"))}</span><span class="sum__mp">${esc(t("totalMini", { p: usd(p.total) }))}</span>`);
      price.innerHTML = `<dl class="sum__rows">
          <div><dt>${esc(t("park"))}</dt><dd>${usd(p.park)}</dd></div>
          <div><dt>${esc(t("vehicle"))}${r.people.vehicles > 1 ? esc(t("vehiclesN", { n: r.people.vehicles })) : ""}</dt><dd>${usd(p.transport)}</dd></div>
          <div><dt>${esc(t("acc"))}</dt><dd>${usd(p.accommodation)}</dd></div>
          <div><dt>${esc(t("meals"))}</dt><dd>${usd(p.meals)}</dd></div>
          ${p.extras ? `<div><dt>${esc(t("addonsRow"))}</dt><dd>${usd(p.extras)}</dd></div>` : ""}
          <div><dt>${esc(t("margin"))}</dt><dd>${usd(p.margin)}</dd></div>
        </dl>
        <div class="sum__hl"><span>${esc(t("ppH"))}</span><strong>${usd(r.perPerson)}</strong>
          <small>${esc(t("paying", { n: r.people.adults + r.people.children }))}${r.people.infants ? esc(t("infantsFree", { n: O.settings.childMinAge })) : ""}</small></div>
        <p class="sum__total"><span>${esc(t("totalGroup"))}</span><strong>${usd(p.total)}</strong></p>`;
      lastTotal = p.total;
      send.removeAttribute("aria-disabled");
      $("[data-pdf]").removeAttribute("aria-disabled");
    }, 250);
  }

  function init(o: Opt) {
    O = o;
    const s = O.settings;
    const min = addDays(new Date().toISOString().slice(0, 10), s.leadDays + 1);
    $("[data-date-note]").textContent = t("leadNote", { d: s.leadDays, date: nice(min) });
    const btn = $<HTMLButtonElement>("[data-date-btn]"), cal = $("[data-cal]");
    let view = min.slice(0, 7); // YYYY-MM shown in the calendar
    const monthName = (ym: string) => new Date(ym + "-01T00:00:00Z").toLocaleDateString(LOC, { month: "long", year: "numeric", timeZone: "UTC" });
    const shiftMonth = (ym: string, k: number) => { const d = new Date(ym + "-01T00:00:00Z"); d.setUTCMonth(d.getUTCMonth() + k); return d.toISOString().slice(0, 7); };
    const drawCal = () => {
      const first = new Date(view + "-01T00:00:00Z");
      const lead = (first.getUTCDay() + 6) % 7; // Monday first
      const days = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 0)).getUTCDate();
      const cells: string[] = Array.from({ length: lead }, () => "<span></span>");
      for (let dd = 1; dd <= days; dd++) {
        const iso = `${view}-${String(dd).padStart(2, "0")}`;
        const off = iso < min;
        cells.push(`<button type="button" data-day="${iso}" ${off ? "disabled" : ""} class="${iso === st.date ? "on" : ""}" aria-label="${nice(iso)}">${dd}</button>`);
      }
      cal.innerHTML = `<div class="cal__head"><button type="button" data-mon="-1" aria-label="${esc(t("prevMonth"))}" ${view <= min.slice(0, 7) ? "disabled" : ""}>‹</button><strong>${monthName(view)}</strong><button type="button" data-mon="1" aria-label="${esc(t("nextMonth"))}">›</button></div>
        <div class="cal__grid">${((I.t?.wd as string[]) ?? ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]).map((w) => `<em>${esc(w)}</em>`).join("")}${cells.join("")}</div>
        <p class="cal__note">${esc(t("earliest", { date: nice(min) }))}</p>`;
      cal.querySelectorAll<HTMLButtonElement>("[data-mon]").forEach((b) => b.addEventListener("click", (e) => { e.stopPropagation(); view = shiftMonth(view, Number(b.dataset.mon)); drawCal(); }));
      cal.querySelectorAll<HTMLButtonElement>("[data-day]").forEach((b) => b.addEventListener("click", () => {
        st.date = b.dataset.day!;
        $("[data-date-text]").textContent = new Date(st.date + "T00:00:00Z").toLocaleDateString(LOC, { weekday: "short", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
        btn.classList.add("is-set");
        closeCal(); update();
      }));
    };
    const openCal = () => { if (st.date) view = st.date.slice(0, 7); drawCal(); cal.hidden = false; btn.setAttribute("aria-expanded", "true"); cal.querySelector<HTMLButtonElement>("button.on, [data-day]:not([disabled])")?.focus(); };
    const closeCal = () => { cal.hidden = true; btn.setAttribute("aria-expanded", "false"); };
    btn.addEventListener("click", () => (cal.hidden ? openCal() : closeCal()));
    document.addEventListener("click", (e) => { if (!cal.hidden && !cal.contains(e.target as Node) && !btn.contains(e.target as Node)) closeCal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !cal.hidden) { closeCal(); btn.focus(); } });
    const n = $<HTMLSelectElement>("[data-nights]");
    st.nights = Math.min(Math.max(st.nights, s.minTotalNights), s.maxTotalNights);
    n.innerHTML = Array.from({ length: s.maxTotalNights - s.minTotalNights + 1 }, (_, i) => s.minTotalNights + i)
      .map((v) => `<option value="${v}" ${v === st.nights ? "selected" : ""}>${esc(t("nightsOpt", { v, d: v + 1 }))}</option>`).join("");
    n.addEventListener("change", () => {
      st.nights = Number(n.value);
      // trim stops from the end if the trip got shorter
      while (used() > safariNights() && st.stops.length) {
        const last = st.stops[st.stops.length - 1];
        const a = O.areas.find((x) => x.id === last.areaId)!;
        if (last.nights > a.minNights) last.nights--; else st.stops.pop();
      }
      renderWhere(); update();
    });
    $("[data-arrival-name]").textContent = O.arrivalName;
    root.querySelectorAll<HTMLElement>("[data-arrival-inc]").forEach((x) => (x.hidden = !O.arrivalPriced));
    root.querySelectorAll<HTMLButtonElement>("[data-inc],[data-dec]").forEach((b) => b.addEventListener("click", () => {
      const k = b.dataset.inc || b.dataset.dec;
      const up = !!b.dataset.inc;
      const total = st.adults + st.ages.length;
      if (up && total >= s.maxGuests) return flash(t("groupMax", { n: s.maxGuests }));
      if (k === "adults") st.adults = Math.max(1, st.adults + (up ? 1 : -1));
      else if (up) st.ages.push(8); else st.ages.pop();
      update();
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((b) => b.addEventListener("click", () => {
      const n = Number(b.dataset.open);
      if (n <= st.reached && st.open !== n) openStep(n, true);
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((b) => b.addEventListener("click", () => openStep(Number(b.dataset.next), true)));
    const box = $("[data-sum-box]"), tog = $("[data-sum-toggle]");
    if (O.addons?.length) {
      $("[data-addons]").hidden = false;
      const per = (a: NonNullable<Opt["addons"]>[number]) => a.per === "vehicle" ? t("perVehicle") : a.per === "booking" ? t("perGroup") : a.rateChild && a.rateChild !== a.rate ? t("childRate", { r: usd(a.rateChild) }) : t("ppShort");
      $("[data-addon-list]").innerHTML = O.addons.map((a) => { const blurb = a.blurb ? tx(I.addons, a.id, "blurb", a.blurb) : ""; return `<label class="addon" ${blurb ? `title="${esc(blurb)}"` : ""}><input type="checkbox" value="${esc(a.id)}" data-addon><span class="addon__t"><strong>${esc(tx(I.addons, a.id, "name", a.name))}</strong>${a.id === "crater" ? `<em class="addon__inc">${esc(t("craterInc"))}</em>` : ""}${blurb ? `<small>${esc(blurb)}</small>` : ""}</span><span class="addon__r">+${usd(a.rate)}<small>${esc(per(a))}</small></span></label>`; }).join("");
      root.querySelectorAll<HTMLInputElement>("[data-addon]").forEach((el) => el.addEventListener("change", () => {
        st.addons = [...root.querySelectorAll<HTMLInputElement>("[data-addon]:checked")].map((x) => x.value);
        update();
      }));
    }
    $("[data-send]").addEventListener("click", () => openContact("whatsapp"));
    $("[data-pdf]").addEventListener("click", () => openContact("pdf"));
    $("[data-contact-form]").addEventListener("submit", submitContact);
    $("[data-ct-close]").addEventListener("click", () => $<HTMLDialogElement>("[data-contact]").close());
    $<HTMLDialogElement>("[data-contact]").addEventListener("click", (e) => { if (e.target === e.currentTarget) (e.currentTarget as HTMLDialogElement).close(); });
    tog.addEventListener("click", () => { const o = !box.classList.contains("is-open"); box.classList.toggle("is-open", o); tog.setAttribute("aria-expanded", String(o)); });
    renderWhere(); update();
  }

  fetch("/api/planner/options").then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then(init).catch(() => {
    root.querySelector<HTMLElement>(".pl__grid")!.hidden = true;
    root.querySelector<HTMLElement>("[data-fallback]")!.hidden = false;
  });
</script>

<style is:global>
  .pl .pl__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; margin-top: 1.5rem; }
  .pl .pl__grid[hidden] { display: none; }
  .pl .pl__grid > * { min-width: 0; }
  .pl .step { border: 1px solid var(--line); border-radius: 16px; background: var(--surface); margin: 0 0 0.75rem; min-width: 0; overflow: hidden; }
  .pl .step:has(.cal:not([hidden])) { overflow: visible; position: relative; z-index: 5; }
  .pl .step__head { width: 100%; display: flex; align-items: center; gap: 0.6rem; padding: 0.95rem 1.2rem; border: 0; background: none; font: inherit; color: var(--ink); text-align: left; cursor: pointer; }
  .pl .step__head:disabled { cursor: default; }
  .pl .step.is-locked .step__head { opacity: 0.5; }
  .pl .step__t { font-family: var(--display); font-weight: 600; font-size: 1.08rem; white-space: nowrap; }
  .pl .step__sum { flex: 1; min-width: 0; color: var(--ink-2); font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: right; }
  .pl .step__edit { color: var(--rust); font-size: 0.85rem; font-weight: 600; text-decoration: underline; display: none; }
  .pl .step:not(.is-open):not(.is-locked) .step__sum:not(:empty) + .step__edit { display: inline; }
  .pl .step__body { display: none; padding: 0 1.2rem 1.2rem; }
  .pl .step.is-open .step__body { display: block; }
  .pl .step.is-open .step__head { padding-bottom: 0.6rem; }
  .pl .step__next { margin-top: 1rem; }
  .pl .step__next:disabled { opacity: 0.45; cursor: default; }
  .pl .step__n { flex: none; display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: var(--gold); color: var(--dark); font-size: 0.9rem; font-weight: 600; }
  .pl .row { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  .pl .count { display: flex; flex-direction: column; gap: 0.4rem; }
  .pl .count__l { font-weight: 600; font-size: 0.95rem; }
  .pl .count__l small { font-weight: 400; color: var(--ink-2); }
  .pl .count__c { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .pl .count__c button { width: 2.6rem; height: 2.6rem; border: 0; background: var(--tint); font-size: 1.2rem; cursor: pointer; color: var(--ink); }
  .pl .count__c button:hover { background: var(--gold); }
  .pl .count__c output { min-width: 3rem; text-align: center; font-weight: 600; padding: 0 0.4rem; }
  .pl .count__c.sm button { width: 2.1rem; height: 2.1rem; }
  .pl .count__c.sm output { min-width: 5.5rem; font-size: 0.92rem; }
  .pl .ages { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.9rem; }
  .pl .age, .pl .fld { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 600; font-size: 0.92rem; }
  .pl .ages select, .pl .fld input, .pl .fld select { font: inherit; font-weight: 400; padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: var(--ink); min-width: 12rem; }
  .pl .ages select { min-width: 7rem; }
  .pl .note { color: var(--ink-2); font-size: 0.92rem; margin: 0.7rem 0 0; }
  .pl .styles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .pl .style { display: flex; flex-direction: column; gap: 0.25rem; text-align: left; padding: 0.9rem 1rem; border: 2px solid var(--line); border-radius: 12px; background: #fff; cursor: pointer; font: inherit; color: var(--ink); }
  .pl .style strong { font-family: var(--display); font-size: 1.05rem; }
  .pl .style span { color: var(--ink-2); font-size: 0.88rem; }
