---
import Base from "../layouts/Base.astro";
import WaButton from "../components/WaButton.astro";
import { breadcrumbs } from "../lib/schema";
import { langOf, lp } from "../i18n";
import { w } from "../i18n/common";

const lang = langOf(Astro.url);
const L = (x: string) => lp(lang, x);
const T = {
  en: {
    title: "How It Works: Planning a Tanzania Safari With Us | Golden Dust Safaris",
    desc: "How planning a private Tanzania safari with Golden Dust Safaris works, from your first WhatsApp message to airport pick-up, your free first night and the drive out to the parks.",
    h1: "How planning your safari works",
    lede: "Every traveler is different, so every safari is built around your interests, budget and comfort level. Here's what happens, step by step.",
    beforeH: "Before you travel", arriveH: "When you arrive", key: "Most important", btn: "Start with a WhatsApp message",
    before: [
      ["Message us on WhatsApp", "Tell us your travel dates, group size, budget and what you'd love to see. No contact forms, no waiting for an email reply."],
      ["We get on a call", "We talk to understand why you want to travel and go on safari, and everything you're hoping for. Then we share our honest opinion on parks, seasons and where your money goes furthest.", "key"],
      ["Receive your custom safari plan", "A day-by-day itinerary based on your preferences, with a full cost breakdown so you can see exactly what you're paying for."],
      ["Compare freely", "Got a quote from another company? Send it over and we'll give you honest feedback on it."],
    ],
    arrival: [
      ["We meet you at the airport", "Our team waits at Kilimanjaro or Arusha airport with your name on a sign."],
      ["Your stay before the safari is on us", "We take care of your transfer and your night in Arusha before the safari."],
      ["Briefing with your guide", "Your guide walks you through the days ahead and answers your questions."],
      ["Your safari begins", "Your guide picks you up from your hotel in the morning."],
      ["Drop-off at the end", "After the safari we take you to the airport or your hotel."],
    ],
  },
  nl: {
    title: "Zo werkt het: een safari in Tanzania plannen met ons | Golden Dust Safaris",
    desc: "Zo plan je een privésafari in Tanzania met Golden Dust Safaris: van je eerste WhatsApp-bericht tot het ophalen op het vliegveld, je gratis eerste nacht en de rit naar de parken.",
    h1: "Zo plannen we je safari",
    lede: "Elke reiziger is anders, dus elke safari wordt gebouwd rond jouw interesses, budget en wensen voor comfort. Dit gebeurt er, stap voor stap.",
    beforeH: "Voor je reis", arriveH: "Als je aankomt", key: "Het belangrijkst", btn: "Begin met een WhatsApp-bericht",
    before: [
      ["Stuur ons een WhatsApp", "Vertel ons je reisdata, met hoeveel je bent, je budget en wat je graag wilt zien. Geen contactformulieren, geen wachten op een e-mail."],
      ["We bellen even", "We praten om te begrijpen waarom je wilt reizen en op safari wilt, en waar je op hoopt. Daarna geven we je ons eerlijke advies over parken, seizoenen en waar je het meeste voor je geld krijgt.", "key"],
      ["Ontvang je safariplan op maat", "Een dagprogramma op basis van jouw wensen, met een volledig overzicht van de kosten, zodat je precies ziet waarvoor je betaalt."],
      ["Vergelijk gerust", "Een offerte van een ander bedrijf gekregen? Stuur hem door, dan geven we je er eerlijk feedback op."],
    ],
    arrival: [
      ["We halen je op van het vliegveld", "Ons team staat op Kilimanjaro Airport of het vliegveld van Arusha te wachten met een bordje met je naam."],
      ["Je overnachting voor de safari is van ons", "We regelen je transfer en je nacht in Arusha voor de safari."],
      ["Kennismaking met je gids", "Je gids loopt de komende dagen met je door en beantwoordt je vragen."],
      ["Je safari begint", "Je gids haalt je 's ochtends op bij je hotel."],
      ["Terugbrengen aan het eind", "Na de safari brengen we je naar het vliegveld of je hotel."],
    ],
  },
  de: {
    title: "So funktioniert's: Ihre Tansania-Safari mit uns planen | Golden Dust Safaris",
    desc: "So planen Sie eine Privatsafari in Tansania mit Golden Dust Safaris: von der ersten WhatsApp-Nachricht über die Abholung am Flughafen und die kostenlose erste Nacht bis zur Fahrt in die Parks.",
    h1: "So planen wir Ihre Safari",
    lede: "Jeder Reisende ist anders, deshalb richten wir jede Safari nach Ihren Interessen, Ihrem Budget und Ihren Komfortwünschen aus. So läuft es ab, Schritt für Schritt.",
    beforeH: "Vor der Reise", arriveH: "Bei Ihrer Ankunft", key: "Am wichtigsten", btn: "Mit einer WhatsApp-Nachricht starten",
    before: [
      ["Schreiben Sie uns per WhatsApp", "Nennen Sie uns Ihre Reisedaten, die Gruppengröße, Ihr Budget und was Sie gern sehen möchten. Keine Kontaktformulare, kein Warten auf eine E-Mail."],
      ["Wir telefonieren", "Im Gespräch möchten wir verstehen, warum Sie reisen und auf Safari gehen möchten und was Sie sich erhoffen. Dann sagen wir Ihnen ehrlich unsere Meinung zu Parks, Reisezeiten und wo Ihr Geld am meisten bewirkt.", "key"],
      ["Ihr persönlicher Safariplan", "Ein Reiseverlauf Tag für Tag nach Ihren Wünschen, mit vollständiger Kostenaufstellung, damit Sie genau sehen, wofür Sie bezahlen."],
      ["Vergleichen Sie in Ruhe", "Sie haben ein Angebot eines anderen Anbieters? Schicken Sie es uns, und wir geben Ihnen ehrliches Feedback."],
    ],
    arrival: [
      ["Wir holen Sie am Flughafen ab", "Unser Team wartet am Kilimanjaro International Airport oder am Flughafen Arusha mit einem Schild mit Ihrem Namen."],
      ["Die Nacht vor der Safari übernehmen wir", "Wir kümmern uns um Ihren Transfer und Ihre Nacht in Arusha vor der Safari."],
      ["Besprechung mit Ihrem Guide", "Ihr Guide geht die nächsten Tage mit Ihnen durch und beantwortet Ihre Fragen."],
      ["Ihre Safari beginnt", "Ihr Guide holt Sie morgens in Ihrem Hotel ab."],
      ["Zum Schluss bringen wir Sie zurück", "Nach der Safari bringen wir Sie zum Flughafen oder zu Ihrem Hotel."],
    ],
  },
  fr: {
    title: "Comment ça marche : préparer un safari en Tanzanie avec nous | Golden Dust Safaris",
    desc: "Comment se prépare un safari privé en Tanzanie avec Golden Dust Safaris : du premier message WhatsApp à l'accueil à l'aéroport, votre première nuit offerte et la route vers les parcs.",
    h1: "Comment nous préparons votre safari",
    lede: "Chaque voyageur est différent, alors chaque safari est construit autour de vos envies, de votre budget et du confort que vous recherchez. Voici comment ça se passe, étape par étape.",
    beforeH: "Avant le voyage", arriveH: "À votre arrivée", key: "Le plus important", btn: "Commencer par un message WhatsApp",
    before: [
      ["Écrivez-nous sur WhatsApp", "Donnez-nous vos dates, le nombre de voyageurs, votre budget et ce que vous aimeriez voir. Pas de formulaire, pas d'attente d'un e-mail."],
      ["Nous nous appelons", "Nous discutons pour comprendre pourquoi vous voulez voyager et partir en safari, et tout ce que vous espérez. Puis nous vous donnons un avis honnête sur les parcs, les saisons et la meilleure façon d'utiliser votre budget.", "key"],
      ["Recevez votre programme sur mesure", "Un itinéraire jour par jour selon vos préférences, avec le détail complet des coûts pour voir exactement ce que vous payez."],
      ["Comparez librement", "Vous avez reçu un devis d'une autre agence ? Envoyez-le-nous, nous vous donnerons un avis sincère."],
    ],
    arrival: [
      ["Nous vous accueillons à l'aéroport", "Notre équipe vous attend à l'aéroport du Kilimandjaro ou d'Arusha avec une pancarte à votre nom."],
      ["La nuit avant le safari est offerte", "Nous nous occupons de votre transfert et de votre nuit à Arusha avant le safari."],
      ["Briefing avec votre guide", "Votre guide vous présente les jours à venir et répond à vos questions."],
      ["Le safari commence", "Votre guide vient vous chercher à votre hôtel le matin."],
      ["Retour à la fin", "Après le safari, nous vous conduisons à l'aéroport ou à votre hôtel."],
    ],
  },
}[lang];
---
<Base title={T.title} description={T.desc} schema={[breadcrumbs([[w(lang, "home"), L("/")], [w(lang, "how"), L("/how-it-works")]])]}>
  <section class="section">
    <div class="wrap">
      <h1>{T.h1}</h1>
      <p class="lede">{T.lede}</p>
      <div class="cols">
        <div>
          <h2>{T.beforeH}</h2>
          <ol class="steps">{T.before.map(([h, p, k]) => <li class={k ? "key" : undefined}>{k && <span class="key__tag">{T.key}</span>}<h3>{h}</h3><p>{p}</p></li>)}</ol>
        </div>
        <div>
          <h2>{T.arriveH}</h2>
          <ol class="steps">{T.arrival.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}</ol>
        </div>
      </div>
      <WaButton label={T.btn} />
    </div>
  </section>
</Base>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin: 2.5rem 0; }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 1.5rem 0 0; }
  .steps li { counter-increment: s; position: relative; padding: 0 0 1.4rem 3.2rem; }
  .steps li::before {
    content: counter(s); position: absolute; left: 0; top: -0.15rem; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--btn); color: var(--btn-text); font-family: var(--display); font-weight: 600;
  }
  .steps li:not(:last-child)::after { content: ""; position: absolute; left: 1.03rem; top: 2.2rem; bottom: 0.2rem; border-left: 2px dashed var(--gold); }
  .steps li.key { background: var(--surface); border: 1px solid var(--gold); border-radius: 14px; padding: 0.9rem 1rem 1rem 3.6rem; margin: 0 0 1.4rem -0.4rem; }
  .steps li.key::before { left: 0.6rem; top: 0.85rem; }
  .steps li.key::after { left: 1.63rem; top: 3.1rem; bottom: -1.2rem; }
  .key__tag { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 0.15rem; }
  .steps h3 { margin-bottom: 0.25rem; font-size: 1.08rem; }
  .steps p { color: var(--ink-2); margin: 0; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
