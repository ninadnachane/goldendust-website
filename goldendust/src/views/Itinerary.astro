---
// Printable itinerary, 2–3 A4 pages (save as PDF from the browser).
//   /itinerary#lead=12      admin, from the Leads tab (needs to be signed in)
//   /itinerary#ref=GD-1001&k=<token>   guest, private link created when they leave their name and mobile number
import { site } from "../lib/site";
import { langOf, lp, LOCALE } from "../i18n";
import { ITIN_TEXT, DOC_TEXT, AREA_TEXT, CATEGORY_TEXT, ADDON_TEXT } from "../i18n/planner";
const lang = langOf(Astro.url);
const X = ITIN_TEXT[lang] as Record<string, any>;
const i18n = JSON.stringify({ lang, locale: LOCALE[lang], t: X, doc: lang === "en" ? {} : DOC_TEXT, areas: AREA_TEXT, cats: CATEGORY_TEXT, addons: ADDON_TEXT });
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{X.title} | Golden Dust Safaris</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body data-phone={site.phoneDisplay} data-i18n={i18n}>
  <div class="bar no-print">
    <a href={lp(lang, "/planner")} class="bar__back" data-back>{X.back}</a>
    <span class="bar__tip" data-tip>{X.tip}</span>
    <button type="button" class="bar__btn" data-print disabled>{X.save}</button>
  </div>
  <main class="doc" data-doc><p class="loading">{X.loading}</p></main>

  <script>
    import { tripCategory, tripCategories, imageUrl } from "../planner/engine";
    type L = { name: string; description: string; images: string[] };
    type Opt = {
      categories: { id: string; name: string }[];
      arrivalName: string;
      arrivalLodges: Record<string, L | null>;
      areas: { id: string; name: string; blurb: string }[];
      lodges: (L & { id: string; areaId: string; category: string })[];
      doc: { included: string[]; excluded: string[]; payment: string; notes: string[] } | null;
      addons?: { id: string; name: string; blurb: string }[];
    };
    type Trip = { startDate: string; adults: number; childAges: number[]; category?: string; totalNights: number; stops: { areaId: string; nights: number; lodgeId: string }[]; crater?: boolean; addons?: string[] };
    type Priced = { park: number; transport: number; accommodation: number; meals: number; extras?: number; margin: number; total: number };

    const docEl = document.querySelector<HTMLElement>("[data-doc]")!;
    const phone = document.body.dataset.phone || "";
    const esc = (s: unknown) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const I = JSON.parse(document.body.dataset.i18n || "{}");
    const LANG: string = I.lang || "en", LOC: string = I.locale || "en-GB";
    const PR = new Intl.PluralRules(LOC);
    const fill = (s: string, v: Record<string, unknown> = {}) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));
    const tr = (k: string, v: Record<string, unknown> = {}) => { const x = I.t?.[k]; const s = Array.isArray(x) ? x[PR.select(Number(v.n ?? 0)) === "one" ? 0 : 1] : x; return fill(String(s ?? k), v); };
    const tx = (m: any, id: string, kind: "name" | "blurb", en: string) => { const e = m?.[id]?.[kind]; return e && e.en === en ? (e[LANG] ?? en) : en; };
    const dtx = (en: string) => I.doc?.[en]?.[LANG] ?? en;
    const usd = (n: number) => Math.round(n).toLocaleString(LANG === "en" ? "en-US" : LOC);
    const addDays = (iso: string, d: number) => { const x = new Date(iso + "T00:00:00Z"); x.setUTCDate(x.getUTCDate() + d); return x.toISOString().slice(0, 10); };
    const fmt = (iso: string, o: Intl.DateTimeFormatOptions) => new Date(iso + "T00:00:00Z").toLocaleDateString(LOC, { ...o, timeZone: "UTC" });
    const short = (iso: string) => fmt(iso, { weekday: "short", day: "numeric", month: "short" });
    const long = (iso: string) => fmt(iso, { day: "numeric", month: "long", year: "numeric" });

    function render(o: Opt, t: Trip, priced: Priced | null, perPerson: number, guest: { name?: string; ref?: string }) {
      const picked = new Set([...(t.addons || []), ...(t.crater ? ["crater"] : [])]);
      const crater = picked.has("crater") && (o.addons || []).some((a) => a.id === "crater");
      const extras = (o.addons || []).filter((a) => a.id !== "crater" && picked.has(a.id));
      const cats = tripCategories(o.lodges as any, t.stops);
      const catN = (c: string) => tx(I.cats, c, "name", o.categories.find((x) => x.id === c)?.name ?? c);
      const cat = cats.length ? cats.map(catN).join(" + ") : (t.category ? catN(t.category) : "");
      const end = addDays(t.startDate, t.totalNights);
      const areaName = (id: string) => { const a = o.areas.find((x) => x.id === id); return a ? tx(I.areas, a.id, "name", a.name) : id; };
      const guestsTxt = `${tr("adults", { n: t.adults })}${t.childAges.length ? ` + ${tr("children", { n: t.childAges.length })}` : ""}`;
      const arrival = o.arrivalLodges[tripCategory(o.lodges as any, t.stops)] ?? o.arrivalLodges[t.category ?? "comfort"];
      const routeNames = [...new Set([...t.stops.map((s) => LANG === "en" ? areaName(s.areaId).replace(/^(North|Central|South) /, "").replace(/ \(.*\)$/, "") : areaName(s.areaId).replace(/ \(.*\)$/, "")), ...(crater ? ["Ngorongoro"] : [])])];
      const dd = (iso: string) => fmt(iso, { day: "2-digit" });
      const mon = (iso: string) => fmt(iso, { month: "short" });
      const wd = (iso: string) => fmt(iso, { weekday: "short" });

      // ---- page 1: cover
      const stopsLine = [`<li><span class="rt__dot"></span><b>${esc(o.arrivalName)}</b><small>${esc(tr("arrival"))}</small></li>`,
        ...t.stops.map((s) => `<li><span class="rt__dot"></span><b>${esc(areaName(s.areaId))}</b><small>${esc(tr("nights", { n: s.nights }))}</small></li>`),
        ...(crater ? [`<li><span class="rt__dot"></span><b>${esc(tr("crater"))}</b><small>${esc(tr("gameDrive"))}</small></li>`] : []),
        `<li><span class="rt__dot rt__dot--end"></span><b>${esc(o.arrivalName)}</b><small>${esc(tr("departure"))}</small></li>`].join("");
      const cover = `<div class="sheet sheet--cover">
          <img class="cv__img" src="/images/gallery/zebras-walking-grassland.webp" alt="${esc(tr("coverAlt"))}">
          <div class="cvb">
            <div class="cvh">
              <div><p class="eyebrow">${guest.name ? esc(tr("preparedFor", { n: guest.name })) : esc(tr("yourPrivate"))}</p>
                <h1>${esc(tr("title"))}</h1>
                <p class="cv__route">${routeNames.map(esc).join("<i>·</i>")}</p></div>
              <img src="/images/logo-header.webp" alt="Golden Dust Safaris" class="cv__logo">
            </div>
            <div class="facts">
              <div><span class="eyebrow">${esc(tr("dates"))}</span><strong>${fmt(t.startDate, { day: "numeric", month: "short" })} – ${fmt(end, { day: "numeric", month: "short", year: "numeric" })}</strong></div>
              <div><span class="eyebrow">${esc(tr("duration"))}</span><strong>${esc(tr("durV", { d: t.totalNights + 1, n: t.totalNights }))}</strong></div>
              <div><span class="eyebrow">${esc(tr("travellers"))}</span><strong>${esc(guestsTxt)}</strong></div>
              <div><span class="eyebrow">${esc(tr("style"))}</span><strong>${esc(cat)}</strong></div>
            </div>
            <p class="eyebrow sec">${esc(tr("route"))}</p>
            <ol class="rt">${stopsLine}</ol>
            <div class="cvf"><span>${guest.ref ? `${esc(tr("ref", { r: guest.ref }))} · ` : ""}${esc(tr("issued", { d: long(new Date().toISOString().slice(0, 10)) }))}</span><span>goldendustsafaris.com</span></div>
          </div>
        </div>`;

      // ---- page 2: day by day (compact) + where you'll stay
      const date = (from: string, to?: string) => `<div class="dt"><span class="dt__d">${dd(from)}${to ? `<i>–</i>${dd(to)}` : ""}</span><span class="dt__m">${to && mon(from) !== mon(to) ? `${mon(from)}–${mon(to)}` : mon(from)}</span></div>`;
      const stay = (name?: string) => name ? `<div class="st__stay"><span>${esc(tr("overnight"))}</span><b>${esc(name)}</b></div>` : `<div></div>`;
      const rows: string[] = [];
      rows.push(`<section class="st">${date(t.startDate)}<div class="st__body"><p class="eyebrow">${esc(tr("day1"))}</p><h3>${esc(o.arrivalName)}</h3><p><b>${esc(tr("firstNight"))}</b> ${esc(tr("welcome"))}</p></div>${stay(arrival?.name ?? o.arrivalName)}</section>`);
      let d = 1;
      for (const s of t.stops) {
        const a = o.areas.find((x) => x.id === s.areaId);
        const l = o.lodges.find((x) => x.id === s.lodgeId);
        const from = addDays(t.startDate, d), to = s.nights > 1 ? addDays(t.startDate, d + s.nights - 1) : undefined;
        const label = s.nights > 1 ? tr("daysRange", { a: d + 1, b: d + s.nights }) : tr("dayN", { a: d + 1 });
        const blurb = a?.blurb ? tx(I.areas, a.id, "blurb", a.blurb) : tr("gameDrivesIn", { a: areaName(s.areaId) });
        rows.push(`<section class="st">${date(from, to)}<div class="st__body"><p class="eyebrow">${esc(label)} · ${esc(tr("nights", { n: s.nights }))}</p><h3>${esc(areaName(s.areaId))}</h3>
            <p>${esc(blurb)}</p></div>${stay(l?.name)}</section>`);
        d += s.nights;
      }
      rows.push(`<section class="st">${date(end)}<div class="st__body"><p class="eyebrow">${esc(tr("depDay", { d: t.totalNights + 1 }))}</p><h3>${esc(crater ? tr("craterThen", { a: o.arrivalName }) : tr("backTo", { a: o.arrivalName }))}</h3><p>${esc(crater ? tr("craterP") : tr("backP"))}</p></div><div></div></section>`);
      if (extras.length) rows.push(`<section class="st"><div class="dt"><span class="dt__d">+</span><span class="dt__m">${esc(tr("extras"))}</span></div><div class="st__body"><p class="eyebrow">${esc(tr("addonsEyebrow"))}</p><h3>${extras.map((a) => esc(tx(I.addons, a.id, "name", a.name))).join(" · ")}</h3><p>${extras.map((a) => (a.blurb ? esc(tx(I.addons, a.id, "blurb", a.blurb)) : "")).filter(Boolean).join(" ")} ${esc(tr(extras.length > 1 ? "fitMany" : "fitOne"))}</p></div><div></div></section>`);

      const seen = new Set<string>();
      const stays: { l: L; area: string; nights: number }[] = [];
      for (const s of t.stops) {
        const l = o.lodges.find((x) => x.id === s.lodgeId);
        if (!l) continue;
        const prev = stays.find((x) => x.l.name === l.name);
        if (prev) { prev.nights += s.nights; continue; }
        if (!seen.has(l.name)) { seen.add(l.name); stays.push({ l, area: areaName(s.areaId), nights: s.nights }); }
      }
      const withPics = stays.filter((x) => x.l.images.length);
      const n = withPics.length;
      // layout chosen so the photos fill the space above Investment on page 3
      const lay = n <= 1 ? { cols: 1, per: 3, h: 66 } : n === 2 ? { cols: 1, per: 3, h: 42 } : n <= 4 ? { cols: 2, per: 2, h: 36 } : n <= 6 ? { cols: 3, per: 1, h: 34 } : { cols: 3, per: 1, h: 22 };
      const staysHtml = n ? `<section class="ws-sec"><header class="ph-h ph-h--sub"><p class="eyebrow">${esc(tr("campsLodges"))}</p><h2>${esc(tr("whereStay"))}</h2></header>
          <div class="ws" style="grid-template-columns: repeat(${lay.cols}, 1fr); --ph: ${lay.h}mm">${withPics.map((x) => `<figure class="lc">
            <div class="lc__imgs n${Math.min(lay.per, x.l.images.length)}">${x.l.images.slice(0, lay.per).map((im) => `<img src="${esc(imageUrl(im))}" alt="">`).join("")}</div>
            <figcaption><b>${esc(x.l.name)}</b><span>${esc(x.area)} · ${esc(tr("nights", { n: x.nights }))}</span>${x.l.description && lay.cols < 3 ? `<p>${esc(x.l.description)}</p>` : ""}</figcaption>
          </figure>`).join("")}</div></section>` : "";

      // ---- page 2: journey + what's included
      const doc = o.doc ?? { included: [], excluded: [], payment: "", notes: [] };
      const days = `<div class="sheet${t.stops.length > 4 ? " compact" : ""}"><header class="ph-h"><p class="eyebrow">${esc(tr("dayByDay"))}</p><h2>${esc(tr("journey"))}</h2></header><div class="jr">${rows.join("")}</div>
          <div class="ie">
            <div><p class="eyebrow sec">${esc(tr("included"))}</p><ul class="ok">${doc.included.map((x) => `<li>${esc(dtx(x))}</li>`).join("")}</ul></div>
            <div><p class="eyebrow sec">${esc(tr("notIncluded"))}</p><ul class="no">${doc.excluded.map((x) => `<li>${esc(dtx(x))}</li>`).join("")}</ul></div>
          </div>
          ${doc.notes.length ? `<div class="nt">${doc.notes.map((x) => `<p>${esc(dtx(x))}</p>`).join("")}</div>` : ""}
        </div>`;

      // ---- page 3: where you'll stay + investment
      const lines: [string, number][] = priced ? [[tr("park"), priced.park], [tr("vehicle"), priced.transport], [tr("acc"), priced.accommodation], [tr("meals"), priced.meals], ...(priced.extras ? [[tr("addonsRow"), priced.extras] as [string, number]] : []), [tr("margin"), priced.margin]] : [];
      const details = `<div class="sheet">
          ${staysHtml}
          <header class="ph-h ${n ? "ph-h--sub inv-h" : ""}"><p class="eyebrow">${esc(tr("theDetails"))}</p><h2>${esc(tr("investment"))}</h2></header>
          ${priced ? `<table class="price">
              ${lines.map(([k, v]) => `<tr><td>${esc(k)}</td><td>$${usd(v)}</td></tr>`).join("")}
              <tr class="price__tot"><td>${esc(tr("totalGroup"))}</td><td>$${usd(priced.total)}</td></tr>
              <tr class="price__pp"><td></td><td>${esc(tr("aboutPP", { p: "$" + usd(perPerson) }))}</td></tr>
            </table>` : `<p>${esc(tr("confirm"))}</p>`}
          ${doc.payment ? `<p class="pay">${esc(dtx(doc.payment))}</p>` : ""}
          <div class="cta"><div><p class="eyebrow eyebrow--light">${esc(tr("ready"))}</p><p class="cta__h">${esc(tr("replyWa"))}</p></div>
            <div class="cta__c"><strong>${esc(phone)}</strong><span>goldendustsafaris.com</span></div></div>
          <p class="legal">Golden Dust Safaris · ${esc(tr("legal"))}${guest.ref ? ` · ${esc(tr("ref", { r: guest.ref }))}` : ""}</p>
        </div>`;

      docEl.innerHTML = cover + days + details;
      document.title = `${guest.name ? guest.name + " – " : ""}${tr("docTitle")} ${t.startDate}${guest.ref ? " " + guest.ref : ""} | Golden Dust Safaris`;
      const btn = document.querySelector<HTMLButtonElement>("[data-print]")!;
      btn.disabled = false;
      btn.addEventListener("click", async () => {
        btn.disabled = true; btn.textContent = tr("preparingBtn");
        await Promise.all([...docEl.querySelectorAll("img")].map((im) => (im.complete ? null : new Promise((r) => { im.onload = im.onerror = r; }))));
        btn.disabled = false; btn.textContent = tr("save");
        window.print();
      });
    }

    function fail(msg: string) { docEl.innerHTML = `<p class="loading">${esc(msg)}</p>`; }

    async function start() {
      const h = new URLSearchParams(location.hash.slice(1));
      if (h.get("lead")) {
        document.querySelector<HTMLAnchorElement>("[data-back]")!.href = "/admin";
        const r = await fetch(`/api/admin/leads/${encodeURIComponent(h.get("lead")!)}/doc`);
        if (r.status === 401) return fail(tr("errSignIn"));
        if (!r.ok) return fail(tr("errLead"));
        const d = await r.json();
        return render(d.options, d.trip, d.ok ? d.priced : null, d.perPerson, { name: d.guest.name, ref: d.guest.ref });
      }
      const ref = h.get("ref"), k = h.get("k");
      if (!ref || !k) return fail(tr("errBuild"));
      const r = await fetch(`/api/planner/itinerary?ref=${encodeURIComponent(ref)}&k=${encodeURIComponent(k)}`);
      if (!r.ok) return fail(tr("errInvalid"));
      const d = await r.json();
      render(d.options, d.trip, d.ok ? d.priced : null, d.perPerson, { name: d.guest.name, ref: d.guest.ref });
    }
    start().catch(() => fail(tr("errWrong")));
    if (/iPhone|iPad|Android/.test(navigator.userAgent)) document.querySelector("[data-tip]")!.textContent = tr("tipMobile");
  </script>

  <style is:global>
    :root { --gold: #c89a4b; --gold-d: #a87c33; --sand: #f6f1e8; --sand-2: #efe7da; --dark: #231b14; --ink: #2b2118; --ink-2: #6f6254; --line: #e8dfd1; }
    * { box-sizing: border-box; }
    html { font-size: 11px; }
    body { margin: 0; background: #d8d3cb; font-family: Montserrat, system-ui, sans-serif; color: var(--ink); line-height: 1.5; }
    .bar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 1rem; padding: 0.9rem 1.2rem; background: var(--dark); color: #f4ede0; font-size: 1.2rem; }
    .bar__back { color: #f4ede0; text-decoration: none; font-weight: 600; }
    .bar__tip { margin-right: auto; opacity: 0.8; font-size: 1.1rem; }
    .bar__btn { font: inherit; font-weight: 600; border: 0; border-radius: 999px; padding: 0.7rem 1.4rem; background: var(--gold); color: var(--dark); cursor: pointer; }
    .bar__btn:disabled { opacity: 0.5; }
    .loading { color: var(--ink-2); text-align: center; padding: 6rem 0; font-size: 1.3rem; }
    .doc { padding: 1.5rem 0; }
    .sheet { width: 210mm; min-height: 297mm; margin: 0 auto 1.5rem; padding: 16mm 16mm 14mm; background: #fff; box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.4); position: relative; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
    .eyebrow { display: block; margin: 0; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-d); }
    .eyebrow--light { color: #e9cf9c; }
    .sec { margin: 7mm 0 3mm; }
    h1, h2, h3 { margin: 0; font-weight: 600; letter-spacing: -0.01em; }

    /* cover */
    .sheet--cover { padding: 0; display: flex; flex-direction: column; height: 297mm; }
    .cv__img { width: 100%; height: 168mm; object-fit: cover; display: block; flex: none; }
    .cvh { display: flex; justify-content: space-between; align-items: flex-start; gap: 8mm; margin-bottom: 7mm; }
    .cvh h1 { font-size: 3.4rem; line-height: 1.05; margin: 2mm 0 2.5mm; }
    .cv__route { margin: 0; font-size: 1.25rem; font-weight: 500; color: var(--ink-2); }
    .cv__route i { font-style: normal; color: var(--gold); margin: 0 2.2mm; }
    .cv__logo { height: 21mm; width: auto; flex: none; }
    .cvb { flex: 1; display: flex; flex-direction: column; padding: 9mm 16mm 9mm; min-height: 0; }
    .facts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .facts > div { padding: 4mm 3mm 4mm 0; display: grid; gap: 1.2mm; }
    .facts > div + div { padding-left: 4mm; border-left: 1px solid var(--line); }
    .facts strong { font-size: 1.15rem; font-weight: 600; }
    .rt { list-style: none; margin: 0; padding: 0; display: flex; position: relative; }
    .rt::before { content: ""; position: absolute; left: 1.6mm; right: 1.6mm; top: 1.6mm; border-top: 1.5px dashed var(--gold); }
    .rt li { flex: 1; display: grid; gap: 0.6mm; position: relative; padding-right: 2mm; }
    .rt li:last-child { flex: 0 0 auto; text-align: right; padding-right: 0; }
    .rt li:last-child .rt__dot { margin-left: auto; }
    .rt__dot { width: 3.2mm; height: 3.2mm; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 1.2mm #fff; margin-bottom: 1.5mm; }
    .rt__dot--end { background: var(--dark); }
    .rt b { font-size: 1.02rem; font-weight: 600; line-height: 1.25; }
    .rt small { color: var(--ink-2); font-size: 0.9rem; }
    .cvf { display: flex; justify-content: space-between; margin-top: auto; color: var(--ink-2); font-size: 0.88rem; }

    /* page headers */
    .ph-h { margin-bottom: 5mm; display: grid; gap: 1.2mm; }
    .ph-h h2 { font-size: 2.3rem; }

    /* day by day: compact rows, overnight on the right */
    .jr { border-bottom: 1px solid var(--line); }
    .st { display: grid; grid-template-columns: 17mm 1fr 58mm; gap: 5mm; padding: 2.6mm 0; border-top: 1px solid var(--line); break-inside: avoid; page-break-inside: avoid; align-items: start; }
    .dt { display: grid; line-height: 1.1; }
    .dt__d { font-size: 1.6rem; font-weight: 600; white-space: nowrap; }
    .dt__d i { font-style: normal; color: var(--gold); font-weight: 400; margin: 0 0.3mm; }
    .dt__m { font-size: 0.82rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--gold-d); margin-top: 0.6mm; }
    .st__body { display: grid; gap: 0.6mm; }
    .st__body h3 { font-size: 1.25rem; }
    .st__body p { margin: 0; }
    .st__body p:not(.eyebrow) { color: var(--ink-2); font-size: 0.98rem; }
    .st__stay { display: grid; gap: 0.6mm; padding-left: 4mm; border-left: 2px solid var(--gold); margin-top: 3.4mm; }
    .st__stay span { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); font-weight: 600; }
    .st__stay b { font-weight: 600; font-size: 1.02rem; line-height: 1.3; }
    .compact .st { padding: 1.7mm 0; }
    .compact .st__body p:not(.eyebrow) { font-size: 0.9rem; }
    .compact .st__stay { margin-top: 2.4mm; }
    .compact .ie li { font-size: 0.9rem; }
    .compact .ie ul { gap: 1mm; }
    .compact .sec { margin: 5mm 0 2mm; }
    .compact .nt { margin-top: 4mm; font-size: 0.85rem; }
    /* where you'll stay */
    .ws-sec { margin: 0 0 7mm; }
    .inv-h { margin-top: 0; }
    .ph-h--sub { break-after: avoid; page-break-after: avoid; }
    .ph-h--sub h2 { font-size: 1.8rem; }
    .ws { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm 6mm; }
    .lc { margin: 0; break-inside: avoid; }
    .lc__imgs { display: grid; gap: 1.5mm; border-radius: 3mm; overflow: hidden; }
    .lc__imgs.n2 { grid-template-columns: 1.4fr 1fr; }
    .lc__imgs.n3 { grid-template-columns: 2fr 1fr 1fr; }
    .lc__imgs img { width: 100%; height: var(--ph, 40mm); object-fit: cover; display: block; }
    .lc figcaption { display: grid; gap: 0.4mm; margin-top: 2mm; }
    .lc figcaption b { font-weight: 600; font-size: 1.05rem; }
    .lc figcaption span { color: var(--gold-d); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em; }
    .lc figcaption p { margin: 0.6mm 0 0; color: var(--ink-2); font-size: 0.92rem; }
    /* details */
    .price { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid var(--line); border-radius: 4mm; font-size: 1.1rem; }
    .price td { padding: 1.7mm 6mm; }
    .price tr:first-child td { padding-top: 3.5mm; }
    .price td:last-child { text-align: right; font-variant-numeric: tabular-nums; }
    .price__tot td { border-top: 2px solid var(--ink); padding-top: 3.5mm !important; font-weight: 700; font-size: 1.55rem; }
    .price__pp td { color: var(--ink-2); font-size: 1rem; padding-top: 0 !important; padding-bottom: 3.5mm; }
    .pay { color: var(--ink-2); font-size: 0.92rem; margin: 2.5mm 0 0; }
    .ie { display: grid; grid-template-columns: 1fr 1fr; gap: 9mm; margin-top: 2mm; }
    .ie ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6mm; }
    .ie li { position: relative; padding-left: 5.5mm; font-size: 0.98rem; }
    .ok li::before { content: ""; position: absolute; left: 0.5mm; top: 0.9mm; width: 1.4mm; height: 2.6mm; border: solid var(--gold-d); border-width: 0 0.5mm 0.5mm 0; transform: rotate(45deg); }
    .no li { color: var(--ink-2); }
    .no li::before { content: ""; position: absolute; left: 0; top: 2.3mm; width: 2.6mm; border-top: 0.5mm solid #c4b6a3; }
    .nt { margin-top: 6mm; padding: 4mm 5mm; background: var(--sand); border-radius: 3mm; color: var(--ink-2); font-size: 0.92rem; }
    .nt p { margin: 0 0 1.5mm; } .nt p:last-child { margin: 0; }
    .cta { margin-top: 5mm; display: flex; justify-content: space-between; align-items: center; gap: 6mm; background: var(--dark); color: #fff; border-radius: 4mm; padding: 4mm 6mm; break-inside: avoid; }
    .cta__h { margin: 0.6mm 0 0; font-size: 1.15rem; font-weight: 600; max-width: 95mm; }
    .cta__c { text-align: right; display: grid; gap: 0.5mm; }
    .cta__c strong { font-size: 1.4rem; color: var(--gold); }
    .cta__c span { opacity: 0.8; }
    .legal { position: absolute; left: 16mm; right: 16mm; bottom: 9mm; margin: 0; text-align: center; color: var(--ink-2); font-size: 0.82rem; }

    @media screen and (max-width: 820px) {
      html { font-size: 10px; }
      .doc { padding: 0; }
      .sheet { width: 100%; min-height: 0; margin: 0 0 6px; padding: 7vw 5vw 14vw; box-shadow: none; }
      .sheet--cover { padding: 0; height: auto; }
      .cv__img { height: 70vw; }
      .cvh h1 { font-size: 2.6rem; }
      .cv__logo { height: 14vw; }
      .cvb { padding: 6vw 5vw 8vw; }
      .facts { grid-template-columns: 1fr 1fr; }
      .facts > div:nth-child(3) { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); }
      .facts > div:nth-child(4) { border-top: 1px solid var(--line); }
      .rt { flex-direction: column; gap: 3vw; }
      .rt::before { left: 1.6mm; right: auto; top: 1.6mm; bottom: 1.6mm; border-top: 0; border-left: 1.5px dashed var(--gold); }
      .rt li, .rt li:last-child { display: grid; grid-template-columns: 6mm auto 1fr; align-items: baseline; gap: 2vw; text-align: left; }
      .rt li:last-child .rt__dot { margin-left: 0; }
          .st { grid-template-columns: 15mm 1fr; }
      .st__stay { grid-column: 2; margin-top: 1vw; }
      .ws { grid-template-columns: 1fr !important; --ph: 46vw !important; }
      .ie { grid-template-columns: 1fr; gap: 5vw; }
      .cta { flex-direction: column; align-items: flex-start; }
      .cta__c { text-align: left; }
      .legal { position: static; margin-top: 6vw; }
      .bar__tip { display: none; }
      .bar__back { margin-right: auto; }
    }
    @page { size: A4; margin: 0; }
    @media print {
      html, body { background: #fff; }
      .no-print { display: none !important; }
      .doc { padding: 0; }
      .sheet { margin: 0; box-shadow: none; width: 210mm; min-height: 296.5mm; break-after: page; page-break-after: always; }
      .sheet:last-child { break-after: auto; page-break-after: auto; }
      .sheet--cover { height: 296.5mm; min-height: 0; overflow: hidden; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</body>
