---
import Base from "../../layouts/Base.astro";
import TourRow from "../../components/TourRow.astro";
import LodgeCard from "../../components/LodgeCard.astro";
import GuideAside from "../../components/GuideAside.astro";
import Faq from "../../components/Faq.astro";
import { parks, parkUrl, type Park } from "../../data/parks";
import { lodgesIn } from "../../data/lodges";
import { tours } from "../../data/tours";
import { breadcrumbs, faqSchema } from "../../lib/schema";
import { site } from "../../lib/site";

export function getStaticPaths() {
  return parks.map((p) => ({ params: { slug: p.slug }, props: { park: p } }));
}
const { park: p } = Astro.props as { park: Park };
const url = parkUrl(p);
const withPhotos = lodgesIn(...p.areas).filter((l) => l.photos.length);
const campsites = lodgesIn(...p.areas).filter((l) => !l.photos.length && l.tier === "Budget");
const related = tours.filter((t) => t.route.some((r) => p.tourRoute.includes(r))).slice(0, 3);
const others = parks.filter((x) => x.slug !== p.slug);
const place = {
  "@context": "https://schema.org", "@type": "TouristAttraction", name: p.name, description: p.description,
  url: site.url + url, image: site.url + p.hero, address: { "@type": "PostalAddress", addressCountry: "TZ" },
};
const schema: object[] = [place, breadcrumbs([["Home", "/"], ["Parks", "/parks"], [p.name, url]])];
if (p.faqs.length) schema.push(faqSchema(p.faqs));
---
<Base title={`${p.seoTitle} | Golden Dust Safaris`} description={p.description} schema={schema}>
  <article class="section">
    <div class="wrap">
      <nav class="gp__crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/parks">Parks</a></nav>
      <h1>{p.h1}</h1>
      <p class="lede measure">{p.lede}</p>
      <img class="gp__hero" src={p.hero} alt={p.heroAlt} width="1200" height="600" />
      <div class="gp__body">
        <div class="prose">
          {p.sections.map((s) => (<><h2>{s.h}</h2>{s.p.map((t) => <p set:html={t} />)}</>))}
          {campsites.length > 0 && <p>Budget option: {campsites.map((c) => c.name).join(", ")}.</p>}
        </div>
        <GuideAside facts={p.facts} />
      </div>
    </div>
  </article>

  {withPhotos.length > 0 && (
    <section class="section section--white">
      <div class="wrap">
        <h2>Camps and lodges in {p.name}</h2>
        <div class="gp__grid">{withPhotos.map((l) => <LodgeCard lodge={l} />)}</div>
        <p style="margin-top:1.5rem"><a href="/lodges">All the lodges and camps we work with</a></p>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Sample safaris that include {p.name}</h2>
        <div class="gp__grid">{related.map((t) => <TourRow tour={t} />)}</div>
        <p style="margin-top:1.5rem"><a href="/tanzania-safari-packages">See all sample safaris</a> or <a href="/planner">plan your own</a>.</p>
      </div>
    </section>
  )}

  {p.faqs.length > 0 && <section class="section"><div class="wrap measure"><Faq items={p.faqs} /></div></section>}

  <section class="section section--white">
    <div class="wrap">
      <h2>Other parks</h2>
      <ul class="others">{others.map((o) => <li><a href={parkUrl(o)}>{o.name}</a></li>)}<li><a href="/great-migration-serengeti">The Great Migration, month by month</a></li></ul>
    </div>
  </section>
</Base>
<style>
  .others { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; }
</style>
