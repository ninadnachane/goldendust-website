---
import Base from "../layouts/Base.astro";
import WaButton from "../components/WaButton.astro";
import { breadcrumbs, orgSchema } from "../lib/schema";
import { site } from "../lib/site";

const person = {
  "@context": "https://schema.org", "@type": "Person", name: "Joshua Joseph", jobTitle: "Safari guide and owner",
  image: site.url + "/images/guide/joshua-joseph.webp", worksFor: { "@id": orgSchema["@id"] },
};
---
<Base title="Meet Your Safari Guide, Joshua Joseph | Golden Dust Safaris"
  description="Meet Joshua Joseph, the Arusha safari guide who plans your Tanzania safari with you, meets you at the airport and drives you every day of the trip."
  schema={[orgSchema, person, breadcrumbs([["Home", "/"], ["Meet your guide", "/meet-your-guide"]])]}>
  <section class="section">
    <div class="wrap mg">
      <img class="mg__img" src="/images/guide/joshua-joseph.webp" alt="Joshua Joseph smiling behind the wheel of his safari vehicle" width="864" height="1080" />
      <div>
        <nav class="gp__crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/about">About us</a></nav>
        <h1>Meet your guide, Joshua</h1>
        <p class="lede">Joshua Joseph is the founder of Golden Dust Safaris and the guide you'll travel with. The person who plans your safari with you is the same person who meets you at the airport and drives you every day.</p>
        <div class="prose">
          <h2>Know your guide before you travel</h2>
          <p>With most safari companies, you meet your guide for the first time on the morning of day one. With us, you talk to Joshua while you're still planning. You can ask him anything, hear how he'd shape the trip, and decide whether he's the right person for you before you book.</p>
          <p>If you follow us on <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>, you've probably seen him already. The guide in our videos is the guide in the driver's seat.</p>
          <h2>Small on purpose</h2>
          <p>We don't believe in volume. We only take as many bookings as we can guide ourselves, so your trip gets Joshua's full attention, from the first message to the drive back to the airport.</p>
          <h2>Say hello</h2>
          <p>The easiest way to start is a message on WhatsApp. Tell Joshua what you'd love to see and when you're thinking of coming, and he'll set up a call.</p>
        </div>
        <div class="mg__cta">
          <WaButton label="Message Joshua on WhatsApp" text="Hi Joshua, I'd like to talk about a Tanzania safari." />
          <a class="btn btn--ghost" href="/planner">Plan your own route</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .mg { display: grid; grid-template-columns: minmax(0, 26rem) minmax(0, 40rem); gap: 3rem; align-items: start; }
  .mg__img { width: 100%; height: auto; border-radius: 12px; position: sticky; top: 1rem; }
  .mg__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  @media (max-width: 860px) { .mg { grid-template-columns: 1fr; gap: 1.5rem; } .mg__img { position: static; max-width: 26rem; } }
</style>
