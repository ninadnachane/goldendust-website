---
import Base from "../layouts/Base.astro";
import TourRow from "../components/TourRow.astro";
import WaButton from "../components/WaButton.astro";
import { tours, fromPrice, usd, tourUrl, tierClass } from "../data/tours";
import { site } from "../lib/site";
import { breadcrumbs } from "../lib/schema";

const list = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Tanzania safari packages",
  itemListElement: tours.map((t, i) => ({ "@type": "ListItem", position: i + 1, url: site.url + tourUrl(t), name: t.seoTitle })),
};
---
<Base
  title={`Tanzania Safari Packages from ${usd(Math.min(...tours.map(fromPrice)))} | Golden Dust Safaris`}
  description="Sample private Tanzania safaris from Arusha: Tarangire, the Serengeti and Ngorongoro Crater in 3 to 7 days, from Budget camping to Luxury lodges, with high and green season prices per person."
  schema={[list, breadcrumbs([["Home", "/"], ["Sample safaris", "/tanzania-safari-packages"]])]}
>
  <section class="section">
    <div class="wrap">
      <h1>Sample Tanzania safaris</h1>
      <p class="lede">Popular routes from Arusha to Tarangire, the Serengeti and Ngorongoro Crater, priced with real camps and lodges. Every safari includes your own vehicle and guide, and every one can be changed to suit you, or <a href="/planner">plan your own</a>.</p>

      <div class="compare" role="region" aria-label="Package comparison" tabindex="0">
        <table>
          <thead>
            <tr><th scope="col">Safari</th><th scope="col">Days</th><th scope="col">Style</th><th scope="col">Parks</th><th scope="col">High season pp</th><th scope="col">Green season pp</th></tr>
          </thead>
          <tbody>
            {tours.map((t) => (
              <tr>
                <td><a href={tourUrl(t)}>{t.shortName}</a></td>
                <td>{t.nights + 1}</td>
                <td><span class={`tag tag--${tierClass(t)}`}>{t.tier}</span></td>
                <td>{t.route.slice(1, -1).join(", ")}</td>
                <td><strong>{usd(t.prices.high.pp)}</strong></td>
                <td><strong>{usd(t.prices.green.pp)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="note">Per person for 2 adults sharing (the family safari: 2 adults and 2 children), prices for 2027. High season e.g. arriving in August, green season e.g. arriving in May.</p>
      <div class="tours">{tours.map((t) => <TourRow tour={t} />)}</div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap measure">
      <h2>Want something different?</h2>
      <p>Tanzania has 22 national parks. If you'd like to add Lake Manyara, go further to Ruaha or Katavi, or need a family-friendly pace, we'll build a custom plan around your dates and budget.</p>
      <WaButton label="Ask for a custom safari" text="Hi Golden Dust Safaris, I'd like a custom Tanzania safari." />
    </div>
  </section>
</Base>

<style>
  .compare { overflow-x: auto; margin: 2rem 0 2.5rem; background: var(--surface); border-radius: 10px; border: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; min-width: 36rem; font-size: 0.97rem; }
  th, td { padding: 0.8rem 1rem; text-align: left; border-bottom: 1px solid var(--line); }
  th { font-family: var(--display); font-size: 0.85rem; color: var(--ink-2); }
  tr:last-child td { border-bottom: 0; }
  td a { font-family: var(--display); font-weight: 600; }
  .tours { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .tag { display: inline-block; padding: 0.15rem 0.55rem; border-radius: 999px; font-family: var(--display); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; }
  .tag--budget { background: #6f7d3c; } .tag--comfort { background: #9a6a2f; } .tag--premium { background: #c89a4b; } .tag--luxury { background: #2e241b; }
  .note { font-size: 0.88rem; color: var(--ink-2); margin: -1.5rem 0 2rem; }
  @media (max-width: 1000px) { .tours { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .tours { grid-template-columns: 1fr; } }
</style>
