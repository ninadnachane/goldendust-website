---
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import Reviews from "../components/Reviews.astro";
import WaButton from "../components/WaButton.astro";
import { img } from "../lib/site";
import { orgSchema } from "../lib/schema";

---
<Base
  title="Tanzania Safari Packages & Tours | Golden Dust Safaris"
  description="Private Tanzania safaris from Arusha with local experts. Serengeti, Ngorongoro and Tarangire packages from $800 per person, honest pricing and direct WhatsApp planning."
  schema={[orgSchema]}
>
  <section class="hero">
    <div class="hero__frame">
      <Gallery />
      <div class="hero__panel">
        <h1>Tanzania safaris planned by locals</h1>
        <p class="lede">We're a TALA-registered safari company in Arusha with our own Land Cruisers. Tell us your dates, budget and the animals you dream of, and we'll plan the safari that fits, and tell you honestly where you can save.</p>
        <div class="hero__cta">
          <WaButton label="WhatsApp" />
          <a href="/planner" class="btn btn--glass">Itinerary planner</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2 class="measure">Why travelers plan with us</h2>
      <div class="why">
        <div>
          <h3>You travel with the guide you've already met</h3>
          <p>The guides you see on our Instagram are the guides you travel with, and you meet yours while planning your itinerary. Your guide shapes the whole experience, so you know exactly what you're signing up for. Most safari companies don't work that way: you only meet your guide on the first morning.</p>
        </div>
        <div>
          <h3>Radical honesty, even when we earn less</h3>
          <p>If a park isn't worth the extra drive, we'll say so. If a cheaper option gives the same experience, we'll recommend it. You get a full cost breakdown, real photos of our vehicles, references from recent guests and a free review of other companies' quotes.</p>
        </div>
        <div>
          <h3>Talk to a local, then decide for yourself</h3>
          <p>Send us a message on WhatsApp and we'll usually set up a call. We want to understand what you're looking for and why you're planning to travel to Tanzania, then explain the different national parks and the experiences each one offers. You decide what's best for you. No cookie-cutter itineraries.</p>
        </div>
      </div>
    </div>
  </section>


  <InstagramFeed />

  <Reviews />

  <section class="section">
    <div class="wrap steps-wrap">
      <div>
        <h2>How it works</h2>
        <p class="muted">From the first message to the airport drop-off, you deal with the same local team.</p>
        <a href="/how-it-works">Read the full process</a>
      </div>
      <ol class="steps">
        <li><strong>Message us on WhatsApp.</strong> Tell us your dates, group size and what you'd love to see.</li>
        <li><strong>Talk to your guide.</strong> We arrange a call with the guide who will travel with you.</li>
        <li><strong>Tell us why Tanzania.</strong> Share what's drawing you here, and we'll give you tips and advice from our own experience.</li>
        <li><strong>Receive your custom plan.</strong> A day-by-day itinerary with a full cost breakdown.</li>
        <li><strong>Land in Tanzania.</strong> We meet you at the airport, and your first night's stay is on us.</li>
        <li><strong>Something special begins.</strong> Set off on what we hope becomes the most memorable experience of your life.</li>
      </ol>
    </div>
  </section>

  <section class="section section--green">
    <div class="wrap cta">
      <h2>Ready to plan your safari?</h2>
      <p class="measure">Message us on WhatsApp and talk directly to a local safari expert in Arusha.</p>
      <WaButton variant="light" label="Start planning on WhatsApp" />
    </div>
  </section>
</Base>

<style>
  /* Full-width photo gallery with the headline on a frosted panel */
  .hero { padding: 0; }
  .hero__frame { position: relative; }
  /* photos run edge to edge, no rounded corners */
  .hero__frame > :global(.gal) { border-radius: 0; box-shadow: none; }
  .hero__frame > :global(.gal .gal__track) { aspect-ratio: auto; height: clamp(480px, 76vh, 820px); }
  .hero__panel {
    position: absolute; z-index: 2; left: clamp(1rem, 3.5vw, 3rem); top: 50%; transform: translateY(-50%);
    width: min(25rem, calc(100% - 2rem)); min-height: 74%;
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(1.6rem, 3vw, 2.6rem) clamp(1.4rem, 2.4vw, 2rem);
    border-radius: 20px; color: var(--ivory);
    background: rgba(46, 36, 27, 0.45);
    -webkit-backdrop-filter: blur(14px) saturate(1.1); backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgba(244, 237, 224, 0.22);
    box-shadow: 0 20px 50px -25px rgba(0, 0, 0, 0.6);
  }
  .hero__panel h1 { color: var(--ivory); font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -0.02em; margin-bottom: 0.9rem; }
  .hero__panel .lede { color: rgba(244, 237, 224, 0.92); font-size: 1rem; line-height: 1.65; margin: 0; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; }
  .hero__cta :global(.btn--glass) { background: rgba(244, 237, 224, 0.12); color: var(--ivory); border-color: rgba(244, 237, 224, 0.6); }
  .hero__cta :global(.btn--glass:hover) { background: var(--ivory); color: var(--dark); border-color: var(--ivory); }
  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 2rem; }
  .why h3 { font-size: 1.3rem; padding-top: 1rem; border-top: 3px solid var(--gold); }
  .why p { color: var(--ink-2); }
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.5rem 2rem; margin-bottom: 2rem; }
  .sec-head h2 { margin: 0; }
  .sec-head p { margin: 0; }
  .steps-wrap { display: grid; grid-template-columns: 1fr 1.6fr; gap: 3rem; }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; }
  .steps li { counter-increment: s; position: relative; padding: 0 0 1.4rem 3.2rem; color: var(--ink-2); }
  .steps li::before {
    content: counter(s); position: absolute; left: 0; top: -0.1rem; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--btn); color: var(--btn-text); font-family: var(--display); font-weight: 600;
  }
  .steps li:not(:last-child)::after { content: ""; position: absolute; left: 1.03rem; top: 2.2rem; bottom: 0.2rem; border-left: 2px dashed var(--gold); }
  .steps strong { color: var(--rust); font-family: var(--display); font-weight: 600; }
  .cta { text-align: left; }
  .cta h2 { color: var(--gold); }
  @media (max-width: 900px) {
    .steps-wrap { grid-template-columns: 1fr; }
    .why { grid-template-columns: 1fr; }
  }
  /* Phones: photo on top, the frosted panel overlaps its lower edge */
  @media (max-width: 680px) {
    .hero__frame > :global(.gal .gal__track) { height: 62vh; min-height: 380px; }
    .hero__frame > :global(.gal .gal__bar) { top: 0; bottom: auto; padding: 1rem; background: linear-gradient(to bottom, rgba(46, 36, 27, 0.45), transparent); }
    .hero__panel { position: relative; left: auto; top: auto; transform: none; width: auto; min-height: 0; margin: -5.5rem 0.75rem 0; background: rgba(46, 36, 27, 0.9); }
  }
</style>
