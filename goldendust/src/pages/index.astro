---
import Base from "../layouts/Base.astro";
import TourRow from "../components/TourRow.astro";
import WaButton from "../components/WaButton.astro";
import Faq from "../components/Faq.astro";
import { tours } from "../data/tours";
import { img } from "../lib/site";
import { orgSchema, faqSchema } from "../lib/schema";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 3);

const faqs = [
  {
    q: "How much does a Tanzania safari with Golden Dust Safaris cost?",
    a: "Our private safaris start at $800 per person for a 4-day Serengeti and Ngorongoro camping safari (group of 6). A 5-day Tarangire, Serengeti and Ngorongoro safari starts at $1,050 per person on a budget and $1,620 mid-range. The price per person drops as your group gets bigger, because you share the vehicle and the crater fee.",
  },
  {
    q: "Can you build a custom safari instead of a package?",
    a: "Yes. Most of our guests end up with a custom plan. Tell us your dates, budget and what you want to see on WhatsApp, and we'll suggest parks and an itinerary, including less-visited parks like Ruaha and Katavi.",
  },
  {
    q: "Will you review a quote from another safari company?",
    a: "Yes, for free. Send it to us and we'll tell you honestly whether it's good value, even if you end up booking with them.",
  },
  {
    q: "What happens when I land in Tanzania?",
    a: "We pick you up at Kilimanjaro or Arusha airport, take you to your hotel (the night before your safari is on us), and your guide briefs you on the days ahead. After the safari we drop you at the airport or your hotel.",
  },
];
---
<Base
  title="Tanzania Safari Packages & Tours | Golden Dust Safaris"
  description="Private Tanzania safaris from Arusha with local experts. Serengeti, Ngorongoro and Tarangire packages from $800 per person, honest pricing and direct WhatsApp planning."
  schema={[orgSchema, faqSchema(faqs)]}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1>Tanzania safaris planned by locals who drive these parks every week</h1>
        <p class="lede">We're a TALA-registered safari company in Arusha with our own Land Cruisers. Tell us your dates, budget and the animals you dream of, and we'll plan the safari that fits, and tell you honestly where you can save.</p>
        <div class="hero__cta">
          <WaButton label="Plan my safari on WhatsApp" />
          <a href="/tanzania-safari-packages" class="btn btn--ghost">See safari packages</a>
        </div>
      </div>
      <figure class="hero__img">
        <img src={img("7df076_f9426230a0e84400a48f65dcfbca9bc0~mv2.png", 900)} alt="Lion resting on the Serengeti plains, Tanzania" width="800" height="400" fetchpriority="high" />
        <img src={img("7df076_2388d60eb3d84d4bad382212a626b715~mv2.jpg", 700)} alt="Giraffe in Serengeti National Park" width="600" height="400" loading="lazy" class="hero__img2" />
      </figure>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2 class="measure">Why travelers plan with us</h2>
      <div class="why">
        <div>
          <h3>We know all 22 national parks, not just the famous three</h3>
          <p>Most companies sell Serengeti, Ngorongoro and Tarangire. We'll also tell you when Ruaha's quiet wilderness or remote Katavi suits you better, matched to your budget, wildlife interests, photography goals, family needs and travel dates.</p>
        </div>
        <div>
          <h3>Radical honesty, even when we earn less</h3>
          <p>If a park isn't worth the extra drive, we'll say so. If a cheaper option gives the same experience, we'll recommend it. You get a full cost breakdown, real photos of our vehicles, references from recent guests and a free review of other companies' quotes.</p>
        </div>
        <div>
          <h3>Talk to a local expert before you pay anything</h3>
          <p>We don't sell packages on the first conversation. Message us on WhatsApp and we'll help you compare parks, understand the Serengeti's regions and match the trip to your budget, even if you don't book with us.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="safaris">
    <div class="wrap">
      <div class="sec-head">
        <h2>Safari packages</h2>
        <p class="muted measure">Every safari is private: your own vehicle and guide. Prices are per person and get lower as your group grows. Use these as a starting point; we'll adjust any of them.</p>
      </div>
      <div class="tours">
        {tours.map((t) => <TourRow tour={t} />)}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap steps-wrap">
      <div>
        <h2>How it works</h2>
        <p class="muted">From the first message to the airport drop-off, you deal with the same local team.</p>
        <a href="/how-it-works">Read the full process</a>
      </div>
      <ol class="steps">
        <li><strong>Message us on WhatsApp.</strong> Share your dates, budget and interests. No forms.</li>
        <li><strong>Get an honest opinion.</strong> We suggest parks and tell you what's worth it and what isn't.</li>
        <li><strong>Receive your custom plan.</strong> A day-by-day itinerary with a full cost breakdown.</li>
        <li><strong>Land in Tanzania.</strong> We meet you at the airport, and your first night's stay is on us.</li>
        <li><strong>Go on safari.</strong> Your guide picks you up in the morning, and drops you off at the end.</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <h2>Safari planning guides</h2>
        <a href="/blog">All guides</a>
      </div>
      <div class="posts">
        {posts.map((p) => (
          <a class="post" href={`/post/${p.id}`}>
            <img src={img(p.data.image, 600)} alt={p.data.imageAlt} loading="lazy" width="600" height="320" />
            <h3>{p.data.title}</h3>
            <p class="muted">{p.data.minutes} min read</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap"><Faq items={faqs} /></div>
  </section>

  <section class="section section--green">
    <div class="wrap cta">
      <h2>Ready to plan your safari?</h2>
      <p class="measure">Message us on WhatsApp and talk directly to a local safari expert in Arusha.</p>
      <WaButton variant="light" label="Start planning on WhatsApp" />
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(2.5rem, 6vw, 4.5rem) 0; }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .hero__img { margin: 0; position: relative; padding-bottom: 3rem; }
  .hero__img img { border-radius: 10px; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .hero__img .hero__img2 { position: absolute; width: 46%; aspect-ratio: 3 / 2; right: -0.5rem; bottom: 0; border: 6px solid var(--bg); }
  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 2rem; }
  .why h3 { font-size: 1.15rem; padding-top: 1rem; border-top: 3px solid var(--gold); }
  .why p { color: var(--ink-2); }
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 0.5rem 2rem; margin-bottom: 2rem; }
  .sec-head h2 { margin: 0; }
  .sec-head p { margin: 0; }
  .tours { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .steps-wrap { display: grid; grid-template-columns: 1fr 1.6fr; gap: 3rem; }
  .steps { margin: 0; padding: 0; list-style: none; counter-reset: s; }
  .steps li { counter-increment: s; position: relative; padding: 0 0 1.4rem 3.2rem; color: var(--ink-2); }
  .steps li::before {
    content: counter(s); position: absolute; left: 0; top: -0.1rem; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--green); color: #fff; font-family: var(--display); font-weight: 700;
  }
  .steps li:not(:last-child)::after { content: ""; position: absolute; left: 1.03rem; top: 2.2rem; bottom: 0.2rem; border-left: 2px dashed var(--gold); }
  .steps strong { color: var(--ink); font-family: var(--display); font-weight: 700; }
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .post { text-decoration: none; color: var(--ink); }
  .post img { border-radius: 8px; aspect-ratio: 15 / 8; object-fit: cover; width: 100%; margin-bottom: 0.9rem; background: var(--line); }
  .post h3 { font-size: 1.08rem; margin-bottom: 0.3rem; }
  .post:hover h3 { color: var(--green); text-decoration: underline; }
  .post p { margin: 0; font-size: 0.9rem; }
  .cta { text-align: left; }
  .cta h2 { color: #fff; }
  @media (max-width: 900px) {
    .hero__grid, .steps-wrap { grid-template-columns: 1fr; }
    .why, .posts, .tours { grid-template-columns: 1fr; }
  }
</style>
