---
// Admin sign-in: password, then a one-time code sent to the admin email.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Sign in | Golden Dust admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="box">
    <img src="/images/logo-header.webp" alt="Golden Dust Safaris" width="180" height="88" />
    <h1>Planner admin</h1>

    <form data-step="1" autocomplete="on">
      <label>Email<input type="email" name="email" autocomplete="username" required /></label>
      <label>Password<input type="password" name="password" autocomplete="current-password" required minlength="12" /></label>
      <button type="submit">Continue</button>
    </form>

    <form data-step="2" hidden autocomplete="off">
      <p class="msg">We've emailed you a 6-digit code. It expires in <span data-min>10</span> minutes.</p>
      <label>Code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required /></label>
      <button type="submit">Sign in</button>
      <button type="button" class="link" data-restart>Start again</button>
    </form>

    <p class="err" role="alert" data-err></p>
  </main>

  <script>
    const f1 = document.querySelector<HTMLFormElement>('[data-step="1"]')!;
    const f2 = document.querySelector<HTMLFormElement>('[data-step="2"]')!;
    const err = document.querySelector<HTMLElement>("[data-err]")!;
    let challenge = "";
    const post = async (url: string, body: unknown) => {
      const r = await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body), credentials: "same-origin" });
      return { ok: r.ok, d: await r.json().catch(() => ({})) };
    };
    const busy = (f: HTMLFormElement, on: boolean) => f.querySelectorAll("button").forEach((b) => (b.disabled = on));
    const restart = () => { challenge = ""; f2.hidden = true; f1.hidden = false; f2.reset(); (f1.elements.namedItem("password") as HTMLInputElement).value = ""; };
    f1.addEventListener("submit", async (e) => {
      e.preventDefault(); err.textContent = ""; busy(f1, true);
      const { ok, d } = await post("/api/auth/login", { email: (f1.elements.namedItem("email") as HTMLInputElement).value, password: (f1.elements.namedItem("password") as HTMLInputElement).value });
      busy(f1, false);
      if (!ok) { err.textContent = d.error || "Something went wrong."; return; }
      challenge = d.challenge;
      document.querySelector("[data-min]")!.textContent = String(d.minutes || 10);
      f1.hidden = true; f2.hidden = false;
      (f2.elements.namedItem("code") as HTMLInputElement).focus();
    });
    f2.addEventListener("submit", async (e) => {
      e.preventDefault(); err.textContent = ""; busy(f2, true);
      const { ok, d } = await post("/api/auth/verify", { challenge, code: (f2.elements.namedItem("code") as HTMLInputElement).value });
      busy(f2, false);
      if (ok) { location.replace("/admin"); return; }
      err.textContent = d.error || "Something went wrong.";
      if (d.restart) restart();
    });
    document.querySelector("[data-restart]")!.addEventListener("click", () => { err.textContent = ""; restart(); });
  </script>

  <style is:global>
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f8f3ea; font-family: Montserrat, system-ui, sans-serif; color: #2b2118; padding: 1rem; }
    .box { width: min(24rem, 100%); background: #fff; border: 1px solid #e6dccb; border-radius: 16px; padding: 1.8rem 1.6rem; box-shadow: 0 24px 48px -32px rgba(46, 36, 27, 0.5); text-align: center; }
    .box img { height: 70px; width: auto; }
    h1 { font-size: 1.2rem; font-weight: 600; margin: 0.6rem 0 1.2rem; }
    form { display: grid; gap: 0.9rem; text-align: left; }
    form[hidden] { display: none; }
    label { display: grid; gap: 0.35rem; font-weight: 500; font-size: 0.92rem; }
    input { font: inherit; padding: 0.7rem 0.8rem; border: 1px solid #e6dccb; border-radius: 10px; }
    input[name="code"] { font-size: 1.4rem; letter-spacing: 0.3em; text-align: center; }
    input:focus { outline: 2px solid #c89a4b; outline-offset: 0; }
    button { font: inherit; font-weight: 600; padding: 0.75rem; border-radius: 999px; border: 0; background: #c89a4b; color: #2e241b; cursor: pointer; }
    button:disabled { opacity: 0.5; cursor: default; }
    button.link { background: none; color: #8a4b2e; font-weight: 500; padding: 0.2rem; }
    .msg { margin: 0; color: #6b5d4f; font-size: 0.92rem; }
    .err { color: #a8321e; min-height: 1.2em; margin: 1rem 0 0; font-size: 0.92rem; }
  </style>
</body>
</html>
