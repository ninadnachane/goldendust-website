---
import Base from "../layouts/Base.astro";
import WaButton from "../components/WaButton.astro";
import { site } from "../lib/site";
---
<Base
  title="Safari Itinerary Planner | Golden Dust Safaris"
  description="Build your own Tanzania safari itinerary: choose your dates, comfort level, parks and lodges, and see the price instantly with a full cost breakdown."
  noindex
>
  <section class="section pl" data-planner data-wa={site.whatsapp}>
    <div class="wrap">
      <header class="pl__head">
        <h1>Plan your safari</h1>
        <p class="lede">Pick your dates, your style and the parks you'd love to see. The price updates as you go, with nothing hidden. When it looks right, send it to us and your guide takes it from there.</p>
      </header>

      <div class="pl__grid">
        <div class="pl__steps">
          <section class="step" data-step="1">
            <button type="button" class="step__head" data-open="1"><span class="step__n">1</span><span class="step__t">Who's travelling?</span><span class="step__sum" data-sum="1"></span><span class="step__edit">Change</span></button>
            <div class="step__body">
              <div class="row">
                <div class="count">
                  <span class="count__l">Adults</span>
                  <div class="count__c"><button type="button" data-dec="adults" aria-label="Fewer adults">−</button><output data-out="adults">2</output><button type="button" data-inc="adults" aria-label="More adults">+</button></div>
                </div>
                <div class="count">
                  <span class="count__l">Children <small data-child-note></small></span>
                  <div class="count__c"><button type="button" data-dec="children" aria-label="Fewer children">−</button><output data-out="children">0</output><button type="button" data-inc="children" aria-label="More children">+</button></div>
                </div>
              </div>
              <div class="ages" data-ages></div>
              <button type="button" class="btn step__next" data-next="2">Continue</button>
            </div>
          </section>

          <section class="step" data-step="2">
            <button type="button" class="step__head" data-open="2"><span class="step__n">2</span><span class="step__t">When?</span><span class="step__sum" data-sum="2"></span><span class="step__edit">Change</span></button>
            <div class="step__body">
              <div class="row">
                <label class="fld">Arrival in Arusha<input type="date" data-date required /></label>
                <label class="fld">Nights in Tanzania<select data-nights></select></label>
              </div>
              <p class="note" data-date-note></p>
              <button type="button" class="btn step__next" data-next="3" disabled>Continue</button>
            </div>
          </section>

          <section class="step" data-step="3">
            <button type="button" class="step__head" data-open="3"><span class="step__n">3</span><span class="step__t">Your safari style</span><span class="step__sum" data-sum="3"></span><span class="step__edit">Change</span></button>
            <div class="step__body">
              <div class="styles" data-styles></div>
            </div>
          </section>

          <section class="step" data-step="4" data-where>
            <button type="button" class="step__head" data-open="4"><span class="step__n">4</span><span class="step__t">Where to?</span><span class="step__sum" data-sum="4"></span><span class="step__edit">Change</span></button>
            <div class="step__body">
              <p class="note">Night 1 is in <strong data-arrival-name>Arusha</strong>, included. Choose areas for your <strong data-safari-nights></strong>; we'll put them in the best order.</p>
              <div class="chips" data-areas></div>
              <div class="stops" data-stops></div>
            </div>
          </section>
        </div>

        <aside class="pl__sum" aria-live="polite">
          <div class="sum" data-sum-box>
            <button type="button" class="sum__mini" data-sum-toggle aria-expanded="false">
              <span data-mini>Your safari</span><span class="sum__chev" aria-hidden="true"></span>
            </button>
            <div class="sum__full">
              <p class="sum__h">Your safari</p>
              <ol class="sum__trip" data-trip></ol>
              <div data-price></div>
            </div>
            <button type="button" class="btn sum__wa" data-send aria-disabled="true">Send my itinerary on WhatsApp</button>
            <button type="button" class="sum__pdf" data-pdf aria-disabled="true">Download as PDF</button>
            <p class="sum__fine">Prices in USD for your whole group. Includes park fees, vehicle, guide, accommodation and your first night in Arusha. International flights, visas, tips and drinks are extra.</p>
          </div>
        </aside>
      </div>

      <dialog class="ct" data-contact aria-labelledby="ct-h">
        <form class="ct__in" data-contact-form novalidate>
          <div class="ct__head"><h2 id="ct-h">Send your itinerary</h2><button type="button" class="ct__x" data-ct-close aria-label="Close">✕</button></div>
          <p class="ct__lede" data-ct-lede>Your guide will reply on WhatsApp, usually within a few hours, to check availability and fine-tune the plan.</p>
          <label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label>
          <label>Mobile number (WhatsApp)<input name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+31 6 1234 5678" required /></label>
          <label><span>Email <small>(optional)</small></span><input name="email" type="email" autocomplete="email" /></label>
          <label class="ct__hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <p class="ct__err" role="alert" data-ct-err></p>
          <button type="submit" class="btn ct__go">Continue to WhatsApp</button>
          <p class="ct__fine">We save your details and itinerary only to plan your trip with you. We never share them. Ask us any time and we'll delete them.</p>
        </form>
      </dialog>

      <noscript><p>The planner needs JavaScript. You can also <a href={`https://wa.me/${site.whatsapp}`}>plan with us on WhatsApp</a>.</p></noscript>
      <div class="pl__fallback" data-fallback hidden>
        <p>The planner isn't available right now. Our team in Arusha can plan your trip with you directly.</p>
        <WaButton label="Plan my safari on WhatsApp" />
      </div>
    </div>
  </section>
</Base>

<script>
  type Opt = {
    settings: { leadDays: number; childMinAge: number; childMaxAge: number; minTotalNights: number; maxTotalNights: number; maxGuests: number };
    categories: { id: string; name: string; blurb: string }[];
    arrivalName: string;
    areas: { id: string; name: string; minNights: number }[];
    lodges: { id: string; name: string; areaId: string; category: string; description: string; images: string[] }[];
  };
  const root = document.querySelector<HTMLElement>("[data-planner]")!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const usd = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
  const addDays = (iso: string, d: number) => { const x = new Date(iso + "T00:00:00Z"); x.setUTCDate(x.getUTCDate() + d); return x.toISOString().slice(0, 10); };
  const nice = (iso: string) => new Date(iso + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

  let O: Opt;
  const st = { adults: 2, ages: [] as number[], date: "", nights: 6, category: "", stops: [] as { areaId: string; nights: number; lodgeId: string }[], open: 1, reached: 1 };
  const mobile = () => window.matchMedia("(max-width: 900px)").matches;

  function openStep(n: number, scroll = false) {
    st.open = n; st.reached = Math.max(st.reached, n);
    renderSteps();
    if (scroll) {
      const el = root.querySelector<HTMLElement>(`[data-step="${n}"]`)!;
      requestAnimationFrame(() => {
        const y = el.getBoundingClientRect().top + window.scrollY - (mobile() ? 12 : 24);
        if (el.getBoundingClientRect().top < 0 || el.getBoundingClientRect().top > window.innerHeight * 0.5) window.scrollTo({ top: y, behavior: "smooth" });
      });
    }
  }

  function renderSteps() {
    const cat = O.categories.find((c) => c.id === st.category)?.name ?? "";
    const kids = st.ages.length ? ` · ${st.ages.length} child${st.ages.length > 1 ? "ren" : ""} (${st.ages.join(", ")})` : "";
    const sums: Record<number, string> = {
      1: `${st.adults} adult${st.adults > 1 ? "s" : ""}${kids}`,
      2: st.date ? `${nice(st.date)} · ${st.nights} nights` : "",
      3: cat,
      4: st.stops.length ? O.areas.filter((a) => st.stops.some((s) => s.areaId === a.id)).map((a) => a.name).join(", ") : "",
    };
    root.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
      const n = Number(el.dataset.step);
      const open = st.open === n;
      const locked = n > st.reached;
      el.classList.toggle("is-open", open);
      el.classList.toggle("is-locked", locked);
      const head = el.querySelector<HTMLButtonElement>(".step__head")!;
      head.setAttribute("aria-expanded", String(open));
      head.disabled = locked;
      el.querySelector("[data-sum]")!.textContent = open ? "" : sums[n];
    });
    root.querySelector<HTMLButtonElement>('[data-next="3"]')!.disabled = !st.date;
  }

  const safariNights = () => st.nights - 1;
  const used = () => st.stops.reduce((a, s) => a + s.nights, 0);
  const areaOrder = (id: string) => O.areas.findIndex((a) => a.id === id);

  function renderPeople() {
    $("[data-out=adults]").textContent = String(st.adults);
    $("[data-out=children]").textContent = String(st.ages.length);
    $("[data-child-note]").textContent = `(0–${O.settings.childMaxAge})`;
    $("[data-ages]").innerHTML = st.ages.map((a, i) => `<label class="age">Child ${i + 1} age<select data-age="${i}">${
      Array.from({ length: O.settings.childMaxAge + 1 }, (_, n) => `<option value="${n}" ${n === a ? "selected" : ""}>${n < 1 ? "Under 1" : n}</option>`).join("")}</select></label>`).join("");
    root.querySelectorAll<HTMLSelectElement>("[data-age]").forEach((el) => el.addEventListener("change", () => { st.ages[Number(el.dataset.age)] = Number(el.value); update(); }));
  }

  function renderStyles() {
    $("[data-styles]").innerHTML = O.categories.map((c) => `<button type="button" class="style" aria-pressed="${st.category === c.id}" data-cat="${c.id}"><strong>${esc(c.name)}</strong><span>${esc(c.blurb)}</span></button>`).join("");
    root.querySelectorAll<HTMLButtonElement>("[data-cat]").forEach((b) => b.addEventListener("click", () => {
      st.category = b.dataset.cat!;
      st.stops.forEach((s) => (s.lodgeId = ""));
      renderStyles(); renderWhere(); openStep(4, true); update();
    }));
  }

  function renderWhere() {
    if (!st.category) { $("[data-areas]").innerHTML = ""; $("[data-stops]").innerHTML = ""; return; }
    $("[data-safari-nights]").textContent = `${safariNights()} safari night${safariNights() === 1 ? "" : "s"}`;
    const left = safariNights() - used();
    $("[data-areas]").innerHTML = O.areas.map((a) => {
      const on = st.stops.some((s) => s.areaId === a.id);
      const hasLodge = O.lodges.some((l) => l.areaId === a.id && l.category === st.category);
      const blocked = !on && (!hasLodge || a.minNights > left);
      const why = !hasLodge ? "No options in this style yet" : a.minNights > left ? `Needs ${a.minNights} night${a.minNights > 1 ? "s" : ""}: add nights in step 2` : "";
      return `<button type="button" class="chip" data-area="${a.id}" aria-pressed="${on}" ${blocked ? 'aria-disabled="true"' : ""} title="${esc(why)}">${esc(a.name)}${a.minNights > 1 ? ` <small>min ${a.minNights}</small>` : ""}</button>`;
    }).join("");
    root.querySelectorAll<HTMLButtonElement>("[data-area]").forEach((b) => b.addEventListener("click", () => {
      const id = b.dataset.area!;
      const i = st.stops.findIndex((s) => s.areaId === id);
      if (i >= 0) st.stops.splice(i, 1);
      else {
        if (b.getAttribute("aria-disabled") === "true") { flash(b.title); return; }
        const a = O.areas.find((x) => x.id === id)!;
        st.stops.push({ areaId: id, nights: Math.max(a.minNights, Math.min(safariNights() - used(), a.minNights)), lodgeId: "" });
        st.stops.sort((x, y) => areaOrder(x.areaId) - areaOrder(y.areaId));
      }
      renderWhere(); update();
    }));

    $("[data-stops]").innerHTML = st.stops.map((s, i) => {
      const a = O.areas.find((x) => x.id === s.areaId)!;
      const lodges = O.lodges.filter((l) => l.areaId === s.areaId && l.category === st.category);
      if (!lodges.some((l) => l.id === s.lodgeId)) s.lodgeId = lodges[0]?.id || "";
      return `<div class="stop">
        <div class="stop__top"><strong>${esc(a.name)}</strong>
          <div class="count__c sm"><button type="button" data-sdec="${i}" aria-label="One night less in ${esc(a.name)}">−</button><output>${s.nights} night${s.nights > 1 ? "s" : ""}</output><button type="button" data-sinc="${i}" aria-label="One more night in ${esc(a.name)}">+</button></div></div>
        <div class="lodges">${lodges.map((l) => `<label class="lodge">
          <input type="radio" name="lodge-${i}" value="${esc(l.id)}" ${l.id === s.lodgeId ? "checked" : ""} data-lodge="${i}">
          <span class="lodge__img">${l.images.length
            ? `<button type="button" class="lodge__view" data-gal="${esc(l.id)}" data-gal-stop="${i}" aria-label="View photos of ${esc(l.name)}"><img src="/media/${esc(l.images[0])}" alt="" loading="lazy"><span class="lodge__more"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>${l.images.length > 1 ? `${l.images.length} photos` : "View"}</span></button>`
            : `<span class="lodge__none">Photos coming soon</span>`}</span>
          <span class="lodge__txt"><strong>${esc(l.name)}</strong>${l.description ? `<span>${esc(l.description)}</span>` : ""}</span>
          <span class="lodge__tick" aria-hidden="true"></span>
        </label>`).join("")}</div>
      </div>`;
    }).join("");
    root.querySelectorAll<HTMLButtonElement>("[data-sinc]").forEach((b) => b.addEventListener("click", () => {
      const s = st.stops[Number(b.dataset.sinc)];
      if (used() >= safariNights()) return flash("All your nights are used. Add nights in step 2, or take one from another area.");
      s.nights++; renderWhere(); update();
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-sdec]").forEach((b) => b.addEventListener("click", () => {
      const s = st.stops[Number(b.dataset.sdec)];
      const a = O.areas.find((x) => x.id === s.areaId)!;
      if (s.nights <= a.minNights) return flash(`${a.name} needs at least ${a.minNights} night${a.minNights > 1 ? "s" : ""}.`);
      s.nights--; renderWhere(); update();
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-gal]").forEach((b) => b.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); openGallery(b.dataset.gal!, Number(b.dataset.galStop)); }));
    root.querySelectorAll<HTMLInputElement>("[data-lodge]").forEach((el) => el.addEventListener("change", () => { st.stops[Number(el.dataset.lodge)].lodgeId = el.value; update(); }));
  }

  // photo viewer: enlarged, swipe or scroll through all photos, choose the lodge from here
  function openGallery(id: string, stopIndex: number) {
    const l = O.lodges.find((x) => x.id === id);
    if (!l || !l.images.length) return;
    const n = l.images.length;
    const d = document.createElement("dialog");
    d.className = "gv";
    d.setAttribute("aria-label", `${l.name} photos`);
    d.innerHTML = `<div class="gv__in">
        <div class="gv__top"><div><strong>${esc(l.name)}</strong>${l.description ? `<p>${esc(l.description)}</p>` : ""}</div>
          <button type="button" class="gv__x" data-gv-close aria-label="Close">✕</button></div>
        <div class="gv__stage">
          <div class="gv__track" tabindex="0">${l.images.map((im, k) => `<figure><img src="/media/${esc(im)}" alt="${esc(l.name)}, photo ${k + 1} of ${n}" ${k > 1 ? 'loading="lazy"' : ""}></figure>`).join("")}</div>
          ${n > 1 ? `<button type="button" class="gv__nav gv__prev" data-gv="-1" aria-label="Previous photo">‹</button><button type="button" class="gv__nav gv__next" data-gv="1" aria-label="Next photo">›</button>` : ""}
        </div>
        <div class="gv__bottom">${n > 1 ? `<span class="gv__dots">${l.images.map((_, k) => `<i class="${k === 0 ? "on" : ""}"></i>`).join("")}</span><span class="gv__count" data-gv-count>1 / ${n}</span>` : "<span></span>"}
          <button type="button" class="btn gv__pick" data-gv-pick>${st.stops[stopIndex]?.lodgeId === l.id ? "Selected ✓" : "Choose this lodge"}</button></div>
      </div>`;
    const track = d.querySelector<HTMLElement>(".gv__track")!;
    const idx = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (k: number) => track.scrollTo({ left: ((k + n) % n) * track.clientWidth, behavior: "smooth" });
    track.addEventListener("scroll", () => {
      const k = idx();
      const c = d.querySelector("[data-gv-count]"); if (c) c.textContent = `${k + 1} / ${n}`;
      d.querySelectorAll(".gv__dots i").forEach((dot, j) => dot.classList.toggle("on", j === k));
    }, { passive: true });
    d.querySelectorAll<HTMLButtonElement>("[data-gv]").forEach((b) => b.addEventListener("click", () => go(idx() + Number(b.dataset.gv))));
    d.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") { e.preventDefault(); go(idx() + 1); } if (e.key === "ArrowLeft") { e.preventDefault(); go(idx() - 1); } });
    d.querySelector("[data-gv-close]")!.addEventListener("click", () => d.close());
    d.querySelector("[data-gv-pick]")!.addEventListener("click", () => {
      if (st.stops[stopIndex]) { st.stops[stopIndex].lodgeId = l.id; renderWhere(); update(); }
      d.close();
    });
    d.addEventListener("click", (e) => { if (e.target === d) d.close(); });
    d.addEventListener("close", () => { d.remove(); document.documentElement.style.overflow = ""; });
    root.append(d);
    document.documentElement.style.overflow = "hidden";
    d.showModal();
    track.focus({ preventScroll: true });
  }

  let toast: number | undefined;
  function flash(msg: string) {
    if (!msg) return;
    let t = root.querySelector<HTMLElement>(".toast");
    if (!t) { t = document.createElement("div"); t.className = "toast"; t.setAttribute("role", "status"); root.append(t); }
    t.textContent = msg; t.classList.add("is-on");
    clearTimeout(toast); toast = window.setTimeout(() => t!.classList.remove("is-on"), 3200);
  }

  function renderTrip() {
    const items: string[] = [];
    if (st.date) items.push(`<li><span>${nice(st.date)}</span>Arrive, night in ${esc(O.arrivalName)}</li>`);
    let n = 1;
    for (const s of st.stops) {
      const a = O.areas.find((x) => x.id === s.areaId)!;
      const l = O.lodges.find((x) => x.id === s.lodgeId);
      items.push(`<li><span>${st.date ? nice(addDays(st.date, n)) : `Night ${n + 1}`}</span>${s.nights} night${s.nights > 1 ? "s" : ""} ${esc(a.name)}${l ? ` · ${esc(l.name)}` : ""}</li>`);
      n += s.nights;
    }
    if (st.date) items.push(`<li><span>${nice(addDays(st.date, st.nights))}</span>Back to Arusha / airport</li>`);
    $("[data-trip]").innerHTML = items.join("") || "<li>Start by choosing your dates.</li>";
  }

  function waText(total?: number, name?: string, ref?: string) {
    const lines = [
      `Hi Golden Dust Safaris${name ? `, this is ${name}` : ""}. I built this itinerary on your planner${ref ? ` (ref ${ref})` : ""}:`,
      `• ${st.adults} adult${st.adults > 1 ? "s" : ""}${st.ages.length ? `, children aged ${st.ages.join(", ")}` : ""}`,
      `• Arriving ${st.date ? nice(st.date) : "(date tbc)"}, ${st.nights} nights`,
      `• Style: ${O.categories.find((c) => c.id === st.category)?.name ?? "tbc"}`,
      `• Night 1: ${O.arrivalName}`,
      ...st.stops.map((s) => `• ${s.nights} night${s.nights > 1 ? "s" : ""} ${O.areas.find((a) => a.id === s.areaId)?.name}: ${O.lodges.find((l) => l.id === s.lodgeId)?.name ?? ""}`),
    ];
    if (total) lines.push(`• Planner price: ${usd(total)}`);
    lines.push("Could you check availability?");
    return lines.join("\n");
  }

  let timer: number | undefined, seq = 0, lastTotal = 0;

  // ---- send on WhatsApp: collect name + number, save the lead, then open WhatsApp
  const store = { get: (k: string) => { try { return localStorage.getItem(k) || ""; } catch { return ""; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} } };
  // One lead per trip: if the guest already left their details for this exact trip, reuse it.
  let lastLead: { key: string; ref: string; token: string } | null = null;
  let mode: "whatsapp" | "pdf" = "whatsapp";
  const tripNow = () => ({ startDate: st.date, adults: st.adults, childAges: st.ages, category: st.category, totalNights: st.nights, stops: st.stops });
  const pdfUrl = (ref: string, token: string) => `/itinerary#ref=${encodeURIComponent(ref)}&k=${encodeURIComponent(token)}`;
  function openContact(m: "whatsapp" | "pdf") {
    const send = $("[data-send]");
    if (send.getAttribute("aria-disabled") === "true") { flash("Finish your itinerary first: dates, style and where to go."); return; }
    mode = m;
    const key = JSON.stringify(tripNow());
    if (m === "pdf" && lastLead && lastLead.key === key) { window.open(pdfUrl(lastLead.ref, lastLead.token), "_blank"); return; }
    const d = $<HTMLDialogElement>("[data-contact]");
    const f = $<HTMLFormElement>("[data-contact-form]");
    (f.elements.namedItem("name") as HTMLInputElement).value ||= store.get("gd_name");
    (f.elements.namedItem("phone") as HTMLInputElement).value ||= store.get("gd_phone");
    (f.elements.namedItem("email") as HTMLInputElement).value ||= store.get("gd_email");
    $("[data-ct-err]").textContent = "";
    $("#ct-h").textContent = m === "pdf" ? "Get your itinerary as a PDF" : "Send your itinerary";
    $("[data-ct-lede]").textContent = m === "pdf"
      ? "Leave your name and mobile number and your PDF opens straight away. Your guide may follow up on WhatsApp to help with the plan."
      : "Your guide will reply on WhatsApp, usually within a few hours, to check availability and fine-tune the plan.";
    f.querySelector<HTMLButtonElement>(".ct__go")!.textContent = m === "pdf" ? "Open my PDF" : "Continue to WhatsApp";
    d.showModal();
  }
  async function submitContact(e: Event) {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value.trim();
    const err = $("[data-ct-err]");
    const phone = v("phone").replace(/[^\d+]/g, "").replace(/^00/, "+");
    if (v("name").length < 2) { err.textContent = "Please add your name."; return; }
    if (!/^\+\d{8,15}$/.test(phone)) { err.textContent = "Please add your mobile number with the country code, starting with + (e.g. +31 6 1234 5678)."; return; }
    const btn = f.querySelector<HTMLButtonElement>(".ct__go")!;
    const label = btn.textContent;
    btn.disabled = true; btn.textContent = "Saving…";
    // open the new tab now (inside the click) so pop-up blockers allow it
    const win = mode === "pdf" || window.matchMedia("(pointer: fine)").matches ? window.open("", "_blank") : null;
    const trip = tripNow();
    const r = await fetch("/api/planner/lead", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ name: v("name"), phone, email: v("email"), website: v("website"), trip, source: mode }) })
      .then(async (x) => ({ ok: x.ok, d: await x.json().catch(() => ({})) })).catch(() => ({ ok: false, d: { network: true } as any }));
    btn.disabled = false; btn.textContent = label;
    if (!r.ok && (mode === "pdf" || !r.d.network)) { win?.close(); err.textContent = r.d.error || "We couldn't save your details. Please check your connection and try again."; return; }
    store.set("gd_name", v("name")); store.set("gd_phone", phone); store.set("gd_email", v("email"));
    if (r.d.ref && r.d.token) lastLead = { key: JSON.stringify(trip), ref: r.d.ref, token: r.d.token };
    const url = mode === "pdf"
      ? pdfUrl(r.d.ref, r.d.token)
      : `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(waText(lastTotal || undefined, v("name"), r.d.ref))}`;
    $<HTMLDialogElement>("[data-contact]").close();
    if (win) win.location.href = url; else window.location.href = url;
  }
  const mini = (html: string) => { $("[data-mini]").innerHTML = html; };
  function update() {
    renderPeople(); renderTrip(); renderSteps();
    const send = $<HTMLButtonElement>("[data-send]");
    const price = $("[data-price]");
    const ready = st.date && st.category && st.stops.length;
    lastTotal = 0;
    $("[data-pdf]").setAttribute("aria-disabled", "true");
    if (!ready) {
      const w = !st.date ? "Choose your arrival date" : !st.category ? "Choose your safari style" : "Choose where you'd like to go";
      price.innerHTML = `<p class="sum__wait">${w} to see your price.</p>`;
      mini(`<span class="sum__mt">${w}</span>`);
      send.setAttribute("aria-disabled", "true");
      return;
    }
    const left = safariNights() - used();
    if (left !== 0) {
      mini(`<span class="sum__mt">${left > 0 ? `${left} night${left > 1 ? "s" : ""} still to place` : `${-left} night${left < -1 ? "s" : ""} too many`}</span>`);
      price.innerHTML = `<p class="sum__wait">${left > 0 ? `${left} safari night${left > 1 ? "s" : ""} still to place. Add a night to an area, or add another area.` : `That's ${-left} night${left < -1 ? "s" : ""} too many. Remove a night, or add nights in step 2.`}</p>`;
      send.setAttribute("aria-disabled", "true");
      return;
    }
    clearTimeout(timer);
    price.classList.add("is-loading");
    timer = window.setTimeout(async () => {
      const my = ++seq;
      const body = { startDate: st.date, adults: st.adults, childAges: st.ages, category: st.category, totalNights: st.nights, stops: st.stops };
      const r = await fetch("/api/planner/quote", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) }).then((x) => x.json()).catch(() => null);
      if (my !== seq) return;
      price.classList.remove("is-loading");
      if (!r) { price.innerHTML = `<p class="sum__wait">We couldn't work out the price just now. Send us your itinerary and we'll price it for you.</p>`; send.removeAttribute("aria-disabled"); return; }
      if (!r.ok) { mini(`<span class="sum__mt">Check your trip</span>`); price.innerHTML = `<ul class="sum__err">${r.errors.map((e: string) => `<li>${esc(e)}</li>`).join("")}</ul>`; send.setAttribute("aria-disabled", "true"); return; }
      const p = r.priced;
      mini(`<span class="sum__ml">Total</span><strong>${usd(p.total)}</strong><span class="sum__mp">${usd(r.perPerson)} pp</span>`);
      price.innerHTML = `<dl class="sum__rows">
          <div><dt>Park fees</dt><dd>${usd(p.park)}</dd></div>
          <div><dt>Vehicle &amp; guide${r.people.vehicles > 1 ? ` (${r.people.vehicles} vehicles)` : ""}</dt><dd>${usd(p.transport)}</dd></div>
          <div><dt>Accommodation</dt><dd>${usd(p.accommodation)}</dd></div>
          <div><dt>Meals</dt><dd>${usd(p.meals)}</dd></div>
          <div><dt>Our margin</dt><dd>${usd(p.margin)}</dd></div>
        </dl>
        <p class="sum__total"><span>Total</span><strong>${usd(p.total)}</strong></p>
        <p class="sum__pp">about ${usd(r.perPerson)} per person${r.people.infants ? `, under-${O.settings.childMinAge}s free` : ""}</p>`;
      lastTotal = p.total;
      send.removeAttribute("aria-disabled");
      $("[data-pdf]").removeAttribute("aria-disabled");
    }, 250);
  }

  function init(o: Opt) {
    O = o;
    const s = O.settings;
    const min = addDays(new Date().toISOString().slice(0, 10), s.leadDays + 1);
    const d = $<HTMLInputElement>("[data-date]");
    d.min = min;
    $("[data-date-note]").textContent = `We need ${s.leadDays} days to prepare, so the earliest arrival is ${nice(min)}.`;
    d.addEventListener("change", () => {
      if (d.value && d.value < min) { d.value = min; flash(`The earliest arrival is ${nice(min)}.`); }
      st.date = d.value; update();
    });
    const n = $<HTMLSelectElement>("[data-nights]");
    st.nights = Math.min(Math.max(st.nights, s.minTotalNights), s.maxTotalNights);
    n.innerHTML = Array.from({ length: s.maxTotalNights - s.minTotalNights + 1 }, (_, i) => s.minTotalNights + i)
      .map((v) => `<option value="${v}" ${v === st.nights ? "selected" : ""}>${v} nights (${v + 1} days)</option>`).join("");
    n.addEventListener("change", () => {
      st.nights = Number(n.value);
      // trim stops from the end if the trip got shorter
      while (used() > safariNights() && st.stops.length) {
        const last = st.stops[st.stops.length - 1];
        const a = O.areas.find((x) => x.id === last.areaId)!;
        if (last.nights > a.minNights) last.nights--; else st.stops.pop();
      }
      renderWhere(); update();
    });
    $("[data-arrival-name]").textContent = O.arrivalName;
    root.querySelectorAll<HTMLButtonElement>("[data-inc],[data-dec]").forEach((b) => b.addEventListener("click", () => {
      const k = b.dataset.inc || b.dataset.dec;
      const up = !!b.dataset.inc;
      const total = st.adults + st.ages.length;
      if (up && total >= s.maxGuests) return flash(`For groups over ${s.maxGuests}, message us and we'll plan it with you.`);
      if (k === "adults") st.adults = Math.max(1, st.adults + (up ? 1 : -1));
      else if (up) st.ages.push(8); else st.ages.pop();
      update();
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((b) => b.addEventListener("click", () => {
      const n = Number(b.dataset.open);
      if (n <= st.reached && st.open !== n) openStep(n, true);
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-next]").forEach((b) => b.addEventListener("click", () => openStep(Number(b.dataset.next), true)));
    const box = $("[data-sum-box]"), tog = $("[data-sum-toggle]");
    $("[data-send]").addEventListener("click", () => openContact("whatsapp"));
    $("[data-pdf]").addEventListener("click", () => openContact("pdf"));
    $("[data-contact-form]").addEventListener("submit", submitContact);
    $("[data-ct-close]").addEventListener("click", () => $<HTMLDialogElement>("[data-contact]").close());
    $<HTMLDialogElement>("[data-contact]").addEventListener("click", (e) => { if (e.target === e.currentTarget) (e.currentTarget as HTMLDialogElement).close(); });
    tog.addEventListener("click", () => { const o = !box.classList.contains("is-open"); box.classList.toggle("is-open", o); tog.setAttribute("aria-expanded", String(o)); });
    renderStyles(); renderWhere(); update();
  }

  fetch("/api/planner/options").then((r) => (r.ok ? r.json() : Promise.reject(r.status))).then(init).catch(() => {
    root.querySelector<HTMLElement>(".pl__grid")!.hidden = true;
    root.querySelector<HTMLElement>("[data-fallback]")!.hidden = false;
  });
</script>

