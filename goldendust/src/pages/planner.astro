---
import Base from "../layouts/Base.astro";
import WaButton from "../components/WaButton.astro";
---
<Base
  title="Safari Itinerary Planner | Golden Dust Safaris"
  description="Plan your Tanzania safari itinerary with Golden Dust Safaris. Our online planner is on its way; until then, our team in Arusha plans every trip with you on WhatsApp."
  noindex
>
  <section class="section">
    <div class="wrap measure">
      <h1>Safari itinerary planner</h1>
      <p class="lede">Our online planner is on its way. Soon you'll be able to pick parks, dates and comfort level and see your itinerary take shape.</p>
      <p>Until then, our team in Arusha plans every safari with you directly. Tell us your dates, group size, budget and the animals you most want to see, and we'll send you a day-by-day plan with a full cost breakdown.</p>
      <WaButton label="Plan my safari on WhatsApp" />
    </div>
  </section>
</Base>
