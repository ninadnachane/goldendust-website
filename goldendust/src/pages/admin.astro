---
// Planner admin: edit every rate, save versions, and test quotes with a full calculation.
// Protected by the Worker (password). Rates are loaded from /api/admin/config, never baked into this page.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Planner admin | Golden Dust Safaris</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="top">
    <div class="top__brand"><img src="/images/logo-header.webp" alt="" width="104" height="51" /><span>Planner admin</span></div>
    <div class="top__status" data-status>Loading…</div>
    <div class="top__who"><span data-who></span> <button type="button" class="linkbtn" data-logout>Sign out</button> <button type="button" class="linkbtn" data-logout-all title="Ends every signed-in session, on all devices">Sign out everywhere</button></div>
    <div class="top__save">
      <input type="text" data-note placeholder="What changed? (e.g. 2027 park fees)" aria-label="Note for this save" />
      <button type="button" class="btn btn--gold" data-save disabled>Save changes</button>
    </div>
  </header>

  <nav class="tabs" role="tablist" data-tabs>
    <button role="tab" data-tab="leads" aria-selected="true">Leads</button>
    <button role="tab" data-tab="test" aria-selected="false">Test calculator</button>
    <button role="tab" data-tab="costs">Costs &amp; rules</button>
    <button role="tab" data-tab="parks">Park fees</button>
    <button role="tab" data-tab="areas">Areas</button>
    <button role="tab" data-tab="lodges">Lodges &amp; camps</button>
    <button role="tab" data-tab="history">History</button>
  </nav>

  <div class="issues" data-issues hidden></div>

  <main class="panes">
    <section class="pane" data-pane="leads">
      <div class="leads__bar"><h2>Itineraries sent by guests</h2>
        <label>Show<select data-lead-filter><option value="">All</option><option value="new">New</option><option value="contacted">Contacted</option><option value="booked">Booked</option><option value="lost">Lost</option></select></label>
        <button type="button" class="btn btn--ghost sm" data-lead-csv>Download CSV</button></div>
      <p class="hint">Every guest who taps "Send my itinerary on WhatsApp" or "Download as PDF" is saved here, even if they never press send in WhatsApp. Prices are what the planner showed at that moment.</p>
      <div data-leads>Loading…</div>
    </section>

    <section class="pane" data-pane="test" hidden>
      <div class="test">
        <form class="test__form" data-test-form>
          <h2>Trip</h2>
          <div class="grid2">
            <label>Arrival date<input type="date" name="startDate" /></label>
            <label>Total nights<input type="number" name="totalNights" min="1" value="5" /></label>
            <label>Adults<input type="number" name="adults" min="1" value="2" /></label>
            <label>Children's ages<input type="text" name="childAges" placeholder="e.g. 8, 3" /></label>
          </div>
          <div class="test__addons" data-test-addons></div>
          <label class="check"><input type="checkbox" name="ignoreLead" checked /> Ignore the minimum-notice rule while testing</label>
          <h3>Itinerary <small data-nights-left></small></h3>
          <div data-stops></div>
          <button type="button" class="btn btn--ghost" data-add-stop>+ Add area</button>
          <p class="hint">The test uses the rates on screen, including unsaved changes.</p>
        </form>
        <div class="test__out" data-test-out></div>
      </div>
    </section>

    <section class="pane" data-pane="costs" hidden>
      <h2>Daily costs, markup and rules</h2>
      <div class="cards" data-settings></div>
      <h2>Add-ons</h2>
      <p class="hint">Optional extras guests can tick in the planner. Prices include VAT. Add-ons get no margin. "Park fee" add-ons get no admin fee; the others get the add-on admin fee (Costs above). The crater drive also adds a Ngorongoro entry day when the trip doesn't already stay in the conservation area.</p>
      <div data-addons-t></div>
      <h2>Arusha arrival night</h2>
      <p class="hint">Every trip starts with one night in Arusha, included. The price uses the fixed Arusha rate above, whichever hotel it is. Pick the hotel shown for each category (add Arusha hotels in "Lodges &amp; camps" with area "Arusha").</p>
      <div class="cards" data-arrival></div>
      <h2>Itinerary PDF text</h2>
      <p class="hint">Printed on every itinerary PDF. One item per line.</p>
      <div class="doctext" data-doctext></div>
    </section>

    <section class="pane" data-pane="parks" hidden>
      <h2>Park fees</h2>
      <p class="hint">USD, <strong>including VAT</strong>, peak-season rates. Entry is charged for each day (= night) in a park. Overnight: Budget trips pay the public campsite fee; Comfort/Luxury pay the concession fee only for lodges marked "Inside park" (Lodges &amp; camps). Driving between the east (Arusha, Tarangire, Manyara) and the Serengeti without a night in the Ngorongoro area adds one NCA entry day per crossing. Children younger than the minimum age are free.</p>
      <div data-zones></div>
    </section>

    <section class="pane" data-pane="areas" hidden>
      <h2>Areas guests can choose</h2>
      <p class="hint">Listed in route order: the planner sorts a guest's stops in this order. "Vehicle fee" is charged once per visit, per vehicle (e.g. the Ngorongoro crater descent).</p>
      <div data-areas></div>
    </section>

    <section class="pane" data-pane="lodges" hidden>
      <h2>Lodges &amp; camps</h2>
      <p class="hint">Rates come from your Excel ("List of Lodges and Camps", Rates tab): full board, USD per person per night, double/triple per person sharing. Only rows with "Rates Verified" = Yes are used, Arusha is left out for now, and the year in the dates is ignored (each period repeats every year). A lodge isn't offered for dates without a rate, or when a child is younger than its minimum age. Importing keeps the photos, text and "Inside park" ticks you set here.</p>
      <div class="import">
        <label class="btn">Import Excel…<input type="file" accept=".xlsx" data-import hidden /></label>
        <span class="hint" data-import-msg></span>
      </div>
      <div class="import-out" data-import-out hidden></div>
      <div class="filters">
        <label>Area<select data-lf-area></select></label>
        <label>Category<select data-lf-cat></select></label>
      </div>
      <div data-lodges></div>
    </section>

    <section class="pane" data-pane="history" hidden>
      <h2>Saved versions</h2>
      <p class="hint">Every save is kept. Load an older version to look at it or test it; it only goes live if you save it again.</p>
      <div data-history></div>
    </section>
  </main>

  <dialog class="dlg" data-photo-dlg>
    <form method="dialog" class="dlg__in">
      <div class="dlg__head"><h2 data-pd-title>Photos</h2><button value="close" class="del" aria-label="Close">✕</button></div>
      <label class="dlg__desc">Short description guests see (one or two lines)
        <textarea rows="2" maxlength="220" data-pd-desc placeholder="e.g. Eight tents on a kopje overlooking the Seronera valley, with a pool."></textarea>
      </label>
      <p class="hint">The first photo is the main one in the planner. Photos are resized to 1600 px WebP in your browser before upload. Use your own photos or ones the lodge allows you to use.</p>
      <div class="thumbs" data-pd-thumbs></div>
      <label class="btn btn--ghost upl">+ Add photos<input type="file" accept="image/jpeg,image/png,image/webp" multiple data-pd-file hidden /></label>
      <p class="hint" data-pd-status></p>
    </form>
  </dialog>

  <script>
    import { quote, checkConfig, CATEGORIES, money, addDays, lodgeImages, imageUrl, type Config, type Line, type Lodge } from "../planner/engine";
    import { importLodges } from "../planner/lodgeImport";

    const $ = <T extends HTMLElement = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
    let cfg: Config;
    let dirty = false;
    let meta: { version: number | null; savedAt: string | null; note: string } = { version: null, savedAt: null, note: "" };

    const esc = (s: unknown) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "item";
    const uid = (name: string, taken: { id: string }[]) => { let id = slug(name), i = 2; while (taken.some((t) => t.id === id)) id = `${slug(name)}-${i++}`; return id; };
    const get = (o: any, path: string) => path.split(".").reduce((a, k) => (a == null ? a : a[k]), o);
    const set = (o: any, path: string, v: unknown) => { const ks = path.split("."); const last = ks.pop()!; const t = ks.reduce((a, k) => (a[k] ??= {}), o); t[last] = v; };

    function markDirty() {
      dirty = true;
      $("[data-save]").removeAttribute("disabled");
      renderStatus();
      renderIssues();
      runTest();
    }
    function renderStatus() {
      const v = meta.version ? `Live: version ${meta.version}, saved ${meta.savedAt} UTC` : "Live: sample data (nothing saved yet)";
      $("[data-status]").innerHTML = `${esc(v)}${dirty ? ' · <strong class="warn">Unsaved changes</strong>' : ""}`;
    }
    function renderIssues() {
      const issues = checkConfig(cfg);
      const box = $("[data-issues]");
      box.hidden = !issues.length;
      box.innerHTML = issues.length ? `<strong>Fix before saving:</strong><ul>${issues.map((i) => `<li>${esc(i)}</li>`).join("")}</ul>` : "";
    }

    // ---------- generic table editor
    type Col = { key: string; label: string; type: "text" | "number" | "bool" | "select" | "readonly" | "button"; options?: () => { v: string; t: string }[]; step?: string; group?: string; text?: (r: any) => string; onClick?: (r: any) => void };
    function table(host: HTMLElement, rows: any[], cols: Col[], opts: { add?: () => void; remove?: (r: any) => void; reorder?: boolean; filter?: (r: any) => boolean; rerender: () => void }) {
      const shown = rows.filter((r) => (opts.filter ? opts.filter(r) : true));
      const groups = cols.some((c) => c.group);
      let head = "";
      if (groups) {
        const spans: { g: string; n: number }[] = [];
        cols.forEach((c) => { const g = c.group || ""; const last = spans[spans.length - 1]; if (last && last.g === g) last.n++; else spans.push({ g, n: 1 }); });
        head += `<tr>${opts.reorder ? "<th></th>" : ""}${spans.map((s) => `<th colspan="${s.n}" class="${s.g ? "grp" : ""}">${esc(s.g)}</th>`).join("")}<th></th></tr>`;
      }
      head += `<tr>${opts.reorder ? "<th></th>" : ""}${cols.map((c) => `<th>${esc(c.label)}</th>`).join("")}<th></th></tr>`;
      const body = shown.map((r) => {
        const i = rows.indexOf(r);
        const cells = cols.map((c) => {
          const v = get(r, c.key);
          if (c.type === "readonly") return `<td class="ro">${esc(v)}</td>`;
          if (c.type === "button") return `<td><button type="button" class="btn btn--ghost sm" data-btn="${i}" data-col="${c.key}">${esc(c.text!(r))}</button></td>`;
          if (c.type === "bool") return `<td class="c"><input type="checkbox" data-i="${i}" data-k="${c.key}" ${v ? "checked" : ""}></td>`;
          if (c.type === "select") return `<td><select data-i="${i}" data-k="${c.key}">${c.options!().map((o) => `<option value="${esc(o.v)}" ${o.v === v ? "selected" : ""}>${esc(o.t)}</option>`).join("")}</select></td>`;
          if (c.type === "number") return `<td><input type="number" step="${c.step || "0.01"}" min="0" data-i="${i}" data-k="${c.key}" value="${v ?? 0}"></td>`;
          return `<td><input type="text" data-i="${i}" data-k="${c.key}" value="${esc(v)}"></td>`;
        }).join("");
        const move = opts.reorder ? `<td class="mv"><button type="button" data-up="${i}" aria-label="Move up">↑</button><button type="button" data-down="${i}" aria-label="Move down">↓</button></td>` : "";
        return `<tr>${move}${cells}<td>${opts.remove ? `<button type="button" class="del" data-del="${i}" aria-label="Delete">✕</button>` : ""}</td></tr>`;
      }).join("");
      host.innerHTML = `<div class="tbl"><table><thead>${head}</thead><tbody>${body || `<tr><td colspan="${cols.length + 2}" class="empty">Nothing here yet.</td></tr>`}</tbody></table></div>${opts.add ? '<button type="button" class="btn btn--ghost" data-add>+ Add row</button>' : ""}`;
      host.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-k]").forEach((el) => {
        el.addEventListener("change", () => {
          const col = cols.find((c) => c.key === el.dataset.k)!;
          const row = rows[Number(el.dataset.i)];
          const val = col.type === "bool" ? (el as HTMLInputElement).checked : col.type === "number" ? Number(el.value) || 0 : el.value;
          set(row, col.key, val);
          markDirty();
          if (col.type === "select" || col.type === "bool") opts.rerender();
        });
      });
      host.querySelectorAll<HTMLButtonElement>("[data-btn]").forEach((b) => b.addEventListener("click", () => cols.find((c) => c.key === b.dataset.col)!.onClick!(rows[Number(b.dataset.btn)])));
      host.querySelector("[data-add]")?.addEventListener("click", () => { opts.add!(); markDirty(); opts.rerender(); });
      host.querySelectorAll<HTMLButtonElement>("[data-del]").forEach((b) => b.addEventListener("click", () => {
        const r = rows[Number(b.dataset.del)];
        if (!confirm(`Delete "${r.name || r.id}"? You can still undo by not saving.`)) return;
        opts.remove!(r); markDirty(); opts.rerender();
      }));
      const swap = (i: number, j: number) => { if (j < 0 || j >= rows.length) return; [rows[i], rows[j]] = [rows[j], rows[i]]; markDirty(); opts.rerender(); };
      host.querySelectorAll<HTMLButtonElement>("[data-up]").forEach((b) => b.addEventListener("click", () => swap(Number(b.dataset.up), Number(b.dataset.up) - 1)));
      host.querySelectorAll<HTMLButtonElement>("[data-down]").forEach((b) => b.addEventListener("click", () => swap(Number(b.dataset.down), Number(b.dataset.down) + 1)));
    }

    // ---------- tabs
    function renderSettings() {
      const fields: [keyof Config["settings"], string, string][] = [
        ["vehicleDay", "Vehicle, per vehicle per day ($)", "0.01"],
        ["guideDay", "Guide, per guide per day ($)", "0.01"],
        ["maxPerVehicle", "Max guests per vehicle (adds a vehicle + guide above this)", "1"],
        ["vehicleDaysExtra", "Vehicle/guide days = safari nights + …", "1"],
        ["arushaNightAdult", "Arusha arrival night, fixed rate per adult ($)", "0.01"],
        ["arushaNightChild", "Arusha arrival night, fixed rate per child ($)", "0.01"],
        ["airportTransfer", "Airport pick-up and drop-off, per booking ($)", "0.01"],
        ["firstLunchAdult", "First-day lunch, per adult ($)", "0.01"],
        ["firstLunchChild", "First-day lunch, per child ($)", "0.01"],
        ["adminPct", "Admin fee % (on everything except park fees)", "0.1"],
        ["marginPct", "Margin % (on the total incl. admin fee, not on add-ons)", "0.1"],
        ["addonAdminPct", "Add-on admin fee % (add-ons get no margin)", "0.1"],
        ["leadDays", "Guests can't arrive within this many days", "1"],
        ["childMinAge", "Children pay from age (younger = free)", "1"],
        ["childMaxAge", "Children pay child rate up to age", "1"],
        ["minTotalNights", "Minimum total nights (incl. Arusha)", "1"],
        ["maxTotalNights", "Maximum total nights", "1"],
        ["maxGuests", "Maximum guests in the online planner", "1"],
      ];
      const host = $("[data-settings]");
      host.innerHTML = fields.map(([k, label, step]) => `<label class="card">${esc(label)}<input type="number" min="0" step="${step}" data-s="${k}" value="${cfg.settings[k]}"></label>`).join("");
      host.querySelectorAll<HTMLInputElement>("[data-s]").forEach((el) => el.addEventListener("change", () => { (cfg.settings as any)[el.dataset.s!] = Number(el.value) || 0; markDirty(); }));

      const ncaSel = document.createElement("label");
      ncaSel.className = "card";
      ncaSel.innerHTML = `Which park fee zone is the Ngorongoro Conservation Area (for transit and crater days)<select data-nca>${cfg.feeZones.map((z) => `<option value="${esc(z.id)}" ${cfg.settings.ncaZoneId === z.id ? "selected" : ""}>${esc(z.name)}</option>`).join("")}</select>`;
      host.append(ncaSel);
      ncaSel.querySelector("select")!.addEventListener("change", (e) => { cfg.settings.ncaZoneId = (e.target as HTMLSelectElement).value; markDirty(); });

      const dt = $("[data-doctext]");
      cfg.doc ??= { included: [], excluded: [], payment: "", notes: [] };
      const docFields: [keyof NonNullable<Config["doc"]>, string, number][] = [["included", "Included", 10], ["excluded", "Not included", 7], ["payment", "Payment terms (under the price)", 2], ["notes", "Notes (one paragraph per line)", 4]];
      dt.innerHTML = docFields.map(([k, label, rows]) => { const v = cfg.doc![k]; return `<label class="card">${esc(label)}<textarea rows="${rows}" data-doc="${k}">${esc(Array.isArray(v) ? v.join("\n") : v)}</textarea></label>`; }).join("");
      dt.querySelectorAll<HTMLTextAreaElement>("[data-doc]").forEach((el) => el.addEventListener("change", () => {
        const k = el.dataset.doc as keyof NonNullable<Config["doc"]>;
        (cfg.doc as any)[k] = k === "payment" ? el.value.trim() : el.value.split("\n").map((x) => x.trim()).filter(Boolean);
        markDirty();
      }));

      const ar = $("[data-arrival]");
      const arusha = cfg.lodges.filter((l) => l.areaId === "arusha");
      ar.innerHTML = CATEGORIES.map((c) => `<label class="card">${c.name}<select data-arr="${c.id}">${arusha.map((l) => `<option value="${esc(l.id)}" ${cfg.arrival.lodges[c.id] === l.id ? "selected" : ""}>${esc(l.name)}${l.active ? "" : " (inactive)"}</option>`).join("")}</select></label>`).join("");
      ar.querySelectorAll<HTMLSelectElement>("[data-arr]").forEach((el) => el.addEventListener("change", () => { (cfg.arrival.lodges as any)[el.dataset.arr!] = el.value; markDirty(); }));
    }

    function renderAddons() {
      cfg.addons ??= [];
      table($("[data-addons-t]"), cfg.addons, [
        { key: "name", label: "Add-on", type: "text" },
        { key: "blurb", label: "Short description (shown to guests)", type: "text" },
        { key: "per", label: "Charged per", type: "select", options: () => [{ v: "person", t: "Person" }, { v: "vehicle", t: "Vehicle" }, { v: "booking", t: "Booking" }] },
        { key: "price", label: "Price / adult ($)", type: "number", step: "0.01" },
        { key: "childPrice", label: "Price / child ($)", type: "number", step: "0.01" },
        { key: "parkFee", label: "Park fee (no admin fee)", type: "bool" },
        { key: "active", label: "Offered", type: "bool" },
        { key: "id", label: "ID", type: "readonly" },
      ], {
        rerender: () => { renderAddons(); renderTestAddons(); runTest(); },
        add: () => cfg.addons!.push({ id: uid("new add-on", cfg.addons!), name: "New add-on", blurb: "", per: "person", price: 0, childPrice: 0, parkFee: false, active: false }),
        remove: (r) => { if (r.id === "crater") return alert("The crater drive is built in. Untick \"Offered\" to hide it."); cfg.addons = cfg.addons!.filter((a) => a !== r); },
      });
      $("[data-addons-t]").onchange = () => { renderTestAddons(); runTest(); };
    }

    function renderTestAddons() {
      const host = $("[data-test-addons]");
      const was = new Set([...host.querySelectorAll<HTMLInputElement>("[data-ta]:checked")].map((x) => x.value));
      const list = (cfg.addons || []).filter((a) => a.active);
      host.innerHTML = list.length ? `<p class="lbl">Add-ons</p>${list.map((a) => `<label class="check"><input type="checkbox" data-ta value="${esc(a.id)}" ${was.has(a.id) ? "checked" : ""} /> ${esc(a.name)} <small>(${money(a.price)} per ${a.per})</small></label>`).join("")}` : "";
    }

    function renderZones() {
      table($("[data-zones]"), cfg.feeZones, [
        { key: "name", label: "Park / fee zone", type: "text" },
        { key: "adultDay", label: "Adult", type: "number", group: "Entry, per day" },
        { key: "childDay", label: "Child", type: "number", group: "Entry, per day" },
        { key: "concessionAdult", label: "Adult", type: "number", group: "Concession: lodge inside park, per night" },
        { key: "concessionChild", label: "Child", type: "number", group: "Concession: lodge inside park, per night" },
        { key: "campAdult", label: "Adult", type: "number", group: "Public campsite (Budget), per night" },
        { key: "campChild", label: "Child", type: "number", group: "Public campsite (Budget), per night" },
        { key: "vehicleDay", label: "Per vehicle / day", type: "number", group: "Vehicle entry" },
        { key: "id", label: "ID", type: "readonly" },
      ], {
        rerender: renderZones,
        add: () => cfg.feeZones.push({ id: uid("new park", cfg.feeZones), name: "New park", adultDay: 0, childDay: 0, concessionAdult: 0, concessionChild: 0, campAdult: 0, campChild: 0, vehicleDay: 0 }),
        remove: (r) => { if (cfg.areas.some((a) => a.feeZoneId === r.id)) return alert("An area still uses this fee zone."); cfg.feeZones = cfg.feeZones.filter((z) => z !== r); },
      });
    }

    function renderAreas() {
      table($("[data-areas]"), cfg.areas, [
        { key: "name", label: "Area", type: "text" },
        { key: "feeZoneId", label: "Park fees from", type: "select", options: () => [...cfg.feeZones.map((z) => ({ v: z.id, t: z.name })), { v: "", t: "None (outside the parks)" }] },
        { key: "side", label: "Side of the map", type: "select", options: () => [{ v: "east", t: "East (Arusha side)" }, { v: "nca", t: "Ngorongoro area (NCA)" }, { v: "west", t: "West (Serengeti)" }] },
        { key: "minNights", label: "Min nights", type: "number", step: "1" },
        { key: "active", label: "Shown", type: "bool" },
        { key: "blurb", label: "Line on the itinerary PDF", type: "text" },
        { key: "id", label: "ID", type: "readonly" },
      ], {
        reorder: true,
        rerender: () => { renderAreas(); renderLodges(); },
        add: () => cfg.areas.push({ id: uid("new area", cfg.areas), name: "New area", feeZoneId: cfg.feeZones[0]?.id || "", side: "east", minNights: 1, active: false }),
        remove: (r) => { if (cfg.lodges.some((l) => l.areaId === r.id)) return alert("Move or delete this area's lodges first."); cfg.areas = cfg.areas.filter((a) => a !== r); },
      });
    }

    const areaOptions = () => [{ v: "arusha", t: "Arusha (arrival night)" }, ...cfg.areas.map((a) => ({ v: a.id, t: a.name }))];
    function renderLodges() {
      const fa = $<HTMLSelectElement>("[data-lf-area]"), fc = $<HTMLSelectElement>("[data-lf-cat]");
      const keepA = fa.value, keepC = fc.value;
      fa.innerHTML = `<option value="">All areas</option>` + areaOptions().map((o) => `<option value="${esc(o.v)}">${esc(o.t)}</option>`).join("");
      fc.innerHTML = `<option value="">All categories</option>` + CATEGORIES.map((c) => `<option value="${c.id}">${c.name}</option>`).join("");
      fa.value = keepA; fc.value = keepC;
      const cols: Col[] = [
        { key: "name", label: "Name", type: "text" },
        { key: "areaId", label: "Area", type: "select", options: areaOptions },
        { key: "category", label: "Category", type: "select", options: () => CATEGORIES.map((c) => ({ v: c.id, t: c.name })) },
        { key: "active", label: "Shown", type: "bool" },
        { key: "insidePark", label: "Inside park", type: "bool" },
        { key: "minChildAge", label: "Min. child age", type: "number", step: "1" },
        { key: "periods", label: "Rates (per person per night)", type: "button", text: (r) => ratesSummary(r), onClick: openRates },
        { key: "photos", label: "Photos & text", type: "button", text: (r) => { const up = (r.images || []).length, n = lodgeImages(r).length; return `${up ? `${up} uploaded` : n ? `${n} from folder` : "0 photos"}${r.description ? " · text" : ""}`; }, onClick: openPhotos },
      ];
      table($("[data-lodges]"), cfg.lodges, cols, {
        rerender: () => { renderLodges(); renderSettings(); },
        filter: (r) => (!fa.value || r.areaId === fa.value) && (!fc.value || r.category === fc.value),
        add: () => {
          const areaId = fa.value || cfg.areas[0]?.id || "arusha";
          const category = (fc.value || "comfort") as any;
          cfg.lodges.push({ id: uid(`${areaId}-${category}-lodge`, cfg.lodges), name: "New lodge", areaId, category, active: true, periods: [] });
        },
        remove: (r) => { if (Object.values(cfg.arrival.lodges).includes(r.id)) return alert("This hotel is used for the Arusha arrival night. Pick another one first (Costs & rules)."); cfg.lodges = cfg.lodges.filter((l) => l !== r); },
      });
    }

    const ratesSummary = (l: Lodge) => {
      const ps = l.periods || [];
      if (!ps.length) return "No rates";
      const low = Math.min(...ps.map((p) => p.double));
      return `${ps.length} period${ps.length > 1 ? "s" : ""} · from ${money(Math.round(low))} pp`;
    };
    function openRates(l: Lodge) {
      const d = document.createElement("dialog");
      d.className = "dlg";
      const ps = (l.periods || []).slice().sort((a, b) => a.from.localeCompare(b.from));
      d.innerHTML = `<div class="dlg__in"><h3>${esc(l.name)}</h3><p class="hint">From the Excel import. USD per person per night, full board. Dates are MM-DD and repeat every year.</p>
        <div class="tbl"><table><thead><tr><th>Season</th><th>From</th><th>To</th><th class="n">Single</th><th class="n">Double pp</th><th class="n">Triple pp</th><th class="n">Child</th></tr></thead><tbody>${
          ps.map((p) => `<tr><td>${esc(p.season)}</td><td>${esc(p.from)}</td><td>${esc(p.to)}</td><td class="n">${money(p.single)}</td><td class="n">${money(p.double)}</td><td class="n">${p.triple ? money(p.triple) : "–"}</td><td class="n">${money(p.child)}</td></tr>`).join("") || '<tr><td colspan="7" class="empty">No rates. Add this lodge to the Excel and import it.</td></tr>'
        }</tbody></table></div>${l.minChildAge ? `<p class="hint">Children from ${l.minChildAge} years only.</p>` : ""}<p><button type="button" class="btn" data-x>Close</button></p></div>`;
      d.querySelector("[data-x]")!.addEventListener("click", () => d.close());
      d.addEventListener("close", () => d.remove());
      document.body.append(d); d.showModal();
    }

    async function importExcel(file: File) {
      const msg = $("[data-import-msg]"), out = $("[data-import-out]");
      msg.textContent = "Reading…"; out.hidden = true;
      try {
        const { readSheet } = await import("read-excel-file/browser");
        const rows = await readSheet(file, "Rates");
        const { lodges, report } = importLodges(cfg, rows as unknown[][]);
        cfg.lodges = lodges; markDirty(); renderAll();
        const li = (xs: string[]) => xs.map((x) => `<li>${esc(x)}</li>`).join("");
        msg.textContent = "";
        out.innerHTML = `<p><strong>Imported ${report.lodges} lodges with ${report.periods} rate periods.</strong> Check them below, then press "Save changes" to put them live.</p>
          <p class="hint">Skipped ${report.skippedUnverified} unverified row${report.skippedUnverified === 1 ? "" : "s"}${report.skippedArusha ? ` and ${report.skippedArusha} Arusha row${report.skippedArusha === 1 ? "" : "s"}` : ""}.</p>
          ${report.added.length ? `<p>New: ${report.added.map(esc).join(", ")}</p>` : ""}
          ${report.unknownAreas.length ? `<div class="err">Areas not in the planner (rows skipped): ${report.unknownAreas.map(esc).join(", ")}. Add them in Areas first, then import again.</div>` : ""}
          ${report.deactivated.length ? `<p>Switched off (no longer verified in the Excel, photos kept): ${report.deactivated.map(esc).join(", ")}</p>` : ""}
          ${report.removed.length ? `<p>Removed (not in the Excel): ${report.removed.map(esc).join(", ")}</p>` : ""}
          ${report.warnings.length ? `<ul class="warn">${li(report.warnings)}</ul>` : ""}`;
        out.hidden = false;
      } catch (e) {
        msg.textContent = "";
        out.innerHTML = `<div class="err">Couldn't read that file: ${esc((e as Error).message)}</div>`; out.hidden = false;
      }
    }

    async function renderHistory() {
      const host = $("[data-history]");
      host.textContent = "Loading…";
      const r = await fetch("/api/admin/versions").then((x) => x.json()).catch(() => ({ versions: [] }));
      const vs = r.versions as { id: number; created_at: string; note: string }[];
      host.innerHTML = `<div class="tbl"><table><thead><tr><th>Version</th><th>Saved (UTC)</th><th>Note</th><th></th></tr></thead><tbody>${
        vs.map((v) => `<tr><td>${v.id}${v.id === meta.version ? " (live)" : ""}</td><td>${esc(v.created_at)}</td><td>${esc(v.note)}</td><td><button type="button" class="btn btn--ghost sm" data-load="${v.id}">Load</button></td></tr>`).join("") ||
        '<tr><td colspan="4" class="empty">Nothing saved yet. The planner is using the sample data.</td></tr>'
      }</tbody></table></div><button type="button" class="btn btn--ghost" data-load-defaults>Load the sample data</button>`;
      const load = async (u: string) => {
        if (dirty && !confirm("Discard your unsaved changes?")) return;
        const d = await fetch(u).then((x) => x.json());
        cfg = d.config; dirty = true; $("[data-save]").removeAttribute("disabled"); renderAll();
      };
      host.querySelectorAll<HTMLButtonElement>("[data-load]").forEach((b) => b.addEventListener("click", () => load(`/api/admin/versions/${b.dataset.load}`)));
      host.querySelector("[data-load-defaults]")!.addEventListener("click", () => load("/api/admin/defaults"));
    }

    // ---------- test calculator
    type Stop = { areaId: string; nights: number; lodgeId: string };
    let stops: Stop[] = [];
    const form = () => $<HTMLFormElement>("[data-test-form]");
    const catRank = (c: string) => CATEGORIES.findIndex((x) => x.id === c);
    const catLabel = (c: string) => CATEGORIES.find((x) => x.id === c)?.name ?? c;
    function lodgesFor(areaId: string) { return cfg.lodges.filter((l) => l.areaId === areaId && l.active).sort((a, b) => catRank(a.category) - catRank(b.category)); }
    function renderStops() {
      const host = $("[data-stops]");
      host.innerHTML = stops.map((s, i) => {
        const lodges = lodgesFor(s.areaId);
        if (!lodges.some((l) => l.id === s.lodgeId)) s.lodgeId = lodges[0]?.id || "";
        return `<div class="stop">
          <select data-st="${i}" data-f="areaId">${cfg.areas.map((a) => `<option value="${esc(a.id)}" ${a.id === s.areaId ? "selected" : ""}>${esc(a.name)}${a.active ? "" : " (hidden)"}</option>`).join("")}</select>
          <input type="number" min="1" data-st="${i}" data-f="nights" value="${s.nights}" aria-label="Nights">
          <select data-st="${i}" data-f="lodgeId">${lodges.map((l) => `<option value="${esc(l.id)}" ${l.id === s.lodgeId ? "selected" : ""}>[${esc(catLabel(l.category))}] ${esc(l.name)}</option>`).join("") || '<option value="">No lodge in this area</option>'}</select>
          <button type="button" class="del" data-rm="${i}" aria-label="Remove">✕</button></div>`;
      }).join("");
      host.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-st]").forEach((el) => el.addEventListener("change", () => {
        const s = stops[Number(el.dataset.st)];
        (s as any)[el.dataset.f!] = el.dataset.f === "nights" ? Number(el.value) || 0 : el.value;
        renderStops(); runTest();
      }));
      host.querySelectorAll<HTMLButtonElement>("[data-rm]").forEach((b) => b.addEventListener("click", () => { stops.splice(Number(b.dataset.rm), 1); renderStops(); runTest(); }));
    }

    const groupNames: Record<string, string> = { park: "Park fees (no admin fee)", transport: "Vehicle, guide & transfers", accommodation: "Accommodation", meals: "Meals", extras: "Add-ons" };
    function runTest() {
      if (!cfg) return;
      const f = form();
      const v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;
      const ages = v("childAges").split(/[,\s]+/).filter(Boolean).map(Number);
      const totalNights = Number(v("totalNights")) || 0;
      const used = stops.reduce((a, s) => a + s.nights, 0);
      $("[data-nights-left]").textContent = `· ${used} of ${Math.max(0, totalNights - 1)} safari nights assigned`;
      const req = { startDate: v("startDate"), adults: Number(v("adults")) || 0, childAges: ages, totalNights, stops, addons: [...f.querySelectorAll<HTMLInputElement>("[data-ta]:checked")].map((x) => x.value) };
      const today = (f.elements.namedItem("ignoreLead") as HTMLInputElement).checked ? "1970-01-01" : undefined;
      const q = quote(cfg, req, today);
      const out = $("[data-test-out]");
      const p = q.people;
      const errs = q.errors.length ? `<div class="err"><strong>The guest would see:</strong><ul>${q.errors.map((e) => `<li>${esc(e)}</li>`).join("")}</ul></div>` : "";
      if (!q.lines.length) { out.innerHTML = errs || '<p class="hint">Fill in the trip to see the calculation.</p>'; return; }
      const groups = ["park", "transport", "accommodation", "meals", "extras"].map((g) => {
        const ls = q.lines.filter((l: Line) => l.group === g);
        if (g === "extras" && !ls.length) return "";
        const sub = ls.reduce((a, l) => a + l.cost, 0);
        return `<tbody><tr class="gh"><th colspan="2">${groupNames[g]}</th><th class="n">${money(sub)}</th></tr>${ls.map((l) => `<tr><td>${esc(l.label)}</td><td class="calc">${esc(l.calc)}</td><td class="n">${money(l.cost)}</td></tr>`).join("")}</tbody>`;
      }).join("");
      const t = q.totals, s = cfg.settings;
      out.innerHTML = `${errs}
        <div class="who">${p.adults} adult${p.adults === 1 ? "" : "s"} · ${p.children} child${p.children === 1 ? "" : "ren"} (${s.childMinAge}–${s.childMaxAge}) · ${p.infants} under ${s.childMinAge} (free) · ${p.vehicles} vehicle${p.vehicles > 1 ? "s" : ""} &amp; ${p.guides} guide${p.guides > 1 ? "s" : ""} · ${totalNights} nights from ${esc(req.startDate)} to ${esc(req.startDate ? addDays(req.startDate, totalNights) : "")}</div>
        <h2>1. Your costs, line by line</h2>
        <div class="tbl"><table class="calc-t"><thead><tr><th>Item</th><th>Calculation</th><th class="n">Cost</th></tr></thead>${groups}</table></div>
        <h2>2. From cost to price</h2>
        <table class="sum">
          <tr><td>Park fees (no admin fee)</td><td class="calc"></td><td class="n">${money(t.park)}</td></tr>
          <tr><td>Everything else</td><td class="calc">${money(t.transport)} vehicle &amp; guide + ${money(t.accommodation)} accommodation + ${money(t.meals)} meals</td><td class="n">${money(t.others)}</td></tr>
          <tr><td>Admin fee ${s.adminPct}%</td><td class="calc">${money(t.others)} × ${s.adminPct}%</td><td class="n">${money(t.adminFee)}</td></tr>
          <tr class="line"><td>Subtotal</td><td class="calc">${money(t.park)} + ${money(t.others)} + ${money(t.adminFee)}</td><td class="n">${money(t.subtotal)}</td></tr>
          <tr><td>Margin ${s.marginPct}%</td><td class="calc">${money(t.subtotal)} × ${s.marginPct}%</td><td class="n">${money(t.margin)}</td></tr>
          ${t.extras ? `<tr><td>Add-ons (no margin)</td><td class="calc">${money(t.extras)} + admin fee ${s.addonAdminPct ?? 2}% ${money(t.addonFee)} (park-fee add-ons excluded)</td><td class="n">${money(t.extrasTotal)}</td></tr>` : ""}
          <tr class="total"><td>Price to guest</td><td class="calc">${money(t.perPerson)} per paying person (${p.adults + p.children})</td><td class="n">${money(t.total)}</td></tr>
        </table>
        <h2>3. What the guest sees</h2>
        <table class="sum">
          <tr><td>Park fees</td><td class="n">${money(q.priced.park)}</td></tr>
          <tr><td>Vehicle, guide &amp; transfers</td><td class="n">${money(q.priced.transport)}</td></tr>
          <tr><td>Accommodation</td><td class="n">${money(q.priced.accommodation)}</td></tr>
          <tr><td>Meals</td><td class="n">${money(q.priced.meals)}</td></tr>
          ${q.priced.extras ? `<tr><td>Add-ons</td><td class="n">${money(q.priced.extras)}</td></tr>` : ""}
          <tr><td>Margin</td><td class="n">${money(q.priced.margin)}</td></tr>
          <tr class="total"><td>Total</td><td class="n">${money(q.priced.total)}</td></tr>
        </table>
        <p class="hint">Admin fees are included in vehicle &amp; guide, accommodation, and meals. Add-ons carry only their own admin fee (none on park-fee add-ons) and no margin. Accommodation absorbs any 1-cent rounding so the guest's total always adds up.</p>`;
    }

    function initTest() {
      const f = form();
      (f.elements.namedItem("startDate") as HTMLInputElement).value = addDays(new Date().toISOString().slice(0, 10), cfg.settings.leadDays + 1);
      const pick = (id: string, n: number) => cfg.areas.some((a) => a.id === id) && stops.push({ areaId: id, nights: n, lodgeId: "" });
      pick("tarangire", 1); pick("central-serengeti", 2); pick("ngorongoro", 1);
      if (!stops.length && cfg.areas[0]) stops.push({ areaId: cfg.areas[0].id, nights: 1, lodgeId: "" });
      f.addEventListener("input", () => { renderStops(); runTest(); });
      f.addEventListener("submit", (e) => e.preventDefault());
      $("[data-add-stop]").addEventListener("click", () => {
        const next = cfg.areas.find((a) => !stops.some((s) => s.areaId === a.id));
        if (next) stops.push({ areaId: next.id, nights: next.minNights, lodgeId: "" });
        renderStops(); runTest();
      });
    }

    // ---------- leads
    type Lead = { id: number; ref: string; created_at: string; name: string; phone: string; email: string | null; summary: string; total: number | null; status: string; notes: string; source?: string };
    let leads: Lead[] = [];
    async function loadLeads() {
      const host = $("[data-leads]");
      host.textContent = "Loading…";
      const r = await fetch("/api/admin/leads");
      if (r.status === 401) { location.replace("/admin/login"); return; }
      leads = (await r.json()).leads || [];
      renderLeads();
    }
    const statuses = ["new", "contacted", "booked", "lost"];
    function renderLeads() {
      const f = $<HTMLSelectElement>("[data-lead-filter]").value;
      const rows = leads.filter((l) => !f || l.status === f);
      const counts = statuses.map((s) => `${leads.filter((l) => l.status === s).length} ${s}`).join(" · ");
      $("[data-leads]").innerHTML = `<p class="hint">${leads.length} total · ${counts}</p><div class="tbl"><table class="leads"><thead><tr><th>Received (UTC)</th><th>Ref</th><th>Guest</th><th>Trip</th><th class="n">Planner price</th><th>Status</th><th>Notes</th><th></th></tr></thead><tbody>${
        rows.map((l) => `<tr data-lead="${l.id}" class="st-${esc(l.status)}">
          <td class="nw">${esc(l.created_at)}</td><td class="nw">${esc(l.ref)}<br><span class="src src--${esc(l.source || "whatsapp")}">${l.source === "pdf" ? "PDF download" : "WhatsApp"}</span></td>
          <td><strong>${esc(l.name)}</strong><br><a href="https://wa.me/${esc(l.phone.replace("+", ""))}" target="_blank" rel="noopener">${esc(l.phone)}</a>${l.email ? `<br><a href="mailto:${esc(l.email)}">${esc(l.email)}</a>` : ""}</td>
          <td class="sm">${esc(l.summary)}</td><td class="n">${l.total != null ? money(l.total) : "–"}</td>
          <td><select data-ls>${statuses.map((s) => `<option ${s === l.status ? "selected" : ""}>${s}</option>`).join("")}</select></td>
          <td><input type="text" data-ln value="${esc(l.notes)}" placeholder="Add a note"></td>
          <td class="nw"><a class="btn btn--ghost sm" href="/itinerary#lead=${l.id}" target="_blank" rel="noopener">PDF</a> <button type="button" class="del" data-ld aria-label="Delete lead">✕</button></td></tr>`).join("") || '<tr><td colspan="8" class="empty">No leads yet.</td></tr>'
      }</tbody></table></div>`;
      const patch = (id: number, body: object) => fetch(`/api/admin/leads/${id}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
      document.querySelectorAll<HTMLElement>("[data-lead]").forEach((tr) => {
        const id = Number(tr.dataset.lead);
        const l = leads.find((x) => x.id === id)!;
        tr.querySelector<HTMLSelectElement>("[data-ls]")!.addEventListener("change", (e) => { l.status = (e.target as HTMLSelectElement).value; patch(id, { status: l.status }); renderLeads(); });
        tr.querySelector<HTMLInputElement>("[data-ln]")!.addEventListener("change", (e) => { l.notes = (e.target as HTMLInputElement).value; patch(id, { notes: l.notes }); });
        tr.querySelector<HTMLButtonElement>("[data-ld]")!.addEventListener("click", async () => {
          if (!confirm(`Delete ${l.name}'s details permanently? (Use this when a guest asks to be removed.)`)) return;
          await fetch(`/api/admin/leads/${id}`, { method: "DELETE" });
          leads = leads.filter((x) => x.id !== id); renderLeads();
        });
      });
    }
    $("[data-lead-filter]").addEventListener("change", renderLeads);
    $("[data-lead-csv]").addEventListener("click", () => {
      const q = (v: unknown) => `"${String(v ?? "").replace(/"/g, '""')}"`;
      const csv = ["Received (UTC),Ref,Came from,Name,WhatsApp,Email,Trip,Planner price (USD),Status,Notes", ...leads.map((l) => [l.created_at, l.ref, l.source === "pdf" ? "PDF download" : "WhatsApp", l.name, l.phone, l.email, l.summary, l.total, l.status, l.notes].map(q).join(","))].join("\n");
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob(["\ufeff" + csv], { type: "text/csv" }));
      a.download = `golden-dust-leads-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });

    // ---------- lodge photos
    let photoLodge: any = null;
    const dlg = $<HTMLDialogElement>("[data-photo-dlg]");
    function openPhotos(l: any) {
      photoLodge = l;
      l.images ??= [];
      $("[data-pd-title]").textContent = l.name;
      $<HTMLTextAreaElement>("[data-pd-desc]").value = l.description || "";
      $("[data-pd-status]").textContent = "";
      renderThumbs();
      dlg.showModal();
    }
    function renderThumbs() {
      const l = photoLodge;
      const folder = l.images.length ? [] : lodgeImages(l);
      if (folder.length) {
        $("[data-pd-thumbs]").innerHTML = `<p class="hint" style="grid-column: 1 / -1; margin: 0">${folder.length} photos from your Google Drive Accommodations folder, shown in the planner. Photos you upload here replace them.</p>` +
          folder.map((id: string, i: number) => `<figure class="thumb${i === 0 ? " is-main" : ""}"><img src="${esc(imageUrl(id))}" alt=""><figcaption>${i === 0 ? "<span>Main</span>" : ""}</figcaption></figure>`).join("");
        return;
      }
      $("[data-pd-thumbs]").innerHTML = l.images.map((id: string, i: number) => `<figure class="thumb${i === 0 ? " is-main" : ""}"><img src="/media/${esc(id)}" alt=""><figcaption>
        ${i === 0 ? "<span>Main</span>" : `<button type="button" data-main="${i}">Make main</button>`}
        <button type="button" data-left="${i}" aria-label="Move left">←</button><button type="button" data-right="${i}" aria-label="Move right">→</button>
        <button type="button" class="rm" data-rmimg="${i}" aria-label="Remove">✕</button></figcaption></figure>`).join("") || '<p class="hint">No photos yet.</p>';
      const mv = (i: number, j: number) => { if (j < 0 || j >= l.images.length) return; [l.images[i], l.images[j]] = [l.images[j], l.images[i]]; changed(); };
      const changed = () => { markDirty(); renderThumbs(); renderLodges(); };
      dlg.querySelectorAll<HTMLButtonElement>("[data-main]").forEach((b) => b.addEventListener("click", () => { const i = Number(b.dataset.main); l.images.unshift(l.images.splice(i, 1)[0]); changed(); }));
      dlg.querySelectorAll<HTMLButtonElement>("[data-left]").forEach((b) => b.addEventListener("click", () => mv(Number(b.dataset.left), Number(b.dataset.left) - 1)));
      dlg.querySelectorAll<HTMLButtonElement>("[data-right]").forEach((b) => b.addEventListener("click", () => mv(Number(b.dataset.right), Number(b.dataset.right) + 1)));
      dlg.querySelectorAll<HTMLButtonElement>("[data-rmimg]").forEach((b) => b.addEventListener("click", () => { l.images.splice(Number(b.dataset.rmimg), 1); changed(); }));
    }
    $<HTMLTextAreaElement>("[data-pd-desc]").addEventListener("change", (e) => { photoLodge.description = (e.target as HTMLTextAreaElement).value.trim(); markDirty(); renderLodges(); });
    async function shrink(file: File): Promise<Blob> {
      const bmp = await createImageBitmap(file);
      const k = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
      const c = document.createElement("canvas");
      c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
      c.getContext("2d")!.drawImage(bmp, 0, 0, c.width, c.height);
      return new Promise((res, rej) => c.toBlob((b) => (b ? res(b) : rej(new Error("resize failed"))), "image/webp", 0.82));
    }
    $<HTMLInputElement>("[data-pd-file]").addEventListener("change", async (e) => {
      const input = e.target as HTMLInputElement;
      const files = [...(input.files || [])];
      const status = $("[data-pd-status]");
      for (const [n, f] of files.entries()) {
        status.textContent = `Uploading ${n + 1} of ${files.length}…`;
        try {
          const blob = await shrink(f);
          const r = await fetch("/api/admin/images", { method: "POST", headers: { "content-type": blob.type || "image/webp" }, body: blob });
          const d = await r.json();
          if (!r.ok) throw new Error(d.error || r.status);
          photoLodge.images.push(d.id);
          markDirty(); renderThumbs(); renderLodges();
        } catch (err) { status.textContent = `${f.name}: ${String((err as Error).message || err)}`; input.value = ""; return; }
      }
      status.textContent = `Uploaded ${files.length} photo${files.length === 1 ? "" : "s"}. Remember to save your changes.`;
      input.value = "";
    });

    function renderAll() {
      renderStatus(); renderIssues(); renderSettings(); renderAddons(); renderTestAddons(); renderZones(); renderAreas(); renderLodges(); renderStops(); runTest();
    }

    // tabs
    document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.addEventListener("click", () => {
      document.querySelectorAll("[data-tab]").forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      document.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== b.dataset.tab));
      if (b.dataset.tab === "history") renderHistory();
      if (b.dataset.tab === "leads") loadLeads();
    }));
    $("[data-lf-area]").addEventListener("change", renderLodges);
    $<HTMLInputElement>("[data-import]").addEventListener("change", (e) => { const f = (e.target as HTMLInputElement).files?.[0]; if (f) importExcel(f); (e.target as HTMLInputElement).value = ""; });
    $("[data-lf-cat]").addEventListener("change", renderLodges);

    $("[data-save]").addEventListener("click", async () => {
      const issues = checkConfig(cfg);
      if (issues.length) return alert("Fix the problems listed at the top first.");
      const btn = $("[data-save]"); btn.setAttribute("disabled", ""); btn.textContent = "Saving…";
      const r = await fetch("/api/admin/config", { method: "PUT", headers: { "content-type": "application/json" }, body: JSON.stringify({ config: cfg, note: $<HTMLInputElement>("[data-note]").value }) });
      const d = await r.json().catch(() => ({}));
      btn.textContent = "Save changes";
      if (r.status === 401) { btn.removeAttribute("disabled"); return alert("Your session has ended. Copy anything important, then sign in again in a new tab and save from there."); }
      if (!r.ok || !d.ok) { btn.removeAttribute("disabled"); return alert("Not saved: " + (d.issues || [d.error || r.status]).join("\n")); }
      const cur = await fetch("/api/admin/config").then((x) => x.json());
      meta = cur; dirty = false; $<HTMLInputElement>("[data-note]").value = ""; renderStatus();
    });
    const signOut = async (url: string) => {
      if (dirty && !confirm("You have unsaved changes. Sign out anyway?")) return;
      dirty = false;
      await fetch(url, { method: "POST" }).catch(() => null);
      location.replace("/admin/login");
    };
    $("[data-logout]").addEventListener("click", () => signOut("/api/auth/logout"));
    $("[data-logout-all]").addEventListener("click", () => signOut("/api/admin/logout-everywhere"));
    window.addEventListener("beforeunload", (e) => { if (dirty) e.preventDefault(); });

    fetch("/api/admin/config").then((r) => { if (r.status === 401) { location.replace("/admin/login"); throw new Error("signed out"); } return r.json(); }).then((d) => {
      cfg = d.config; meta = d;
      $("[data-who]").textContent = d.email ? `Signed in as ${d.email}` : "";
      initTest(); renderAll(); loadLeads();
    }).catch(() => { $("[data-status]").textContent = "Couldn't load the rates. Refresh to try again."; });
  </script>

  <style is:global>
    :root { --gold: #c89a4b; --rust: #8a4b2e; --ivory: #f4ede0; --bg: #fdfbf7; --dark: #2e241b; --ink: #2b2118; --ink-2: #6b5d4f; --line: #e6dccb; --surface: #fff; --red: #a8321e; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Montserrat, system-ui, sans-serif; font-size: 14px; color: var(--ink); background: var(--bg); }
    h2 { font-size: 1.05rem; font-weight: 600; margin: 1.6rem 0 0.6rem; }
    h3 { font-size: 0.95rem; font-weight: 600; margin: 1.2rem 0 0.5rem; }
    h3 small { font-weight: 400; color: var(--ink-2); }
    .top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 0.6rem 1.2rem; background: var(--surface); border-bottom: 1px solid var(--line); }
    .top__brand { display: flex; align-items: center; gap: 0.7rem; font-weight: 600; }
    .top__brand img { height: 40px; width: auto; }
    .top__status { color: var(--ink-2); flex: 1; min-width: 14rem; }
    .warn { color: var(--rust); }
    .top__save { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .top__save input { width: 18rem; max-width: 100%; }
    input, select { font: inherit; padding: 0.4rem 0.5rem; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--ink); min-width: 0; }
    input[type="number"] { width: 6.2rem; }
    input:focus, select:focus { outline: 2px solid var(--gold); outline-offset: 0; }
    .btn { font: inherit; font-weight: 600; border-radius: 999px; padding: 0.5rem 1.1rem; border: 2px solid var(--gold); cursor: pointer; background: transparent; color: var(--ink); }
    .btn--gold { background: var(--gold); color: var(--dark); }
    .btn[disabled] { opacity: 0.45; cursor: default; }
    .btn--ghost { margin-top: 0.6rem; }
    .btn.sm { padding: 0.2rem 0.7rem; margin: 0; white-space: nowrap; }
    .tabs { display: flex; gap: 0.2rem; padding: 0 1.2rem; border-bottom: 1px solid var(--line); background: var(--surface); overflow-x: auto; }
    .tabs button { font: inherit; font-weight: 600; background: none; border: 0; border-bottom: 3px solid transparent; padding: 0.8rem 0.9rem; cursor: pointer; color: var(--ink-2); white-space: nowrap; }
    .tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--gold); }
    .issues { margin: 1rem 1.2rem 0; padding: 0.8rem 1rem; border-radius: 8px; background: #fbeae6; color: var(--red); }
    .issues ul { margin: 0.3rem 0 0; }
    .panes { padding: 0.5rem 1.2rem 4rem; }
    .hint { color: var(--ink-2); max-width: 60rem; }
    .tbl { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
    table { border-collapse: collapse; width: 100%; }
    th, td { padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
    thead th { background: var(--ivory); font-weight: 600; font-size: 0.82rem; white-space: nowrap; }
    th.grp { text-align: center; border-left: 1px solid var(--line); }
    td.ro { color: var(--ink-2); font-size: 0.8rem; }
    td.c { text-align: center; }
    td input[type="text"] { width: 100%; min-width: 11rem; }
    .empty { color: var(--ink-2); text-align: center; padding: 1rem; }
    .del, .mv button { background: none; border: 1px solid var(--line); border-radius: 6px; cursor: pointer; padding: 0.2rem 0.45rem; color: var(--ink-2); }
    .del:hover { color: var(--red); border-color: var(--red); }
    .mv { white-space: nowrap; }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 0.7rem; }
    .card { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.8rem; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; font-weight: 500; }
    .card input { width: 100%; }
    .doctext { display: grid; grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr)); gap: 0.7rem; }
    .doctext textarea { font: inherit; padding: 0.5rem; border: 1px solid var(--line); border-radius: 6px; width: 100%; }
    .filters { display: flex; gap: 1rem; margin: 0.5rem 0 0.8rem; }
    .filters label { display: flex; gap: 0.4rem; align-items: center; }
    .test { display: grid; grid-template-columns: minmax(20rem, 26rem) 1fr; gap: 2rem; align-items: start; }
    .test__form { position: sticky; top: 7.5rem; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 0.4rem 1rem 1rem; }
    .test__form label { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.6rem; font-weight: 500; }
    .test__form label.check { flex-direction: row; align-items: center; font-weight: 400; color: var(--ink-2); }
    .test__form input[type="number"], .test__form input[type="date"], .test__form input[type="text"], .test__form select { width: 100%; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 0.7rem; }
    .stop { display: grid; grid-template-columns: 1fr 4rem 1.4fr auto; gap: 0.35rem; margin-bottom: 0.4rem; }
    .stop input[type="number"] { width: 100%; }
    .who { padding: 0.7rem 0.9rem; background: var(--ivory); border-radius: 8px; font-weight: 500; }
    .err { padding: 0.7rem 0.9rem; background: #fbeae6; color: var(--red); border-radius: 8px; margin-bottom: 0.8rem; }
    .err ul { margin: 0.3rem 0 0; }
    .calc-t td { font-size: 0.86rem; }
    td.calc { color: var(--ink-2); font-family: ui-monospace, Menlo, monospace; font-size: 0.8rem; }
    .n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    tr.gh th { background: #faf6ee; font-size: 0.86rem; }
    table.sum { max-width: 46rem; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
    table.sum tr.line td { border-top: 2px solid var(--ink-2); }
    table.sum tr.total td { font-weight: 700; font-size: 1.05rem; background: var(--ivory); }
    .top__who { color: var(--ink-2); font-size: 0.85rem; }
    .src { display: inline-block; margin-top: 0.2rem; font-size: 0.72rem; font-weight: 600; padding: 0.05rem 0.45rem; border-radius: 99px; background: #e7f3e6; color: #2d6a2a; }
    .src--pdf { background: #f6ecd9; color: var(--rust); }
    .leads__bar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .leads__bar h2 { margin-right: auto; }
    .leads__bar label { display: flex; gap: 0.4rem; align-items: center; }
    table.leads td { vertical-align: top; font-size: 0.86rem; }
    table.leads td.sm { max-width: 26rem; color: var(--ink-2); }
    table.leads td.nw { white-space: nowrap; }
    table.leads td input[type="text"] { min-width: 12rem; }
    table.leads tr.st-new td:first-child { box-shadow: inset 4px 0 0 var(--gold); }
    table.leads tr.st-booked td { background: #f3f7ec; }
    table.leads tr.st-lost td { color: var(--ink-2); }
    .linkbtn { font: inherit; background: none; border: 0; color: var(--rust); cursor: pointer; text-decoration: underline; padding: 0 0.2rem; }
    .import { display: flex; align-items: center; gap: 1rem; margin: 0 0 1rem; }
    .import .btn { cursor: pointer; }
    .import-out { border: 1px solid var(--line); border-radius: 12px; background: #fff; padding: 0.8rem 1rem; margin: 0 0 1.2rem; }
    .import-out p { margin: 0.3rem 0; }
    .import-out .warn { margin: 0.4rem 0 0; padding-left: 1.2rem; color: var(--ink-2); font-size: 0.9rem; }
    .dlg { border: 0; border-radius: 14px; padding: 0; width: min(56rem, calc(100% - 2rem)); box-shadow: 0 30px 60px -20px rgba(0,0,0,0.45); }
    .dlg::backdrop { background: rgba(46, 36, 27, 0.5); }
    .dlg__in { padding: 1rem 1.3rem 1.3rem; }
    .dlg__head { display: flex; justify-content: space-between; align-items: center; }
    .dlg__head h2 { margin: 0.4rem 0; }
    .dlg__desc { display: flex; flex-direction: column; gap: 0.3rem; font-weight: 500; }
    .dlg textarea { font: inherit; padding: 0.5rem; border: 1px solid var(--line); border-radius: 6px; }
    .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.7rem; }
    .thumb { margin: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--ivory); }
    .thumb.is-main { outline: 3px solid var(--gold); }
    .thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
    .thumb figcaption { display: flex; gap: 0.25rem; align-items: center; padding: 0.3rem; font-size: 0.78rem; flex-wrap: wrap; }
    .thumb figcaption span { font-weight: 600; color: var(--rust); margin-right: auto; }
    .thumb figcaption button { font: inherit; background: #fff; border: 1px solid var(--line); border-radius: 5px; cursor: pointer; padding: 0.1rem 0.35rem; }
    .thumb figcaption [data-main] { margin-right: auto; }
    .thumb .rm:hover { color: var(--red); border-color: var(--red); }
    .upl { display: inline-block; }
    @media (max-width: 980px) { .test { grid-template-columns: 1fr; } .test__form { position: static; } }
  </style>
</body>
</html>
